/* Hotel Paradiso, Room 714 - the bathroom, through the doorway on the
 * bedroom's left wall.
 *
 * A tub with a shower curtain, a bath mat, a toilet that flushes (animated,
 * with a sound), a pedestal sink with a bar of soap, a mirror that opens into
 * a medicine cabinet with a shaving kit inside, and a towel on a rail. The
 * soap, towel and shaving kit can be taken, and with the screwdriver from the
 * bedroom safe the mirror door comes off the cabinet.
 * The doorway on the right leads back to the bedroom.
 */

#include "hotel.sch"

room Bathroom {
    image = "bathroom.bmp";
    boxd = "bathroom.box";
    trans = 0;

    sound flushSnd = "flush.soun";
    sound cabinetSnd = "cabinet.soun";   // magnet catch, then the hinge creaks
    sound unscrewSnd = "unscrew.soun";
    sound showerSnd = "shower_curtain.soun";   // rings scraping along the rail
    sound sinkSnd = "sink.soun";               // the tap, a gush of water, the tap
    sound duckSnd = "duck.soun";               // squeak squeak   // squeaky screws, one drops, the door clinks free

    object toilet;
    object curtain;
    object soap;
    object towel;
    object mirror;
    object shavingKit;

    // ------------------------------------------------------------ scripts
    // The cabinet's image: 0 closed; open with the door swung aside (1 kit,
    // 2 empty) or with the door unscrewed and gone (3 kit, 4 empty). The kit
    // has no parent, since it shows in two states; this sets whether it's
    // clickable.
    local script showCabinet() {
        if(!cabinetOpen && !mirrorRemoved) {
            setObjectState(mirror, 0);
            setObjectClass(shavingKit, [ SET_CLASS | UNTOUCHABLE ]);
            return;
        }
        setObjectState(mirror, (mirrorRemoved ? 3 : 1) + tookShaver);
        if(tookShaver) setObjectClass(shavingKit, [ SET_CLASS | UNTOUCHABLE ]);
        else setObjectClass(shavingKit, [ UNTOUCHABLE ]);
    }

    local script takeShaver() {
        tookShaver = 1;
        hasShaver = 1;
        showCabinet();
        ResRoom::refreshInventory();
        egoSay("A shaving kit. I could use one."); waitForMessage();
    }

    // Unscrew the cabinet door's hinges and take the mirror
    local script removeMirror() {
        ResRoom::showInterface(0);
        egoSay("Two screws per hinge. Lefty loosey..."); waitForMessage();
        startSound(unscrewSnd);
        delay(105);                 // the door comes free with the clink at 1.75s
        mirrorRemoved = 1;
        cabinetOpen = 1;
        hasMirror = 1;
        setObjectName(mirror, "medicine cabinet");
        showCabinet();
        ResRoom::refreshInventory();
        ResRoom::showInterface(1);
        egoSay("The mirror door comes right off. Nice and flat."); waitForMessage();
    }

    // The duck "speaks": yellow text over the tub
    local script duckSays() {
        printBegin();
        printAt(66, 40);
        printCenter();
        printColor(C_YELLOW);
    }

    // A squeak and a quack, unless you've had two lines: then it prophesies
    local script talkToDuck() {
        ResRoom::showInterface(0);
        egoSay("Hello, duck."); waitForMessage();
        startSound(duckSnd);
        delay(30);
        if(linesDone < 2) {
            duckSays(); print("Quack quack."); waitForMessage();
        } else {
            duckTalks++;
            if(duckTalks > 3) duckTalks = 1;        // three prophecies, in turn
            if(duckTalks == 1) {
                duckSays(); print("Hear me, guest of seven-one-four. One more line and you shall see only the ceiling."); waitForMessage();
            } else if(duckTalks == 2) {
                duckSays(); print("Call upon the desk, and the painted ones shall carry you to glory."); waitForMessage();
            } else {
                duckSays(); print("The party you seek is on the ninth floor. The party you need is within. Quack."); waitForMessage();
            }
            egoSay("...Did that duck just talk?"); waitForMessage();
        }
        ResRoom::showInterface(1);
    }

    local script goBedroom() {
        startRoom(Hotel);
    }

    // Press the handle: the handle drops and the water swirls while the
    // flush plays, then everything settles back.
    local script flushToilet() {
        int i;
        ResRoom::showInterface(0);
        startSound(flushSnd);
        for(i = 0 ; i < 6 ; i++) {
            setObjectState(toilet, 1);
            delay(7);
            setObjectState(toilet, 2);
            delay(7);
        }
        setObjectState(toilet, 0);
        ResRoom::showInterface(1);
        egoSay("Whoosh. Deeply satisfying."); waitForMessage();
    }

    // ------------------------------------------------------------ doorway
    object bedroomDoor {
        x = 304; y = 24; w = 16; h = 104;
        hs_x = -4; hs_y = 98;
        dir = EAST;
        name = "bedroom";

        verb(int vrb, int objA, int objB) {
        case DefaultVerb:        // what a plain click does
            defaultVerb = WalkTo;
            return;
        case WalkTo:
        case Open:
        case Use:
            goBedroom();
            return;
        case LookAt:
            egoSay("Back to the bedroom."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ rubber duck
    // In the tub, only clickable while the curtain is open (curtain state 1,
    // whose image shows it). Declared before the curtain and the tub so the
    // cursor finds it first.
    object duck {
        x = 58; y = 58; w = 17; h = 14;
        hs_x = 6; hs_y = 64;
        dir = NORTH;
        name = "rubber duck";
        parent = curtain;
        parent_state = 1;

        verb(int vrb, int objA, int objB) {
        case DefaultVerb:        // what a plain click does
            defaultVerb = TalkTo;
            return;
        case LookAt:
            if(linesDone >= 2) { egoSay("The duck is looking at me. Into me. Through me."); waitForMessage(); }
            else { egoSay("A yellow rubber duck, bobbing on nothing. It's judging me."); waitForMessage(); }
            return;
        case TalkTo:
            talkToDuck();
            return;
        case PickUp:
            egoSay("I couldn't. This is clearly the duck's tub. I'm just visiting."); waitForMessage();
            return;
        case Push:
        case Pull:
            egoSay("I give it a nudge. It bobs back, unbothered."); waitForMessage();
            return;
        case Use:
            if(objB == invSoap) { egoSay("It's clean enough. Cleaner than me, anyway."); waitForMessage(); }
            else if(objB) { egoSay("The duck wants for nothing."); waitForMessage(); }
            else { startSound(duckSnd); egoSay("I give it a squeeze. Squeak."); waitForMessage(); }
            return;
        }
    }

    // ------------------------------------------------------------ shower curtain
    // Drawn closed in the background; state 1 shows it pulled aside, with the
    // tub (and its rubber duck) behind it.
    object curtain {
        x = 16; y = 8; w = 96; h = 72;
        hs_x = 48; hs_y = 114;
        dir = NORTH;
        name = "shower curtain";
        states = { { 48, 114, "objects/bath_curtain_1.bmp" } };
        state = 0;

        verb(int vrb, int objA, int objB) {
        case DefaultVerb:        // what a plain click does: open it, or close it if it's open
            defaultVerb = bathCurtainOpen ? Close : Open;
            return;
        case LookAt:
            if(bathCurtainOpen) { egoSay("A shower curtain, bunched up. Patterned with tiny fish."); waitForMessage(); }
            else { egoSay("A shower curtain, patterned with tiny fish. Optimistic."); waitForMessage(); }
            return;
        case Open:
        case Pull:
            if(bathCurtainOpen) { egoSay("It's already open."); waitForMessage(); }
            else {
                bathCurtainOpen = 1;
                startSound(showerSnd);
                setObjectState(curtain, 1);
                egoSay("A rubber duck! Someone left a rubber duck in the tub."); waitForMessage();
            }
            return;
        case Close:
        case Push:
            if(bathCurtainOpen) {
                bathCurtainOpen = 0;
                startSound(showerSnd);
                setObjectState(curtain, 0);
            } else { egoSay("It's already closed."); waitForMessage(); }
            return;
        case PickUp:
            egoSay("It's attached to the rail. Firmly."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ tub
    object tub {
        x = 16; y = 80; w = 96; h = 32;
        hs_x = 48; hs_y = 42;
        dir = NORTH;
        name = "bathtub";

        verb(int vrb, int objA, int objB) {
        case DefaultVerb:        // what a plain click does
            defaultVerb = LookAt;
            return;
        case LookAt:
            if(bathCurtainOpen) { egoSay("A claw-foot tub. There's a rubber duck in it, judging me."); waitForMessage(); }
            else { egoSay("A claw-foot tub. The curtain's drawn."); waitForMessage(); }
            return;
        case Use:
            if(objB == invSoap) { egoSay("Tempting. But check-out was at noon."); waitForMessage(); }
            else if(objB) { egoSay("That doesn't need a bath."); waitForMessage(); }
            else { egoSay("No time for a bath. Check-out was at noon."); waitForMessage(); }
            return;
        case TalkTo:
            if(bathCurtainOpen) talkToDuck();
            else { egoSay("Anyone in there?"); waitForMessage(); }
            return;
        case PickUp:
        case Push:
        case Pull:
            egoSay("It's a cast-iron bathtub. It's not going anywhere."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ bath mat
    object mat {
        x = 32; y = 112; w = 64; h = 8;
        hs_x = 32; hs_y = 16;
        dir = NORTH;
        name = "bath mat";

        verb(int vrb, int objA, int objB) {
        case DefaultVerb:        // what a plain click does
            defaultVerb = LookAt;
            return;
        case LookAt:
            egoSay("A bath mat. Damp, for reasons I'd rather not think about."); waitForMessage();
            return;
        case PickUp:
            egoSay("It's damp. Hard pass."); waitForMessage();
            return;
        case Pull:
        case Open:
            egoSay("I lift a corner. Nothing under it but more floor."); waitForMessage();
            return;
        case Push:
            egoSay("It's already on the floor. It can't get much lower."); waitForMessage();
            return;
        case Use:
            if(objB == invTowel) { egoSay("A towel on a bath mat. That's just a thicker bath mat."); waitForMessage(); }
            else { egoSay("I wipe my feet. Very civilised."); waitForMessage(); }
            return;
        }
    }

    // ------------------------------------------------------------ toilet
    object toilet {
        x = 128; y = 48; w = 40; h = 56;
        // Walk to its right, facing it, so the player doesn't hide the flush
        hs_x = 46; hs_y = 62;
        dir = WEST;
        name = "toilet";
        states = {
            { 46, 62, "objects/bath_toilet_1.bmp" },   // flushing, swirl A
            { 46, 62, "objects/bath_toilet_2.bmp" }    // flushing, swirl B
        };
        state = 0;

        verb(int vrb, int objA, int objB) {
        case DefaultVerb:        // what a plain click does
            defaultVerb = Use;
            return;
        case LookAt:
            egoSay("A toilet. The lid's up. The handle is very shiny."); waitForMessage();
            return;
        case Use:
            if(objB) { egoSay("That is not going down there."); waitForMessage(); }
            else flushToilet();
            return;
        case Push:
        case Pull:
            flushToilet();
            return;
        case Open:
            egoSay("The lid's already up."); waitForMessage();
            return;
        case Close:
            egoSay("I'll leave the lid as it is. Living dangerously."); waitForMessage();
            return;
        case TalkTo:
            egoSay("Hello down there?"); waitForMessage();
            egoSay("...it gurgled. I'm choosing to take that as a no."); waitForMessage();
            return;
        case PickUp:
            egoSay("It's plumbed in. Thankfully."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ soap
    // On the edge of the sink (state 1) until taken. Declared before the sink
    // so the cursor finds it first.
    object soap {
        x = 184; y = 56; w = 16; h = 8;
        hs_x = 16; hs_y = 54;
        dir = NORTH;
        name = "bar of soap";
        states = { { 16, 54, "objects/bath_soap_1.bmp" } };
        state = 1;

        verb(int vrb, int objA, int objB) {
        case DefaultVerb:        // what a plain click does
            defaultVerb = PickUp;
            return;
        case LookAt:
            egoSay("A tiny bar of soap with the hotel's crest pressed into it."); waitForMessage();
            return;
        case PickUp:
            tookSoap = 1;
            hasSoap = 1;
            setObjectState(soap, 0);
            setObjectClass(soap, [ SET_CLASS | UNTOUCHABLE ]);
            ResRoom::refreshInventory();
            egoSay("Free soap. The best kind of soap."); waitForMessage();
            return;
        case Use:
            if(objB == invUniform) {
                ResRoom::washUniform();     // the soap on the sink works as well as one in hand
                return;
            }
            egoSay("I wash my hands. Very hygienic."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ sink
    object sink {
        x = 184; y = 56; w = 48; h = 48;
        hs_x = 24; hs_y = 54;
        dir = NORTH;
        name = "sink";

        verb(int vrb, int objA, int objB) {
        case DefaultVerb:        // what a plain click does
            defaultVerb = Use;
            return;
        case LookAt:
            egoSay("A pedestal sink. Spotless, unlike me."); waitForMessage();
            return;
        case Use:
            if(objB == invUniform) {
                ResRoom::washUniform();
                return;
            }
            unless(objB == invTowel || (objB && objB != invSoap && objB != invShaver)) startSound(sinkSnd);
            if(objB == invSoap) { egoSay("I wash my hands. Very hygienic. I feel like a new guest."); waitForMessage(); }
            else if(objB == invShaver) { egoSay("A proper wet shave at the sink. I feel like a new guest."); waitForMessage(); }
            else if(objB == invTowel) { egoSay("I dry the sink. Nobody asked me to."); waitForMessage(); }
            else if(objB) { egoSay("I'd rather not get that wet."); waitForMessage(); }
            else { egoSay("I splash some cold water on my face. That's better."); waitForMessage(); }
            return;
        case Open:
            startSound(sinkSnd);
            egoSay("I turn the tap on and off again. Water: confirmed."); waitForMessage();
            return;
        case PickUp:
            egoSay("It's bolted to the wall. And the floor."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ shaving kit
    // On the cabinet's bottom shelf. Only clickable while the cabinet shows
    // it (see showCabinet); declared before the mirror so the cursor finds it
    // first.
    object shavingKit {
        x = 200; y = 44; w = 16; h = 8;
        hs_x = 8; hs_y = 66;
        dir = NORTH;
        name = "shaving kit";

        verb(int vrb, int objA, int objB) {
        case DefaultVerb:        // what a plain click does
            defaultVerb = PickUp;
            return;
        case LookAt:
            egoSay("A razor with extra blades."); waitForMessage();
            return;
        case PickUp:
            takeShaver();
            return;
        case Open:
        case Use:
            egoSay("I'll take it out first."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ mirror
    // Swings open into a medicine cabinet. The screwdriver takes the mirror
    // door off altogether, and the object is renamed "medicine cabinet".
    object mirror {
        x = 192; y = 16; w = 32; h = 40;
        hs_x = 16; hs_y = 94;
        dir = NORTH;
        name = "mirror";
        states = {
            { 16, 94, "objects/bath_mirror_1.bmp" },   // open, shaving kit inside
            { 16, 94, "objects/bath_mirror_2.bmp" },   // open, without it
            { 16, 94, "objects/bath_mirror_3.bmp" },   // door removed, kit inside
            { 16, 94, "objects/bath_mirror_4.bmp" }    // door removed, without it
        };
        state = 0;

        verb(int vrb, int objA, int objB) {
        case DefaultVerb:        // what a plain click does: open or close the cabinet
            if(mirrorRemoved) defaultVerb = LookAt;
            else defaultVerb = cabinetOpen ? Close : Open;
            return;
        case LookAt:
            if(cabinetOpen && !tookShaver) {
                egoSay("Three tiny bottles, a shower cap, a sewing kit, and a shaving kit."); waitForMessage();
            } else if(cabinetOpen) {
                egoSay("Three tiny bottles, a shower cap and a sewing kit."); waitForMessage();
                if(mirrorRemoved) { egoSay("And no door. That one's on me."); waitForMessage(); }
                else { egoSay("The mirror door's held on by two hinges. Screwed on."); waitForMessage(); }
            } else if(wearingUniform) {
                egoSay("Dashing. Truly a bellhop among bellhops."); waitForMessage();
            } else {
                egoSay("I look like I slept in a hotel. Which I did."); waitForMessage();
            }
            return;
        case Open:
        case Pull:
            if(cabinetOpen) { egoSay("It's already open."); waitForMessage(); }
            else {
                cabinetOpen = 1;
                startSound(cabinetSnd);
                showCabinet();
                egoSay("It's a medicine cabinet behind the mirror."); waitForMessage();
            }
            return;
        case Close:
        case Push:
            if(mirrorRemoved) { egoSay("There's no door left to close."); waitForMessage(); }
            else if(cabinetOpen) {
                cabinetOpen = 0;
                showCabinet();
            } else { egoSay("It's closed."); waitForMessage(); }
            return;
        case PickUp:
            if(cabinetOpen && !tookShaver) takeShaver();
            else if(mirrorRemoved) { egoSay("I already have the mirror. The rest is bolted to the wall."); waitForMessage(); }
            else { egoSay("It's screwed to the wall. I'd need a screwdriver."); waitForMessage(); }
            return;
        case Use:
            if(objB == invScrewdriver) {
                if(mirrorRemoved) { egoSay("I've already taken the door off."); waitForMessage(); }
                else removeMirror();
            } else if(mirrorRemoved) { egoSay("There's no mirror left. I'll use the one I'm carrying."); waitForMessage(); }
            else if(objB == invTowel) { egoSay("I polish the mirror. Now I can see myself more clearly. Mixed feelings."); waitForMessage(); }
            else if(objB == invShaver) { egoSay("I shave in the mirror. Very dapper. Only one nick."); waitForMessage(); }
            else { egoSay("I check my teeth. All present."); waitForMessage(); }
            return;
        case TalkTo:
            egoSay("Mirror, mirror on the wall..."); waitForMessage();
            egoSay("...nothing. Wrong kind of mirror."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ towel
    // Hangs on the rail (state 1) until taken.
    object towel {
        x = 248; y = 32; w = 40; h = 40;
        hs_x = 20; hs_y = 78;
        dir = NORTH;
        name = "towel";
        states = { { 20, 78, "objects/bath_towel_1.bmp" } };
        state = 1;

        verb(int vrb, int objA, int objB) {
        case DefaultVerb:        // what a plain click does
            defaultVerb = PickUp;
            return;
        case LookAt:
            egoSay("A fluffy white towel with a teal stripe."); waitForMessage();
            return;
        case PickUp:
            tookTowel = 1;
            hasTowel = 1;
            setObjectState(towel, 0);
            setObjectClass(towel, [ SET_CLASS | UNTOUCHABLE ]);
            ResRoom::refreshInventory();
            egoSay("A towel. Every traveller should have one."); waitForMessage();
            return;
        case Use:
            if(objB == invUniform) {
                ResRoom::dryUniform();      // the towel on the rail works as well as one in hand
                return;
            }
            egoSay("I dry my hands on it. Then I put it back exactly how it was."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ entry
    local script entry() {
        createBoxMatrix();
        unless(bathroomVisited) {
            bathroomVisited = 1;
            setObjectClass(shavingKit, [ SET_CLASS | UNTOUCHABLE ]);
        }
        // The engine drops renamed room objects' names when you leave a room
        if(mirrorRemoved) setObjectName(mirror, "medicine cabinet");
        putActorAt(VAR_EGO, 310, 122, Bathroom);
        setCurrentActor(VAR_EGO);
        setActorDirection(270);
        walkActorTo(VAR_EGO, 284, 122);
    }
}
