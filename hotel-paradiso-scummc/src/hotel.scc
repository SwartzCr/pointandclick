/* Hotel Paradiso, Room 714 - the bedroom.
 *
 * Furniture you can interact with: door, TV, curtains, minibar, lamp, phone,
 * nightstand, dresser, painting, wall safe, bed and coffee table, plus the doorway to
 * the bathroom (src/bathroom.scc). The items you can take (candy bar,
 * matchbook, key card, and the bellhop uniform in the dresser) are objects
 * too, parented to the container state that shows them, so they're only
 * clickable while visible.
 *
 * Each object's verb block is its SCUMM verb table; verbs it doesn't list get
 * defaultAction(). objB carries the inventory item for "Use X with <object>".
 *
 * Puzzle chain:
 *   nightstand drawer -> matchbook -> lamp on to read it -> code 714
 *   painting -> reveals the wall safe -> open with the code -> key card -> door
 */

#include "hotel.sch"

room Hotel {
    image = "room.bmp";
    boxd = "hotel.box";
    trans = 0;

    sound tvSnd = "tv.soun";       // two seconds of indistinct chatter
    sound safeSnd = "safe.soun";   // keypad beeps, a chime, the bolt motor, the door

    object door;
    object tv;
    object tableMatchbook;
    object tableCandy;
    object tableKeycard;
    object tableUniform;
    object tableTowel;
    object tableSoap;
    object minibar;
    object dresser;
    object nightstand;
    object painting;
    object safe;
    object cursor;

    // ------------------------------------------------------------ scripts
    // Set an inventory item down on the coffee table. Each item has its own
    // slot object on the table top (see "coffee table" below).
    local script putOnTable(int item) {
        int slot;
        if(item == invUniform && wearingUniform) {
            egoSay("I'd have to take it off first."); waitForMessage();
            return;
        }
        slot = 0;
        if(item == invMatchbook)    { hasMatchbook = 0; slot = tableMatchbook; }
        else if(item == invCandy)   { hasCandy = 0;     slot = tableCandy; }
        else if(item == invKeycard) { hasKeycard = 0;   slot = tableKeycard; }
        else if(item == invUniform) { hasUniform = 0;   slot = tableUniform; }
        else if(item == invTowel)   { hasTowel = 0;     slot = tableTowel; }
        else if(item == invSoap)    { hasSoap = 0;      slot = tableSoap; }
        unless(slot) return;
        setObjectState(slot, 1);
        setObjectClass(slot, [ UNTOUCHABLE ]);
        ResRoom::refreshInventory();
        egoSay("There."); waitForMessage();
    }

    // Pick an item back up off the coffee table
    local script takeFromTable(int item) {
        int slot;
        if(item == invMatchbook)    { hasMatchbook = 1; slot = tableMatchbook; }
        else if(item == invCandy)   { hasCandy = 1;     slot = tableCandy; }
        else if(item == invKeycard) { hasKeycard = 1;   slot = tableKeycard; }
        else if(item == invUniform) { hasUniform = 1;   slot = tableUniform; }
        else if(item == invTowel)   { hasTowel = 1;     slot = tableTowel; }
        else if(item == invSoap)    { hasSoap = 1;      slot = tableSoap; }
        setObjectState(slot, 0);
        setObjectClass(slot, [ SET_CLASS | UNTOUCHABLE ]);
        ResRoom::refreshInventory();
    }

    // Switch the TV on: a burst of chatter while the weather report scrolls
    // across the top of the screen in TV-blue.
    local script switchTvOn() {
        tvOn = 1;
        setObjectState(tv, 1);
        ResRoom::showInterface(0);
        startSound(tvSnd);
        printBegin(); printAt(160, 8); printCenter(); printColor(C_CYAN);
        print("...and now the Paradiso Weather. Sunny and 72 down by the pool."); waitForMessage();
        printBegin(); printAt(160, 8); printCenter(); printColor(C_CYAN);
        print("Clear skies all week, with a hundred percent chance of late check-out fees."); waitForMessage();
        ResRoom::showInterface(1);
        egoSay("Riveting."); waitForMessage();
    }

    // Key in the code: three beeps, the accepted chime, the motor pulling the
    // bolt back. The door's image changes as it pops open on its spring.
    local script openSafe() {
        ResRoom::showInterface(0);
        egoSay("Seven. One. Four."); waitForMessage();
        startSound(safeSnd);
        delay(84);                  // beeps, chime, motor and clunk: 1.4s
        safeOpen = 1;
        setObjectState(safe, tookKeycard ? 3 : 2);
        delay(30);                  // the puff of air as the door swings open
        ResRoom::showInterface(1);
        egoSay("It's open."); waitForMessage();
    }

    // Through the doorway on the left wall
    local script goBathroom() {
        startRoom(Bathroom);
    }

    // Taking an item: switch the container to its "open and empty" state
    // (which also hides the item object) and add the item to the inventory.
    local script takeUniform() {
        tookUniform = 1;
        hasUniform = 1;
        setObjectState(dresser, 2);
        ResRoom::refreshInventory();
        egoSay("It's exactly my size. That's either lucky or a plot."); waitForMessage();
    }

    local script takeCandy() {
        tookCandy = 1;
        hasCandy = 1;
        setObjectState(minibar, 2);
        ResRoom::refreshInventory();
        egoSay("A candy bar. Fourteen dollars. Worth it."); waitForMessage();
    }

    local script takeMatchbook() {
        tookMatchbook = 1;
        hasMatchbook = 1;
        setObjectState(nightstand, 2);
        ResRoom::refreshInventory();
        egoSay("Got it. There's writing inside the cover."); waitForMessage();
    }

    local script takeKeycard() {
        tookKeycard = 1;
        hasKeycard = 1;
        setObjectState(safe, 3);
        ResRoom::refreshInventory();
        egoSay("My key card. Now let's get out of here."); waitForMessage();
    }

    // Sets up the next print() as the front desk's voice on the phone:
    // yellow text centred at the top of the screen.
    local script deskSays() {
        printBegin();
        printAt(160, 12);
        printCenter();
        printColor(C_YELLOW);
    }

    local script callDesk() {
        ResRoom::showInterface(0);
        phoneCalls++;
        egoSay("I dial zero."); waitForMessage();
        if(phoneCalls == 1) {
            deskSays(); print("Front desk, Gustav speaking. How may I help you?"); waitForMessage();
            egoSay("I'm locked in my room. I can't find my key card."); waitForMessage();
            deskSays(); print("Have you tried the door, sir?"); waitForMessage();
            egoSay("The door needs the key card."); waitForMessage();
            deskSays(); print("Then I suggest finding the key card, sir."); waitForMessage();
            deskSays(); print("Many guests keep valuables in the room safe."); waitForMessage();
            egoSay("There's a safe?"); waitForMessage();
            deskSays(); print("Behind the painting, sir. As in every room. Good day."); waitForMessage();
        } else if(phoneCalls == 2) {
            deskSays(); print("Front desk, Gustav speaking."); waitForMessage();
            egoSay("Hi, it's me again. What's the code for the safe?"); waitForMessage();
            deskSays(); print("Whatever you set it to, sir. Guests often write it down."); waitForMessage();
            deskSays(); print("Usually on whatever is lying around the room. Good day."); waitForMessage();
        } else {
            deskSays(); print("You have reached the front desk. Gustav is on his break."); waitForMessage();
            egoSay("Gustav is avoiding me."); waitForMessage();
        }
        ResRoom::showInterface(1);
    }

    local script leaveRoom() {
        gameOver = 1;
        ResRoom::showInterface(0);
        egoSay("I slide the key card into the slot."); waitForMessage();
        setObjectState(door, 1);
        egoSay("Green light! Freedom!"); waitForMessage();
        walkActorTo(VAR_EGO, 40, 101);
        waitForActor(VAR_EGO);
        putActorAt(VAR_EGO, 0, 0, 0);    // room 0 = gone
        delaySeconds(1);
        printBegin(); printAt(160, 40); printCenter(); printColor(C_YELLOW);
        print("You checked out of the Hotel Paradiso."); waitForMessage();
        printBegin(); printAt(160, 40); printCenter(); printColor(C_WHITE);
        print("THE END.   Thanks for playing!"); waitForMessage();
        if(wearingUniform) {
            printBegin(); printAt(160, 40); printCenter(); printColor(C_WHITE);
            print("Nobody stops a bellhop on the way out."); waitForMessage();
        }
        printBegin(); printAt(160, 40); printCenter(); printColor(C_GREY);
        print("Late check-out fee: $40. Minibar: $14."); waitForMessage();
        shutdown();
    }


    // ------------------------------------------------------------ bathroom doorway
    // The opening in the left wall. Walking into it goes to the bathroom.
    object bathroomDoor {
        x = 0; y = 24; w = 16; h = 104;
        hs_x = 12; hs_y = 94;
        dir = WEST;
        name = "bathroom";

        verb(int vrb, int objA, int objB) {
        case WalkTo:
        case Open:
            goBathroom();
            return;
        case Use:
            if(objB) { egoSay("I'll just carry it in."); waitForMessage(); }
            goBathroom();
            return;
        case LookAt:
            egoSay("The bathroom. Tiled, bright, and slightly too cold."); waitForMessage();
            return;
        case Close:
            egoSay("There's no door. Just a doorway. Very trusting."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ door
    object door {
        x = 16; y = 16; w = 48; h = 80;
        hs_x = 24; hs_y = 88;
        dir = NORTH;
        name = "door";
        states = { { 24, 88, "objects/door_1.bmp" } };
        state = 0;

        verb(int vrb, int objA, int objB) {
        case LookAt:
            egoSay("Room 714. It only opens with a key card."); waitForMessage();
            return;
        case Open:
            if(hasKeycard) leaveRoom();
            else { egoSay("Locked. The card reader blinks red at me. Judgmentally."); waitForMessage(); }
            return;
        case Use:
            if(objB == invKeycard || (!objB && hasKeycard)) leaveRoom();
            else if(objB) { egoSay("That won't fit in the card slot."); waitForMessage(); }
            else { egoSay("It needs a key card. Which I don't have."); waitForMessage(); }
            return;
        case Pull:
            egoSay("I rattle the handle. Still locked."); waitForMessage();
            return;
        case Push:
            egoSay("It opens inward. Also, it's locked."); waitForMessage();
            return;
        case Close:
            egoSay("It's already closed. Very closed."); waitForMessage();
            return;
        case TalkTo:
            egoSay("Hello? Housekeeping? Anyone?"); waitForMessage();
            egoSay("Nothing. They must be on strike."); waitForMessage();
            return;
        case PickUp:
            egoSay("The Do Not Disturb sign stays. I am very disturbed."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ bellhop uniform
    // Folded in the dresser's top drawer. Only clickable while the drawer is
    // open with the uniform inside (state 1); declared before the dresser so
    // the cursor finds it first.
    object uniform {
        x = 88; y = 68; w = 32; h = 8;
        hs_x = -28; hs_y = 38;
        dir = EAST;
        name = "bellhop uniform";
        parent = dresser;
        parent_state = 1;

        verb(int vrb, int objA, int objB) {
        case LookAt:
            egoSay("A bellhop uniform, with the little hat. Not mine. Probably."); waitForMessage();
            return;
        case PickUp:
            takeUniform();
            return;
        case Use:
            egoSay("I'll take it out first."); waitForMessage();
            return;
        case TalkTo:
            egoSay("Front! Boy!"); waitForMessage();
            egoSay("Nothing. Good help is hard to find."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ dresser
    // The chest of drawers under the TV. Opening it pulls out the top drawer:
    // state 1 with the uniform inside, state 2 once it's been taken.
    object dresser {
        x = 72; y = 64; w = 56; h = 32;
        // Stand beside it so the open drawer stays in view
        hs_x = -12; hs_y = 42;
        dir = EAST;
        name = "dresser";
        states = {
            { -12, 42, "objects/dresser_1.bmp" },   // open, uniform inside
            { -12, 42, "objects/dresser_2.bmp" }    // open, empty
        };
        state = 0;

        verb(int vrb, int objA, int objB) {
        case LookAt:
            if(dresserOpen && !tookUniform) { egoSay("There's a bellhop uniform folded in the top drawer."); waitForMessage(); }
            else if(dresserOpen) { egoSay("Empty. Not even a hotel bible."); waitForMessage(); }
            else { egoSay("A chest of drawers, under a TV that's older than I am."); waitForMessage(); }
            return;
        case Open:
        case Pull:
            if(dresserOpen) { egoSay("It's already open."); waitForMessage(); }
            else {
                dresserOpen = 1;
                if(tookUniform) setObjectState(dresser, 2);
                else {
                    setObjectState(dresser, 1);
                    egoSay("Huh. Someone left a bellhop uniform in here."); waitForMessage();
                }
            }
            return;
        case Close:
        case Push:
            if(dresserOpen) { dresserOpen = 0; setObjectState(dresser, 0); }
            else { egoSay("It's closed."); waitForMessage(); }
            return;
        case PickUp:
            if(dresserOpen && !tookUniform) takeUniform();
            else { egoSay("It's furniture. It stays."); waitForMessage(); }
            return;
        case Use:
            if(objB) { egoSay("I'll leave the drawers to the professionals. The coffee table's right there."); waitForMessage(); }
            else { egoSay("I could open it."); waitForMessage(); }
            return;
        }
    }

    // ------------------------------------------------------------ tv
    object tv {
        x = 80; y = 16; w = 48; h = 48;
        hs_x = 20; hs_y = 88;
        dir = NORTH;
        name = "TV";
        states = { { 20, 88, "objects/tv_1.bmp" } };
        state = 0;

        verb(int vrb, int objA, int objB) {
        case LookAt:
            if(tvOn) {
                tvAd = !tvAd;
                if(tvAd) { egoSay("The Paradiso Channel. Forecast: sunny, with a chance of late fees."); waitForMessage(); }
                else { egoSay("An ad: Paradiso safes. Hidden where nobody would ever look."); waitForMessage(); }
            } else {
                egoSay("A TV the size of a suitcase. Retro, or just old."); waitForMessage();
            }
            return;
        case Use:
        case Push:
            if(objB) {
                egoSay("I don't think the TV needs that."); waitForMessage();
            } else if(tvOn) {
                tvOn = 0;
                setObjectState(tv, 0);
                egoSay("Click."); waitForMessage();
            } else
                switchTvOn();
            return;
        case Close:
            if(tvOn) { tvOn = 0; setObjectState(tv, 0); }
            else { egoSay("It's already off."); waitForMessage(); }
            return;
        case TalkTo:
            egoSay("TV, what's the code for the safe?"); waitForMessage();
            if(tvOn) { egoSay("It cut to a commercial. Typical."); waitForMessage(); }
            else { egoSay("The silent treatment. Fair."); waitForMessage(); }
            return;
        case PickUp:
            egoSay("It weighs more than I do."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ curtains
    object curtains {
        x = 128; y = 0; w = 72; h = 72;
        hs_x = 36; hs_y = 104;
        dir = NORTH;
        name = "curtains";
        states = { { 36, 104, "objects/curtains_1.bmp" } };
        state = 0;

        verb(int vrb, int objA, int objB) {
        case LookAt:
            if(curtainsOpen) { egoSay("The city at night. Twelve floors down, and the window is sealed."); waitForMessage(); }
            else { egoSay("Heavy velvet curtains. Very dramatic."); waitForMessage(); }
            return;
        case Open:
        case Pull:
            if(curtainsOpen) { egoSay("They're already open."); waitForMessage(); }
            else {
                curtainsOpen = 1;
                setObjectState(curtains, 1);
                egoSay("Night already? How long did I sleep?"); waitForMessage();
            }
            return;
        case Close:
        case Push:
            if(curtainsOpen) { curtainsOpen = 0; setObjectState(curtains, 0); }
            else { egoSay("They're already closed."); waitForMessage(); }
            return;
        case Use:
            if(objB == invMatchbook) { egoSay("Setting the curtains on fire is not a plan. It's a crime."); waitForMessage(); }
            else { egoSay("Climbing out the window is not an option. Twelve floors."); waitForMessage(); }
            return;
        }
    }

    // ------------------------------------------------------------ candy bar
    // Only clickable while the minibar is open with the candy inside (state 1)
    object candy {
        x = 152; y = 86; w = 16; h = 8;
        hs_x = -20; hs_y = 20;
        dir = EAST;
        name = "candy bar";
        parent = minibar;
        parent_state = 1;

        verb(int vrb, int objA, int objB) {
        case LookAt:
            egoSay("A Paradiso Bar. The price tag says fourteen dollars."); waitForMessage();
            return;
        case PickUp:
            takeCandy();
            return;
        case Use:
        case TalkTo:
            egoSay("I'll take it first."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ minibar
    object minibar {
        x = 144; y = 72; w = 32; h = 24;
        hs_x = -12; hs_y = 34;
        dir = EAST;
        name = "minibar";
        states = {
            { -12, 34, "objects/minibar_1.bmp" },   // open, candy inside
            { -12, 34, "objects/minibar_2.bmp" }    // open, empty
        };
        state = 0;

        verb(int vrb, int objA, int objB) {
        case LookAt:
            if(minibarOpen && !tookCandy) { egoSay("Tiny bottles and a candy bar. All priced like jewellery."); waitForMessage(); }
            else if(minibarOpen) { egoSay("Tiny bottles. I'm not paying twelve dollars for those."); waitForMessage(); }
            else { egoSay("The minibar. A tiny fridge full of expensive regret."); waitForMessage(); }
            return;
        case Open:
        case Pull:
            if(minibarOpen) { egoSay("It's open."); waitForMessage(); }
            else {
                minibarOpen = 1;
                setObjectState(minibar, tookCandy ? 2 : 1);
            }
            return;
        case Close:
        case Push:
            if(minibarOpen) { minibarOpen = 0; setObjectState(minibar, 0); }
            else { egoSay("It's closed."); waitForMessage(); }
            return;
        case PickUp:
            if(minibarOpen && !tookCandy) takeCandy(); else if(minibarOpen) {
                egoSay("The bottles are wired to an alarm. Probably."); waitForMessage();
            } else {
                egoSay("It's plugged in. I'll just open it."); waitForMessage();
            }
            return;
        }
    }

    // ------------------------------------------------------------ lamp
    object lamp {
        x = 200; y = 32; w = 16; h = 40;
        hs_x = -10; hs_y = 76;
        dir = EAST;
        name = "lamp";
        states = { { -10, 76, "objects/lamp_1.bmp" } };
        state = 0;

        verb(int vrb, int objA, int objB) {
        case LookAt:
            if(lampOn) { egoSay("Nice warm light. Good for reading."); waitForMessage(); }
            else { egoSay("A brass reading lamp. It's off."); waitForMessage(); }
            return;
        case Use:
        case Push:
        case Pull:
            if(objB) {
                egoSay("The lamp doesn't need that."); waitForMessage();
            } else if(lampOn) {
                lampOn = 0;
                setObjectState(lamp, 0);
                egoSay("Click."); waitForMessage();
            } else {
                lampOn = 1;
                setObjectState(lamp, 1);
                egoSay("Let there be light."); waitForMessage();
            }
            return;
        case PickUp:
            egoSay("It's plugged in. And bolted down. This hotel trusts no one."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ phone
    object phone {
        x = 216; y = 56; w = 16; h = 16;
        hs_x = -24; hs_y = 52;
        dir = EAST;
        name = "phone";

        verb(int vrb, int objA, int objB) {
        case LookAt:
            egoSay("A rotary phone. Zero for the front desk."); waitForMessage();
            return;
        case Use:
        case TalkTo:
        case PickUp:
            if(objB) { egoSay("I'd rather use it to make a call."); waitForMessage(); }
            else callDesk();
            return;
        }
    }

    // ------------------------------------------------------------ matchbook
    // Only clickable while the drawer is open with the matchbook inside (state 1)
    object matchbook {
        x = 208; y = 76; w = 16; h = 8;
        hs_x = -18; hs_y = 32;
        dir = EAST;
        name = "matchbook";
        parent = nightstand;
        parent_state = 1;

        verb(int vrb, int objA, int objB) {
        case LookAt:
            egoSay("A Hotel Paradiso matchbook. There's writing inside the cover."); waitForMessage();
            return;
        case PickUp:
            takeMatchbook();
            return;
        case Use:
        case Open:
            egoSay("I'll take it first."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ nightstand
    object nightstand {
        x = 200; y = 72; w = 32; h = 24;
        hs_x = -10; hs_y = 36;
        dir = EAST;
        name = "nightstand";
        states = {
            { -10, 36, "objects/nightstand_1.bmp" },   // drawer open, matchbook
            { -10, 36, "objects/nightstand_2.bmp" }    // drawer open, empty
        };
        state = 0;

        verb(int vrb, int objA, int objB) {
        case LookAt:
            if(drawerOpen && !tookMatchbook) { egoSay("There's a matchbook in the drawer."); waitForMessage(); }
            else if(drawerOpen) { egoSay("The drawer is empty. Not even a room service menu."); waitForMessage(); }
            else { egoSay("A nightstand with one drawer."); waitForMessage(); }
            return;
        case Open:
        case Pull:
            if(drawerOpen) { egoSay("It's already open."); waitForMessage(); }
            else {
                drawerOpen = 1;
                if(tookMatchbook) setObjectState(nightstand, 2);
                else {
                    setObjectState(nightstand, 1);
                    egoSay("A matchbook from the hotel bar."); waitForMessage();
                }
            }
            return;
        case Close:
        case Push:
            if(drawerOpen) { drawerOpen = 0; setObjectState(nightstand, 0); }
            else { egoSay("It's closed."); waitForMessage(); }
            return;
        case PickUp:
            if(drawerOpen && !tookMatchbook) takeMatchbook(); else if(drawerOpen) {
                egoSay("Nothing else in there."); waitForMessage();
            } else {
                egoSay("I'll open the drawer first."); waitForMessage();
            }
            return;
        }
    }

    // ------------------------------------------------------------ painting
    object painting {
        x = 248; y = 8; w = 48; h = 40;
        hs_x = -18; hs_y = 131;
        dir = EAST;
        name = "painting";

        verb(int vrb, int objA, int objB) {
        case LookAt:
            egoSay("A stag in a forest clearing at dusk. It hangs a little crooked."); waitForMessage();
            return;
        case Pull:
        case Push:
        case PickUp:
        case Open:
            // Swing it aside: the painting stops being clickable and the
            // safe behind it takes over the same spot on the wall.
            setObjectClass(painting, [ SET_CLASS | UNTOUCHABLE ]);
            setObjectClass(safe, [ UNTOUCHABLE ]);
            setObjectState(safe, 1);
            egoSay("Aha! A wall safe. Behind a painting. How original."); waitForMessage();
            return;
        case TalkTo:
            egoSay("Lovely brushwork. I don't know anything about brushwork."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ key card
    // Only clickable while the safe is open with the card inside (state 2)
    object keycard {
        x = 260; y = 30; w = 18; h = 8;
        hs_x = -30; hs_y = 109;
        dir = EAST;
        name = "key card";
        parent = safe;
        parent_state = 2;

        verb(int vrb, int objA, int objB) {
        case LookAt:
            egoSay("My key card! I locked it in the safe. Of course I did."); waitForMessage();
            return;
        case PickUp:
            takeKeycard();
            return;
        case Use:
            egoSay("I'll take it first."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ safe
    object safe {
        x = 248; y = 8; w = 48; h = 40;
        hs_x = -18; hs_y = 131;
        dir = EAST;
        name = "wall safe";
        states = {
            { -18, 131, "objects/safe_1.bmp" },   // revealed, closed
            { -18, 131, "objects/safe_2.bmp" },   // open, key card inside
            { -18, 131, "objects/safe_3.bmp" }    // open, empty
        };
        state = 0;

        verb(int vrb, int objA, int objB) {
        case LookAt:
            if(safeOpen && !tookKeycard) { egoSay("My key card! I locked it in the safe. Of course I did."); waitForMessage(); }
            else if(safeOpen) { egoSay("Empty."); waitForMessage(); }
            else { egoSay("A wall safe with a keypad. It wants a three-digit code."); waitForMessage(); }
            return;
        case Open:
        case Use:
            if(safeOpen) {
                egoSay("It's already open."); waitForMessage();
            } else if(objB && objB != invMatchbook) {
                egoSay("That won't open a safe."); waitForMessage();
            } else if(knowsCode)
                openSafe(); else if(hasMatchbook) {
                egoSay("I think I wrote the code inside the matchbook. I should read it."); waitForMessage();
            } else {
                egoSay("I don't remember the code. I barely remember last night."); waitForMessage();
            }
            return;
        case PickUp:
            if(safeOpen && !tookKeycard) takeKeycard(); else if(safeOpen) {
                egoSay("There's nothing left in it."); waitForMessage();
            } else {
                egoSay("It's built into the wall."); waitForMessage();
            }
            return;
        case Close:
        case Push:
            if(safeOpen) { safeOpen = 0; setObjectState(safe, 1); }
            else { egoSay("It's closed."); waitForMessage(); }
            return;
        case TalkTo:
            egoSay("Open sesame."); waitForMessage();
            egoSay("Worth a try."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ coffee table
    // Inventory items can be set down on the table ("Use X with coffee table")
    // and picked up again. Each item has its own slot object on the table top:
    // state 1 shows it, and it's untouchable while the slot is empty. The
    // slots are declared before the table so the cursor finds them first.
    // The walk-to spot for all of them is beside the table, so the player
    // doesn't stand in front of what's on it.
    object tableMatchbook {
        x = 112; y = 104; w = 16; h = 16;
        hs_x = 110; hs_y = 18;
        dir = WEST;
        name = "matchbook";
        states = { { 110, 18, "objects/table_matchbook_1.bmp" } };
        state = 0;
        verb(int vrb, int objA, int objB) {
        case LookAt:
            egoSay("The matchbook, right where I left it."); waitForMessage();
            return;
        case PickUp:
            takeFromTable(invMatchbook);
            return;
        }
    }

    object tableCandy {
        x = 128; y = 104; w = 16; h = 16;
        hs_x = 94; hs_y = 18;
        dir = WEST;
        name = "candy bar";
        states = { { 94, 18, "objects/table_candy_1.bmp" } };
        state = 0;
        verb(int vrb, int objA, int objB) {
        case LookAt:
            egoSay("Fourteen dollars of nougat, displayed with pride."); waitForMessage();
            return;
        case PickUp:
            takeFromTable(invCandy);
            return;
        }
    }

    object tableKeycard {
        x = 144; y = 104; w = 16; h = 16;
        hs_x = 78; hs_y = 18;
        dir = WEST;
        name = "key card";
        states = { { 78, 18, "objects/table_keycard_1.bmp" } };
        state = 0;
        verb(int vrb, int objA, int objB) {
        case LookAt:
            egoSay("My key card. Let's not lose it again."); waitForMessage();
            return;
        case PickUp:
            takeFromTable(invKeycard);
            return;
        }
    }

    object tableUniform {
        x = 160; y = 104; w = 16; h = 16;
        hs_x = 62; hs_y = 18;
        dir = WEST;
        name = "bellhop uniform";
        states = { { 62, 18, "objects/table_uniform_1.bmp" } };
        state = 0;
        verb(int vrb, int objA, int objB) {
        case LookAt:
            egoSay("The bellhop uniform, neatly folded. Neater than I fold anything."); waitForMessage();
            return;
        case PickUp:
            takeFromTable(invUniform);
            return;
        }
    }

    object tableTowel {
        x = 176; y = 104; w = 16; h = 16;
        hs_x = 46; hs_y = 18;
        dir = WEST;
        name = "towel";
        states = { { 46, 18, "objects/table_towel_1.bmp" } };
        state = 0;
        verb(int vrb, int objA, int objB) {
        case LookAt:
            egoSay("The towel, folded on the table like a fancy hotel would."); waitForMessage();
            return;
        case PickUp:
            takeFromTable(invTowel);
            return;
        }
    }

    object tableSoap {
        x = 192; y = 104; w = 16; h = 16;
        hs_x = 30; hs_y = 18;
        dir = WEST;
        name = "soap";
        states = { { 30, 18, "objects/table_soap_1.bmp" } };
        state = 0;
        verb(int vrb, int objA, int objB) {
        case LookAt:
            egoSay("A bar of soap on the coffee table. Very spa."); waitForMessage();
            return;
        case PickUp:
            takeFromTable(invSoap);
            return;
        }
    }

    object coffeeTable {
        x = 112; y = 104; w = 96; h = 24;
        hs_x = 110; hs_y = 18;
        dir = WEST;
        name = "coffee table";

        verb(int vrb, int objA, int objB) {
        case LookAt:
            egoSay("A low coffee table. A good place to put things down."); waitForMessage();
            return;
        case Use:
            if(objB) putOnTable(objB);
            else { egoSay("I could put something on it."); waitForMessage(); }
            return;
        case PickUp:
            egoSay("It's furniture. It stays."); waitForMessage();
            return;
        case Push:
        case Pull:
            egoSay("It's heavier than it looks. It can stay where it is."); waitForMessage();
            return;
        case TalkTo:
            egoSay("Nice table. Sturdy."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ bed
    object bed {
        x = 232; y = 48; w = 88; h = 88;
        hs_x = 8; hs_y = 91;
        dir = EAST;
        name = "bed";

        verb(int vrb, int objA, int objB) {
        case LookAt:
            egoSay("Unmade. My work."); waitForMessage();
            return;
        case Use:
            egoSay("No time for a nap. Check-out was at noon."); waitForMessage();
            return;
        case Push:
        case Pull:
            egoSay("I'm not wrestling a mattress today."); waitForMessage();
            return;
        case PickUp:
            egoSay("Not with my back."); waitForMessage();
            return;
        case Open:
            egoSay("I check under the covers. One sock. Not mine."); waitForMessage();
            return;
        case TalkTo:
            egoSay("Goodbye, bed. You were the best part of this trip."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ cursor
    // Holds the mouse cursor image; never drawn and never clickable.
    object cursor {
        x = 0; y = 0; w = 16; h = 16;
        name = "";
        states = { { 0, 0, "cursor.bmp" } };
        state = 0;
    }

    local script entry() {
        createBoxMatrix();

        // Coming back from the bathroom: step out of the doorway. Object
        // states and classes are global, so nothing else needs resetting.
        if(hotelVisited) {
            putActorAt(VAR_EGO, 10, 118, Hotel);
            setCurrentActor(VAR_EGO);
            setActorDirection(90);
            walkActorTo(VAR_EGO, 36, 120);
            return;
        }
        hotelVisited = 1;

        setObjectClass(safe, [ SET_CLASS | UNTOUCHABLE ]);
        setObjectClass(cursor, [ SET_CLASS | UNTOUCHABLE ]);
        // Nothing is on the coffee table yet
        setObjectClass(tableMatchbook, [ SET_CLASS | UNTOUCHABLE ]);
        setObjectClass(tableCandy, [ SET_CLASS | UNTOUCHABLE ]);
        setObjectClass(tableKeycard, [ SET_CLASS | UNTOUCHABLE ]);
        setObjectClass(tableUniform, [ SET_CLASS | UNTOUCHABLE ]);
        setObjectClass(tableTowel, [ SET_CLASS | UNTOUCHABLE ]);
        setObjectClass(tableSoap, [ SET_CLASS | UNTOUCHABLE ]);
        setCursorImage(cursor, Hotel);
        setCursorHotspot(8, 8);
        setCursorTransparency(0);

        putActorAt(VAR_EGO, 96, 124, Hotel);
        setCurrentActor(VAR_EGO);
        setActorDirection(180);

        ResRoom::showInterface(0);
        delay(30);
        egoSay("Ugh. What time is it?"); waitForMessage();
        egoSay("Check-out was at noon. I have to get out of here."); waitForMessage();
        egoSay("Which would be easier if I knew where I put my key card."); waitForMessage();
        ResRoom::showInterface(1);
    }
}
