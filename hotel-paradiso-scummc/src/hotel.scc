/* Hotel Paradiso, Room 714 - the bedroom.
 *
 * Furniture you can interact with: door, TV, curtains, minibar, lamp, phone,
 * nightstand, dresser, painting, wall safe, bed and coffee table, plus the doorway to
 * the bathroom (src/bathroom.scc). The items you can take (candy bar,
 * matchbook, bellhop uniform, and the screwdriver and bag of powder in the
 * safe) are objects too, only clickable while they're visible.
 *
 * Each object's verb block is its SCUMM verb table; verbs it doesn't list get
 * defaultAction(). objB carries the inventory item for "Use X with <object>".
 *
 * Goal: get ready for the party on the ninth floor. The door won't let you
 * go until you are:
 *   1. fed:      minibar -> candy bar -> eat it
 *   2. dressed:  dresser -> bellhop uniform -> put it on (it's a costume party)
 *   3. pre-gamed:
 *      nightstand -> matchbook -> lamp on to read it -> code 714
 *      painting -> wall safe -> screwdriver and bag of powder
 *      screwdriver on the bathroom mirror -> mirror on the coffee table ->
 *      powder on the mirror -> razor on the powder -> three lines
 *      bed covers -> wallet -> dollar bill -> use it on the lines
 */

#include "hotel.sch"
#include "guest_anim.sch"
#include "clown1_anim.sch"

room Hotel {
    image = "room.bmp";
    boxd = "hotel.box";
    trans = 0;

    sound tvSnd = "tv.soun";       // two seconds of indistinct chatter
    sound safeSnd = "safe.soun";
    sound fridgeSnd = "fridge.soun";   // the minibar: handle, latch, seal
    sound drawerSnd = "drawer.soun";   // a wooden drawer sliding out
    sound bedSnd = "bed.soun";         // covers thrown back
    sound clownSnd = "clowns.soun";    // the room-service march
    sound dialSnd = "phone_dial.soun"; // dial whirs back from 0, one ring, Gustav picks up
    sound hangSnd = "phone_hang.soun"; // the receiver back on its cradle
    sound knockSnd = "knock.soun";     // room service at the door
    sound honkSnd = "honk.soun";       // HONK HONK
    sound chopSnd = "chop.soun";       // razor taps on the mirror
    sound sniffSnd = "sniff.soun";     // one line
    sound swoopSnd = "swoop.soun";     // the room starts to swim
    sound lampSnd = "lamp_click.soun"; // the lamp's switch
    sound tvOffSnd = "tv_off.soun";    // the old tube collapsing
    sound curtainSnd = "curtains.soun";// velvet along the rod
    sound paintingSnd = "painting.soun";   // the frame scraping aside
    sound partySnd = "party.soun";     // the party down the hall, muffled

    bit clownMusic;

    // Room service. The three costumes share one set of animations, so
    // clown1_anim_* numbers work for all of them.
    cost clown1Cost = "clown1.cost";
    cost clown2Cost = "clown2.cost";
    cost clown3Cost = "clown3.cost";   // keypad beeps, a chime, the bolt motor, the door

    object door;
    object tv;
    object tableMatchbook;
    object tableCandy;
    object tableMirror;
    object minibar;
    object dresser;
    object nightstand;
    object painting;
    object safe;
    object bed;
    object screwdriver;
    object powder;
    object cursor;

    local script powderOnMirror();
    local script chopLines();
    local script doLine();
    local script leaveRoom();
    local script clownService();

    // ------------------------------------------------------------ scripts
    // Set an inventory item down on the coffee table. Only the matchbook, the
    // candy bar and the mirror fit; each has its own slot object on the table
    // top (see "coffee table" below). The mirror's is also where the pre-game
    // happens.
    local script putOnTable(int item) {
        int slot;
        if(item == invPowder) { powderOnMirror(); return; }
        if(item == invShaver) { chopLines(); return; }
        if(item == invDollar) {
            if(tableMirrorState >= 3) doLine();
            else { egoSay("I'll hang on to my last dollar. I'll need it in a minute."); waitForMessage(); }
            return;
        }
        if(item == invWallet) {
            egoSay("I'm not leaving my wallet lying around. Not again."); waitForMessage();
            return;
        }
        if(item == invScrewdriver) {
            egoSay("I'll hang on to the screwdriver. You never know."); waitForMessage();
            return;
        }
        if(item == invUniform) {
            egoSay("The uniform stays with me. It's the whole costume."); waitForMessage();
            return;
        }
        if(item == invTowel || item == invSoap) {
            egoSay("That belongs in the bathroom, not on the coffee table."); waitForMessage();
            return;
        }
        slot = 0;
        if(item == invMatchbook)    { hasMatchbook = 0; slot = tableMatchbook; }
        else if(item == invCandy)   { hasCandy = 0;     slot = tableCandy; }
        else if(item == invMirror)  { hasMirror = 0;    slot = tableMirror; tableMirrorState = 1; }
        setObjectState(slot, 1);
        setObjectClass(slot, [ UNTOUCHABLE ]);
        ResRoom::refreshInventory();
        if(item == invMirror) { egoSay("Mirror on the table, face up. A perfect flat surface."); waitForMessage(); }
        else { egoSay("There."); waitForMessage(); }
    }

    // Pick an item back up off the coffee table
    local script takeFromTable(int item) {
        int slot;
        if(item == invMatchbook)    { hasMatchbook = 1; slot = tableMatchbook; }
        else if(item == invCandy)   { hasCandy = 1;     slot = tableCandy; }
        else if(item == invMirror)  { hasMirror = 1;    slot = tableMirror; tableMirrorState = 0; }
        setObjectState(slot, 0);
        setObjectClass(slot, [ SET_CLASS | UNTOUCHABLE ]);
        ResRoom::refreshInventory();
    }

    // ------------------------------------------------------------ the pre-game
    // Tip the bag out onto the mirror (mirror state 2)
    local script powderOnMirror() {
        if(tableMirrorState == 0) {
            egoSay("Not straight onto the table. This isn't a frat house. I need a mirror."); waitForMessage();
            return;
        }
        if(tableMirrorState > 1) {
            egoSay("There's already some on the mirror."); waitForMessage();
            return;
        }
        hasPowder = 0;
        tableMirrorState = 2;
        setObjectState(tableMirror, 2);
        ResRoom::refreshInventory();
        egoSay("I tip the bag out onto the mirror. A little white hill."); waitForMessage();
    }

    // The razor turns the pile into three lines (mirror state 3)
    local script chopLines() {
        if(tableMirrorState == 2) {
            tableMirrorState = 3;
            setObjectState(tableMirror, 3);
            startSound(chopSnd);
            egoSay("Chop, chop, chop."); waitForMessage();
            egoSay("Three neat lines. The extra blades finally pay for themselves."); waitForMessage();
        } else if(tableMirrorState >= 3) {
            egoSay("They're as neat as they're going to get."); waitForMessage();
        } else if(tableMirrorState == 1) {
            egoSay("I'd be shaving a mirror. Nothing on it yet."); waitForMessage();
        } else {
            egoSay("I'll keep the razor on me. Blades and coffee tables don't mix."); waitForMessage();
        }
    }

    // Do a line. The first gets you ready for the party. The second is one
    // too many: the room's colours start cycling. The third and you're not
    // going anywhere: off to bed, game over. Each one takes a line off the
    // mirror (states 4, 5, 6).
    local script doLine() {
        ResRoom::showInterface(0);
        linesDone++;
        tableMirrorState = 3 + linesDone;
        setObjectState(tableMirror, tableMirrorState);
        if(linesDone == 1) {
            readyToParty = 1;
            egoSay("I roll the dollar bill up nice and tight."); waitForMessage();
            egoSay("Here goes nothing."); waitForMessage();
            startSound(sniffSnd);
            delay(30);
            egoSay("...!"); waitForMessage();
            egoSay("Oh, hello. Hello, everyone. I feel great."); waitForMessage();
            egoSay("I feel fantastic. Let's go to a party."); waitForMessage();
        } else if(linesDone == 2) {
            egoSay("One more for the road."); waitForMessage();
            startSound(sniffSnd);
            delay(20);
            startSound(swoopSnd);
            ResRoom::startTrip();
            delay(40);
            egoSay("Whoa."); waitForMessage();
            egoSay("Did the wallpaper just... breathe?"); waitForMessage();
            egoSay("Everything is so colourful. I can hear the carpet."); waitForMessage();
        } else {
            gameOver = 1;
            egoSay("And one for the... other road."); waitForMessage();
            startSound(sniffSnd);
            delay(40);
            egoSay("You know what? Parties are overrated."); waitForMessage();
            egoSay("I'm just going to lie down. For a minute."); waitForMessage();
            walkActorTo(VAR_EGO, 240, 139);
            waitForActor(VAR_EGO);
            delay(30);
            ResRoom::stopTrip();
            startRoom(GameOver);
            return;
        }
        ResRoom::showInterface(1);
    }

    // Switch the TV on: a burst of chatter while the weather report scrolls
    // across the top of the screen in TV-blue.
    local script switchTvOn() {
        tvOn = 1;
        setObjectState(tv, 1);
        ResRoom::showInterface(0);
        startSound(tvSnd);
        printBegin(); printAt(160, 8); printCenter(); printColor(C_CYAN);
        print("...and now the Paradiso Weather. Sunny and 72 down by the pool."); waitForMessage();
        printBegin(); printAt(160, 8); printCenter(); printColor(C_CYAN);
        print("Clear skies all week, with a hundred percent chance of late check-out fees."); waitForMessage();
        ResRoom::showInterface(1);
        egoSay("Riveting."); waitForMessage();
    }

    // The safe's open image shows what's still inside: 2 both, 3 just the
    // screwdriver, 4 just the bag, 5 empty. The two item objects have no
    // images of their own; they're made clickable while they show.
    local script showSafe() {
        setObjectState(safe, 2 + tookPowder + 2 * tookScrewdriver);
        if(tookScrewdriver) setObjectClass(screwdriver, [ SET_CLASS | UNTOUCHABLE ]);
        else setObjectClass(screwdriver, [ UNTOUCHABLE ]);
        if(tookPowder) setObjectClass(powder, [ SET_CLASS | UNTOUCHABLE ]);
        else setObjectClass(powder, [ UNTOUCHABLE ]);
    }

    local script closeSafe() {
        safeOpen = 0;
        setObjectState(safe, 1);
        setObjectClass(screwdriver, [ SET_CLASS | UNTOUCHABLE ]);
        setObjectClass(powder, [ SET_CLASS | UNTOUCHABLE ]);
    }

    // Key in the code: three beeps, the accepted chime, the motor pulling the
    // bolt back. The door's image changes as it pops open on its spring.
    local script openSafe() {
        ResRoom::showInterface(0);
        egoSay("Seven. One. Four."); waitForMessage();
        startSound(safeSnd);
        delay(84);                  // beeps, chime, motor and clunk: 1.4s
        safeOpen = 1;
        showSafe();
        delay(30);                  // the puff of air as the door swings open
        ResRoom::showInterface(1);
        egoSay("It's open."); waitForMessage();
    }

    // Through the doorway on the left wall
    local script goBathroom() {
        startRoom(Bathroom);
    }

    // Taking an item: switch the container to its "open and empty" state
    // (which also hides the item object) and add the item to the inventory.
    local script takeUniform() {
        tookUniform = 1;
        hasUniform = 1;
        setObjectState(dresser, 2);
        ResRoom::refreshInventory();
        egoSay("It's exactly my size. That's either lucky or a plot."); waitForMessage();
    }

    local script takeCandy() {
        tookCandy = 1;
        hasCandy = 1;
        setObjectState(minibar, 2);
        ResRoom::refreshInventory();
        egoSay("A candy bar. Fourteen dollars. Worth it."); waitForMessage();
    }

    local script takeMatchbook() {
        tookMatchbook = 1;
        hasMatchbook = 1;
        setObjectState(nightstand, 2);
        ResRoom::refreshInventory();
        egoSay("Got it. There's writing inside the cover."); waitForMessage();
    }

    local script takeScrewdriver() {
        tookScrewdriver = 1;
        hasScrewdriver = 1;
        showSafe();
        ResRoom::refreshInventory();
        egoSay("A screwdriver. Past me had plans. Unclear ones."); waitForMessage();
    }

    // Picking up the wallet takes the dollar straight out of it: the dollar
    // goes in the inventory and the wallet goes in my pocket.
    local script takeWallet() {
        tookWallet = 1;
        hasDollar = 1;
        setObjectState(bed, 2);
        ResRoom::refreshInventory();
        egoSay("My wallet! I slept on it all day. That explains the bruise."); waitForMessage();
        egoSay("Inside: one dollar bill. I'll keep that handy and the wallet in my pocket."); waitForMessage();
    }

    local script takePowder() {
        tookPowder = 1;
        hasPowder = 1;
        showSafe();
        ResRoom::refreshInventory();
        egoSay("A little bag of white powder. Ah. Party supplies."); waitForMessage();
    }

    // Sets up the next print() as the front desk's voice on the phone:
    // yellow text centred at the top of the screen.
    local script deskSays() {
        printBegin();
        printAt(160, 12);
        printCenter();
        printColor(C_YELLOW);
    }

    // Gustav's advice depends on what's still standing between you and the party
    local script callDesk() {
        ResRoom::showInterface(0);
        phoneCalls++;
        egoSay("I dial zero."); waitForMessage();
        startSound(dialSnd);
        delay(165);                 // the dial runs back, it rings once, someone picks up
        if(phoneCalls > 4) {
            deskSays(); print("You have reached the front desk. Gustav is on his break."); waitForMessage();
            egoSay("Gustav is avoiding me."); waitForMessage();
            if(phoneCalls > 6) phoneCalls = 0;
            startSound(hangSnd);
            delay(20);
            ResRoom::showInterface(1);
            return;
        }
        deskSays(); print("Front desk, Gustav speaking. How may I help you?"); waitForMessage();
        if(!ateCandy) {
            egoSay("Is room service still open? I'm starving."); waitForMessage();
            deskSays(); print("Room service closed at ten, sir."); waitForMessage();
            deskSays(); print("Your minibar, however, is fully stocked. Expensively. Good night."); waitForMessage();
        } else if(uniformState) {
            egoSay("I got chocolate all over my costume. Any ideas?"); waitForMessage();
            deskSays(); print("Soap and the bathroom sink, sir. Then a good towelling."); waitForMessage();
            deskSays(); print("Housekeeping's oldest secret. Good night."); waitForMessage();
        } else if(!wearingUniform) {
            egoSay("The party on the ninth floor. Is it fancy dress?"); waitForMessage();
            deskSays(); print("A costume party, sir. Theme: hotel staff. Hilarious, I'm told."); waitForMessage();
            deskSays(); print("Housekeeping sometimes leaves spare uniforms in the dresser. Good night."); waitForMessage();
        } else if(!readyToParty) {
            egoSay("I'm fed and dressed, but I'm just not feeling it."); waitForMessage();
            deskSays(); print("Many guests keep their party supplies in the room safe, sir."); waitForMessage();
            if(tableMirrorState >= 3 && !tookWallet) {
                deskSays(); print("Guests who've lost their wallet usually find it in the bed, sir. Good night."); waitForMessage();
            } else if(!safeOpen && !tookScrewdriver) {
                deskSays(); print("Behind the painting. The code is whatever you wrote down. Good night."); waitForMessage();
            } else {
                deskSays(); print("And the bathroom mirror comes off with a screwdriver. I've said too much."); waitForMessage();
            }
        } else {
            // Fed, dressed and pre-gamed: Gustav sends up "room service"
            egoSay("Gustav! I'm fed, I'm dressed, and I am ready. Get me to that party!"); waitForMessage();
            deskSays(); print("Very good, sir. I'll send up room service."); waitForMessage();
            egoSay("Room service? I didn't order any..."); waitForMessage();
            startSound(hangSnd);
            deskSays(); print("Click."); waitForMessage();
            clownService();
            return;
        }
        startSound(hangSnd);
        delay(20);
        ResRoom::showInterface(1);
    }

    // The door lets you out once you're fed, dressed and ready
    local script tryDoor() {
        if(!ateCandy) {
            egoSay("I can't go to a party on an empty stomach. I'll pass out by the punch bowl."); waitForMessage();
        } else if(uniformState == 1) {
            egoSay("There's chocolate all over the uniform. I can't go like this."); waitForMessage();
        } else if(uniformState == 2) {
            egoSay("The uniform's still soaking wet. I'd drip all the way to the ninth floor."); waitForMessage();
        } else if(!wearingUniform) {
            egoSay("It's a costume party. I can't show up in a bathrobe. Again."); waitForMessage();
        } else if(!readyToParty) {
            egoSay("I'm just not feeling it yet. I need to pre-game."); waitForMessage();
        } else
            leaveRoom();
    }

    local script partyEnding();

    // One clown actor, in one of the three suits
    local script initClown(int a, int c) {
        loadCostume(c);
        setCurrentActor(a);
        initActor();
        setActorCostume(c);
        setActorWalkFrame(clown1_anim_walk);
        setActorStandFrame(clown1_anim_stand);
        setActorInitFrame(clown1_anim_init);
        setActorTalkFrame(clown1_anim_talkStart, clown1_anim_talkStop);
        setActorTalkColor(C_YELLOW);
        setActorTalkPos(0, -64);
        setActorWidth(24);
        setActorName("clown");
    }

    // Arms up, ready to carry
    local script clownLift(int a) {
        setCurrentActor(a);
        setActorWalkFrame(clown1_anim_carryWalk);
        setActorStandFrame(clown1_anim_carryStand);
        animateActor(a, clown1_anim_carryStand);
    }

    // The march loops for as long as the clowns are in the room
    local script loopClownMusic() {
        while(clownMusic) {
            unless(isSoundRunning(clownSnd)) startSound(clownSnd);
            delay(6);
        }
        stopSound(clownSnd);
    }

    // "Room service": three clowns come in, hoist the player overhead and
    // carry them out of the door, then the normal ending plays.
    local script clownService() {
        gameOver = 1;
        ResRoom::showInterface(0);
        walkActorTo(VAR_EGO, 150, 104);
        waitForActor(VAR_EGO);
        setCurrentActor(VAR_EGO);
        setActorDirection(270);
        delay(40);
        startSound(knockSnd);
        delay(55);
        egoSay("Someone's knocking."); waitForMessage();
        setObjectState(door, 1);
        clownMusic = 1;
        loopClownMusic();
        initClown(clownA, clown1Cost);
        initClown(clownB, clown2Cost);
        initClown(clownC, clown3Cost);
        putActorAt(clownA, 40, 102, Hotel);
        walkActorTo(clownA, 174, 104);
        delay(24);
        putActorAt(clownB, 40, 102, Hotel);
        walkActorTo(clownB, 126, 104);
        delay(24);
        putActorAt(clownC, 40, 102, Hotel);
        walkActorTo(clownC, 150, 101);
        waitForActor(clownA);
        waitForActor(clownB);
        waitForActor(clownC);
        setCurrentActor(clownA); setActorDirection(270);
        setCurrentActor(clownB); setActorDirection(90);
        setCurrentActor(clownC); setActorDirection(180);
        startSound(honkSnd);
        actorSay(clownC, "Room service! HONK HONK!"); waitForMessage();
        egoSay("...I'm sorry, what?"); waitForMessage();
        actorSay(clownA, "One guest, extra party, to go!"); waitForMessage();

        // Up you go: the player lies flat and floats up to the clowns' raised
        // hands, and keeps that pose while carried
        clownLift(clownA);
        clownLift(clownB);
        clownLift(clownC);
        setCurrentActor(VAR_EGO);
        setActorElevation(44);
        setActorWalkFrame(guest_anim_carried);
        setActorStandFrame(guest_anim_carried);
        setActorTalkFrame(guest_anim_carried, guest_anim_carried);   // talking mustn't stand you up
        animateActor(VAR_EGO, guest_anim_carried);
        delay(30);
        egoSay("Whoa! Okay! This is happening!"); waitForMessage();

        // Out through the door together
        walkActorTo(clownC, 22, 101);
        walkActorTo(VAR_EGO, 40, 104);
        walkActorTo(clownA, 64, 104);
        walkActorTo(clownB, 16, 106);
        delay(40);
        actorSay(clownB, "To the ninth floor!"); waitForMessage();
        waitForActor(VAR_EGO);
        putActorAt(clownC, 0, 0, 0);
        putActorAt(VAR_EGO, 0, 0, 0);
        waitForActor(clownA);
        putActorAt(clownA, 0, 0, 0);
        waitForActor(clownB);
        putActorAt(clownB, 0, 0, 0);
        delay(30);
        clownMusic = 0;
        stopSound(clownSnd);
        partyEnding();
    }

    // The party, faintly, through the open door: loops until the game restarts
    local script loopParty() {
        while(1) {
            unless(isSoundRunning(partySnd)) startSound(partySnd);
            delay(6);
        }
    }

    local script leaveRoom() {
        gameOver = 1;
        ResRoom::showInterface(0);
        egoSay("Fed. Dressed. Absolutely buzzing."); waitForMessage();
        setObjectState(door, 1);
        loopParty();
        egoSay("Ninth floor, here I come!"); waitForMessage();
        walkActorTo(VAR_EGO, 40, 101);
        waitForActor(VAR_EGO);
        putActorAt(VAR_EGO, 0, 0, 0);    // room 0 = gone
        partyEnding();
    }

    // The winning ending, whether you walked out or were carried
    local script partyEnding() {
        delaySeconds(1);
        printBegin(); printAt(160, 40); printCenter(); printColor(C_YELLOW);
        print("You made it to the party at the Hotel Paradiso."); waitForMessage();
        printBegin(); printAt(160, 40); printCenter(); printColor(C_WHITE);
        print("Everyone loved the bellhop costume. Two guests tipped you."); waitForMessage();
        printBegin(); printAt(160, 40); printCenter(); printColor(C_WHITE);
        print("THE END.   Thanks for playing!"); waitForMessage();
        printBegin(); printAt(160, 40); printCenter(); printColor(C_GREY);
        print("Minibar: $14. Missing mirror door: $85."); waitForMessage();
        // Back to the title screen. Restarting the engine resets every
        // variable, object state and the inventory, then runs main() again.
        delaySeconds(1);
        restartGame();
    }


    // ------------------------------------------------------------ bathroom doorway
    // The opening in the left wall. Walking into it goes to the bathroom.
    object bathroomDoor {
        x = 0; y = 24; w = 16; h = 104;
        hs_x = 12; hs_y = 94;
        dir = WEST;
        name = "bathroom";

        verb(int vrb, int objA, int objB) {
        case DefaultVerb:        // what a plain click does
            defaultVerb = WalkTo;
            return;
        case WalkTo:
        case Open:
            goBathroom();
            return;
        case Use:
            if(objB) { egoSay("I'll just carry it in."); waitForMessage(); }
            goBathroom();
            return;
        case LookAt:
            egoSay("The bathroom. Tiled, bright, and slightly too cold."); waitForMessage();
            return;
        case Close:
            egoSay("There's no door. Just a doorway. Very trusting."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ door tag
    // The Do Not Disturb sign on the handle. Declared before the door so the
    // cursor finds it first. Reading it is the game's standing hint: when
    // stuck, call the front desk.
    object doorTag {
        x = 54; y = 56; w = 9; h = 14;
        hs_x = -14; hs_y = 48;
        dir = NORTH;
        name = "Do Not Disturb sign";

        verb(int vrb, int objA, int objB) {
        case DefaultVerb:        // what a plain click does
            defaultVerb = LookAt;
            return;
        case LookAt:
            egoSay("PLEASE DO NOT DISTURB. Hotel Paradiso."); waitForMessage();
            egoSay("On the back: Need anything at all? Just pick up the phone."); waitForMessage();
            egoSay("Dial 0 and the front desk will be happy to help, day or night."); waitForMessage();
            return;
        case PickUp:
        case Pull:
            egoSay("It's hooked on the handle, and it's doing important work. I'm not to be disturbed."); waitForMessage();
            return;
        case Use:
            if(objB) { egoSay("It's a sign. It doesn't take attachments."); waitForMessage(); }
            else { egoSay("It's already doing its job. Nobody has disturbed me all day."); waitForMessage(); }
            return;
        case Open:
            egoSay("It's a sign, not a door."); waitForMessage();
            return;
        case TalkTo:
            egoSay("I'll try not to disturb you."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ door
    object door {
        x = 16; y = 16; w = 48; h = 80;
        hs_x = 24; hs_y = 88;
        dir = NORTH;
        name = "door";
        states = { { 24, 88, "objects/door_1.bmp" } };
        state = 0;

        verb(int vrb, int objA, int objB) {
        case DefaultVerb:        // what a plain click does
            defaultVerb = Open;
            return;
        case LookAt:
            if(readyToParty) { egoSay("The door to the hallway. And beyond it: the party!"); waitForMessage(); }
            else { egoSay("The door to the hallway. The party's up on the ninth floor."); waitForMessage(); }
            return;
        case Open:
        case Pull:
            tryDoor();
            return;
        case Use:
            if(objB == invScrewdriver) { egoSay("Take the door off its hinges? It already opens. That's not the problem."); waitForMessage(); }
            else if(objB) { egoSay("The door doesn't need that."); waitForMessage(); }
            else tryDoor();
            return;
        case Push:
            egoSay("It opens inward."); waitForMessage();
            return;
        case Close:
            egoSay("It's already closed."); waitForMessage();
            return;
        case TalkTo:
            egoSay("Hello? Party people? Anyone?"); waitForMessage();
            egoSay("I can hear the music from here. Faintly."); waitForMessage();
            return;
        case PickUp:
            egoSay("It's a door. It stays where it is."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ bellhop uniform
