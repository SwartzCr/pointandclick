    // ------------------------------------------------------------ safe
    object safe {
        x = 248; y = 8; w = 48; h = 40;
        hs_x = -18; hs_y = 131;
        dir = EAST;
        name = "wall safe";
        states = {
            { -18, 131, "objects/safe_1.bmp" },   // revealed, closed
            { -18, 131, "objects/safe_2.bmp" },   // open: screwdriver and bag
            { -18, 131, "objects/safe_3.bmp" },   // open: just the screwdriver
            { -18, 131, "objects/safe_4.bmp" },   // open: just the bag
            { -18, 131, "objects/safe_5.bmp" }    // open, empty
        };
        state = 0;

        verb(int vrb, int objA, int objB) {
        case DefaultVerb:        // what a plain click does: open it, or close it if it's open
            defaultVerb = safeOpen ? Close : Open;
            return;
        case LookAt:
            if(safeOpen && !tookScrewdriver && !tookPowder) { egoSay("A screwdriver and a little bag of white powder. Past me packed for a party."); waitForMessage(); }
            else if(safeOpen && !tookScrewdriver) { egoSay("Just the screwdriver left."); waitForMessage(); }
            else if(safeOpen && !tookPowder) { egoSay("Just the little bag left."); waitForMessage(); }
            else if(safeOpen) { egoSay("Empty."); waitForMessage(); }
            else { egoSay("A wall safe with a keypad. It wants a three-digit code."); waitForMessage(); }
            return;
        case Open:
        case Use:
            if(safeOpen) {
                egoSay("It's already open."); waitForMessage();
            } else if(objB && objB != invMatchbook) {
                egoSay("That won't open a safe."); waitForMessage();
            } else if(knowsCode)
                openSafe(); else if(hasMatchbook) {
                egoSay("I think I wrote the code inside the matchbook. I should read it."); waitForMessage();
            } else {
                egoSay("I don't remember the code. I barely remember last night."); waitForMessage();
            }
            return;
        case PickUp:
            if(safeOpen && !tookScrewdriver) takeScrewdriver();
            else if(safeOpen && !tookPowder) takePowder();
            else if(safeOpen) {
                egoSay("There's nothing left in it."); waitForMessage();
            } else {
                egoSay("It's built into the wall."); waitForMessage();
            }
            return;
        case Close:
        case Push:
            if(safeOpen) closeSafe();
            else { egoSay("It's closed."); waitForMessage(); }
            return;
        case TalkTo:
            egoSay("Open sesame."); waitForMessage();
            egoSay("Worth a try."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ coffee table
    // The matchbook, the candy bar and the mirror can be set down on the table
    // ("Use X with coffee table") and picked up again; the mirror takes the
    // wide middle of the table. Each has its own slot object on the table top:
    // state 1 shows it, and it's untouchable while the slot is empty. The
    // slots are declared before the table so the cursor finds them first.
    // The walk-to spot for all of them is beside the table, so the player
    // doesn't stand in front of what's on it.
    object tableMatchbook {
        x = 112; y = 104; w = 16; h = 16;
        hs_x = 110; hs_y = 18;
        dir = WEST;
        name = "matchbook";
        states = { { 110, 18, "objects/table_matchbook_1.bmp" } };
        state = 0;
        verb(int vrb, int objA, int objB) {
        case DefaultVerb:        // what a plain click does
            defaultVerb = PickUp;
            return;
        case LookAt:
            egoSay("The matchbook, right where I left it."); waitForMessage();
            return;
        case PickUp:
            takeFromTable(invMatchbook);
            return;
        }
    }

    object tableCandy {
        x = 192; y = 104; w = 16; h = 16;
        hs_x = 30; hs_y = 18;
        dir = WEST;
        name = "candy bar";
        states = { { 30, 18, "objects/table_candy_1.bmp" } };
        state = 0;
        verb(int vrb, int objA, int objB) {
        case DefaultVerb:        // what a plain click does
            defaultVerb = PickUp;
            return;
        case LookAt:
            egoSay("Fourteen dollars of nougat, displayed with pride."); waitForMessage();
            return;
        case PickUp:
            takeFromTable(invCandy);
            return;
        }
    }

    // The mirror door from the bathroom cabinet. Its states follow
    // tableMirrorState: 1 bare, 2 a pile of powder, 3 three lines, 4 two.
    object tableMirror {
        x = 128; y = 104; w = 64; h = 16;
        hs_x = 94; hs_y = 18;
        dir = WEST;
        name = "mirror";
        states = {
            { 94, 18, "objects/table_mirror_1.bmp" },
            { 94, 18, "objects/table_mirror_2.bmp" },
            { 94, 18, "objects/table_mirror_3.bmp" },
            { 94, 18, "objects/table_mirror_4.bmp" },
            { 94, 18, "objects/table_mirror_5.bmp" },
            { 94, 18, "objects/table_mirror_6.bmp" }
        };
        state = 0;
        verb(int vrb, int objA, int objB) {
        case DefaultVerb:        // what a plain click does
            defaultVerb = LookAt;
            return;
        case LookAt:
            if(tableMirrorState == 1) { egoSay("The cabinet mirror, lying flat on the table. Ready for business."); waitForMessage(); }
            else if(tableMirrorState == 2) { egoSay("A little white hill on the mirror. It needs chopping up."); waitForMessage(); }
            else if(tableMirrorState == 3) { egoSay("Three lines, neat as a barcode."); waitForMessage(); }
            else if(tableMirrorState == 4) { egoSay("Two lines left. They can stay there."); waitForMessage(); }
            else { egoSay("One line left. It's looking at me."); waitForMessage(); }
            return;
        case PickUp:
            if(tableMirrorState == 1) takeFromTable(invMirror);
            else { egoSay("Not without spilling everything."); waitForMessage(); }
            return;
        case Use:
            if(objB == invPowder) powderOnMirror();
            else if(objB == invShaver) chopLines();
            else if(objB == invDollar && tableMirrorState >= 3) doLine();
            else if(objB == invDollar) { egoSay("Not yet. It isn't ready."); waitForMessage(); }
            else if(objB) { egoSay("That doesn't go on the mirror."); waitForMessage(); }
            else if(tableMirrorState >= 3 && readyToParty) doLine();
            else if(tableMirrorState >= 3 && (hasDollar || hasWallet)) { egoSay("Not with my bare nose. I'll roll up that dollar bill."); waitForMessage(); }
            else if(tableMirrorState >= 3) { egoSay("Not with my bare nose. I need something to roll up. Some cash, say."); waitForMessage(); }
            else if(tableMirrorState == 2) { egoSay("It's all one lump. I need something sharp to chop it into lines."); waitForMessage(); }
            else { egoSay("I admire my reflection from above. Still got it."); waitForMessage(); }
            return;
        }
    }

    object coffeeTable {
        x = 112; y = 104; w = 96; h = 24;
        hs_x = 110; hs_y = 18;
        dir = WEST;
        name = "coffee table";

        verb(int vrb, int objA, int objB) {
        case DefaultVerb:        // what a plain click does
            defaultVerb = LookAt;
            return;
        case LookAt:
            egoSay("A low coffee table. A good place to put things down."); waitForMessage();
            return;
        case Use:
            if(objB) putOnTable(objB);
            else { egoSay("I could put something on it."); waitForMessage(); }
            return;
        case PickUp:
            egoSay("It's furniture. It stays."); waitForMessage();
            return;
        case Push:
        case Pull:
            egoSay("It's heavier than it looks. It can stay where it is."); waitForMessage();
            return;
        case TalkTo:
            egoSay("Nice table. Sturdy."); waitForMessage();
            return;
        }
    }

