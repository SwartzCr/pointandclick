            return;
        case PickUp:
            takeUniform();
            return;
        case Use:
            egoSay("I'll take it out first."); waitForMessage();
            return;
        case TalkTo:
            egoSay("Front! Boy!"); waitForMessage();
            egoSay("Nothing. Good help is hard to find."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ dresser
    // The chest of drawers under the TV. Opening it pulls out the top drawer:
    // state 1 with the uniform inside, state 2 once it's been taken.
    object dresser {
        x = 72; y = 64; w = 56; h = 32;
        // Stand beside it so the open drawer stays in view
        hs_x = -12; hs_y = 42;
        dir = EAST;
        name = "dresser";
        states = {
            { -12, 42, "objects/dresser_1.bmp" },   // open, uniform inside
            { -12, 42, "objects/dresser_2.bmp" }    // open, empty
        };
        state = 0;

        verb(int vrb, int objA, int objB) {
        case DefaultVerb:        // what a plain click does: open it, or close it if it's open
            defaultVerb = dresserOpen ? Close : Open;
            return;
        case LookAt:
            if(dresserOpen && !tookUniform) { egoSay("There's a bellhop uniform folded in the top drawer."); waitForMessage(); }
            else if(dresserOpen) { egoSay("Empty. Not even a hotel bible."); waitForMessage(); }
            else { egoSay("A chest of drawers, under a TV that's older than I am."); waitForMessage(); }
            return;
        case Open:
        case Pull:
            if(dresserOpen) { egoSay("It's already open."); waitForMessage(); }
            else {
                dresserOpen = 1;
                startSound(drawerSnd);
                if(tookUniform) setObjectState(dresser, 2);
                else {
                    setObjectState(dresser, 1);
                    egoSay("Huh. Someone left a bellhop uniform in here."); waitForMessage();
                }
            }
            return;
        case Close:
        case Push:
            if(dresserOpen) { dresserOpen = 0; setObjectState(dresser, 0); }
            else { egoSay("It's closed."); waitForMessage(); }
            return;
        case PickUp:
            if(dresserOpen && !tookUniform) takeUniform();
            else { egoSay("It's furniture. It stays."); waitForMessage(); }
            return;
        case Use:
            if(objB) { egoSay("I'll leave the drawers to the professionals. The coffee table's right there."); waitForMessage(); }
            else { egoSay("I could open it."); waitForMessage(); }
            return;
        }
    }

    // ------------------------------------------------------------ tv
    object tv {
        x = 80; y = 16; w = 48; h = 48;
        hs_x = 20; hs_y = 88;
        dir = NORTH;
        name = "TV";
        states = { { 20, 88, "objects/tv_1.bmp" } };
        state = 0;

        verb(int vrb, int objA, int objB) {
        case DefaultVerb:        // what a plain click does
            defaultVerb = Use;
            return;
        case LookAt:
            if(tvOn) {
                tvAd = !tvAd;
                if(tvAd) { egoSay("The Paradiso Channel. Forecast: sunny, with a chance of late fees."); waitForMessage(); }
                else { egoSay("An ad: Paradiso safes. Hidden where nobody would ever look."); waitForMessage(); }
            } else {
                egoSay("A TV the size of a suitcase. Retro, or just old."); waitForMessage();
            }
            return;
        case Use:
        case Push:
            if(objB) {
                egoSay("I don't think the TV needs that."); waitForMessage();
            } else if(tvOn) {
                tvOn = 0;
                startSound(tvOffSnd);
                setObjectState(tv, 0);
                egoSay("Click."); waitForMessage();
            } else
                switchTvOn();
            return;
        case Close:
            if(tvOn) { tvOn = 0; startSound(tvOffSnd); setObjectState(tv, 0); }
            else { egoSay("It's already off."); waitForMessage(); }
            return;
        case TalkTo:
            egoSay("TV, what's the code for the safe?"); waitForMessage();
            if(tvOn) { egoSay("It cut to a commercial. Typical."); waitForMessage(); }
            else { egoSay("The silent treatment. Fair."); waitForMessage(); }
            return;
        case PickUp:
            egoSay("It weighs more than I do."); waitForMessage();
            return;
        }
    }

