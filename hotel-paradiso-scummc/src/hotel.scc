    // ------------------------------------------------------------ bed
    // Opening it pulls the covers back: state 1 with the wallet on the
    // sheet, state 2 once it's been taken.
    object bed {
        x = 232; y = 48; w = 88; h = 88;
        hs_x = 8; hs_y = 91;
        dir = EAST;
        name = "bed";
        states = {
            { 8, 91, "objects/bed_1.bmp" },   // covers back, wallet on the sheet
            { 8, 91, "objects/bed_2.bmp" }    // covers back, no wallet
        };
        state = 0;

        verb(int vrb, int objA, int objB) {
        case DefaultVerb:        // what a plain click does: open it, or close it if it's open
            defaultVerb = bedOpen ? Close : Open;
            return;
        case LookAt:
            if(bedOpen && !tookWallet) { egoSay("My wallet, lying right where I slept."); waitForMessage(); }
            else if(tookWallet) { egoSay("Unmade. My work."); waitForMessage(); }
            else { egoSay("Unmade. My work. There's a lump under the covers."); waitForMessage(); }
            return;
        case Use:
            egoSay("No time for a nap. There's a party on."); waitForMessage();
            return;
        case Push:
            egoSay("I'm not wrestling a mattress today."); waitForMessage();
            return;
        case PickUp:
            if(bedOpen && !tookWallet) takeWallet();
            else { egoSay("Not with my back."); waitForMessage(); }
            return;
        case Open:
        case Pull:
            if(bedOpen) { egoSay("The covers are already back."); waitForMessage(); }
            else {
                bedOpen = 1;
                startSound(bedSnd);
                setObjectState(bed, tookWallet ? 2 : 1);
                if(tookWallet) { egoSay("One sock. Not mine."); waitForMessage(); }
                else { egoSay("I pull back the covers. There's my wallet!"); waitForMessage(); }
            }
            return;
        case Close:
            if(bedOpen) {
                bedOpen = 0;
                startSound(bedSnd);
                setObjectState(bed, 0);
                egoSay("I make the bed. Loosely."); waitForMessage();
            } else { egoSay("It's as made as it's going to get."); waitForMessage(); }
            return;
        case TalkTo:
            egoSay("Goodbye, bed. You were the best part of this trip."); waitForMessage();
            return;
        }
    }

    // ------------------------------------------------------------ cursor
    // Holds the mouse cursor image; never drawn and never clickable.
    object cursor {
        x = 0; y = 0; w = 16; h = 16;
        name = "";
        states = { { 0, 0, "cursor.bmp" } };
        state = 0;
    }

    local script entry() {
        createBoxMatrix();

        // Coming back from the bathroom: step out of the doorway. Object
        // states and classes are global, so nothing else needs resetting.
        if(hotelVisited) {
            putActorAt(VAR_EGO, 10, 118, Hotel);
            setCurrentActor(VAR_EGO);
            setActorDirection(90);
            walkActorTo(VAR_EGO, 36, 120);
            return;
        }
        hotelVisited = 1;

        setObjectClass(safe, [ SET_CLASS | UNTOUCHABLE ]);
        setObjectClass(cursor, [ SET_CLASS | UNTOUCHABLE ]);
        // Nothing is on the coffee table yet
        setObjectClass(tableMatchbook, [ SET_CLASS | UNTOUCHABLE ]);
        setObjectClass(tableCandy, [ SET_CLASS | UNTOUCHABLE ]);
        setObjectClass(tableMirror, [ SET_CLASS | UNTOUCHABLE ]);
        setObjectClass(screwdriver, [ SET_CLASS | UNTOUCHABLE ]);
        setObjectClass(powder, [ SET_CLASS | UNTOUCHABLE ]);
        setCursorImage(cursor, Hotel);
        setCursorHotspot(8, 8);
        setCursorTransparency(0);

        putActorAt(VAR_EGO, 96, 124, Hotel);
        setCurrentActor(VAR_EGO);
        setActorDirection(180);

        ResRoom::showInterface(0);
        delay(30);
        egoSay("Ugh. What time is it?"); waitForMessage();
        egoSay("Nine at night? The party! The big party up on the ninth floor."); waitForMessage();
        egoSay("I am in no state to go to a party. Yet."); waitForMessage();
        ResRoom::showInterface(1);
    }
}
