/* Hotel Paradiso, Room 714 - interface and boot.
 *
 * ResRoom never appears on screen. It holds the charset and the player's
 * costume, and every global script: boot, the verb bar, the live sentence
 * line, input, the sentence handler and the text inventory.
 */

#include "hotel.sch"
#include "guest_anim.sch"

room ResRoom {

    // The GUI uses the first charset, so pin ours to slot 1
    chset font @ 1 = "font.char";
    cost guestCost = "guest.cost";
    cost bellhopCost = "bellhop.cost";

    bit cursorShown;

    script inventoryClick(int item);
    script wearUniform(int on);
    script useOnSelf(int item);
    script defaultAction(int vrb, int item);
    script openWallet();

    // ------------------------------------------------------------ verbs
    script makeVerb(int vrb, int x, int y) {
        setCurrentVerb(vrb);
        setVerbXY(x, y);
        setVerbColor(C_TEAL);
        setVerbHiColor(C_CYAN);
        setVerbDimColor(C_DKGREY);
        setVerbBackColor(C_BLACK);
        setVerbOn();
        redrawVerb();
    }

    script setupVerbs() {
        setCurrentVerb(Open);   initVerb(); setVerbName("Open");    setVerbKey('o');
        setCurrentVerb(Close);  initVerb(); setVerbName("Close");   setVerbKey('c');
        setCurrentVerb(TalkTo); initVerb(); setVerbName("Talk to"); setVerbKey('t');
        setCurrentVerb(PickUp); initVerb(); setVerbName("Pick up"); setVerbKey('p');
        setCurrentVerb(LookAt); initVerb(); setVerbName("Look at"); setVerbKey('l');
        setCurrentVerb(Use);    initVerb(); setVerbName("Use");     setVerbKey('u');
        setCurrentVerb(Push);   initVerb(); setVerbName("Push");
        setCurrentVerb(Pull);   initVerb(); setVerbName("Pull");
        setCurrentVerb(WalkTo); initVerb(); setVerbName("Walk to"); setVerbKey('w');

        makeVerb(Open,     8, 160);
        makeVerb(Close,    8, 172);
        makeVerb(TalkTo,   8, 184);
        makeVerb(PickUp,  72, 160);
        makeVerb(LookAt,  72, 172);
        makeVerb(Use,     72, 184);
        makeVerb(Push,   136, 160);
        makeVerb(Pull,   136, 172);
        makeVerb(WalkTo, 136, 184);

        // Sentence line: centred, never clickable
        setCurrentVerb(SntcLine);
        initVerb();
        setVerbName("Walk to");
        setVerbXY(160, 146);
        verbCenter();
        setVerbColor(C_WHITE);
        setVerbHiColor(C_WHITE);
        setVerbBackColor(C_BLACK);
        setVerbOn();
        redrawVerb();

        // Inventory slots, shown only while the item is carried.
        // Labels are short so they fit two 62-pixel columns of five
        setCurrentVerb(invMatchbook);   initVerb(); setVerbName("matches");
        setCurrentVerb(invCandy);       initVerb(); setVerbName("candy");
        setCurrentVerb(invUniform);     initVerb(); setVerbName("uniform");
        setCurrentVerb(invTowel);       initVerb(); setVerbName("towel");
        setCurrentVerb(invSoap);        initVerb(); setVerbName("soap");
        setCurrentVerb(invShaver);      initVerb(); setVerbName("razor");
        setCurrentVerb(invScrewdriver); initVerb(); setVerbName("driver");
        setCurrentVerb(invPowder);      initVerb(); setVerbName("powder");
        setCurrentVerb(invMirror);      initVerb(); setVerbName("mirror");
        setCurrentVerb(invWallet);      initVerb(); setVerbName("wallet");
        setCurrentVerb(invDollar);      initVerb(); setVerbName("dollar");
        makeVerb(invMatchbook,   196, 154);
        makeVerb(invCandy,       196, 163);
        makeVerb(invUniform,     196, 172);
        makeVerb(invTowel,       196, 181);
        makeVerb(invSoap,        196, 190);
        makeVerb(invShaver,      258, 154);
        makeVerb(invScrewdriver, 258, 163);
        makeVerb(invPowder,      258, 172);
        makeVerb(invMirror,      258, 181);
        makeVerb(invWallet,      258, 190);
        makeVerb(invDollar,      258, 190);
        setCurrentVerb(invMatchbook);   setVerbColor(C_YELLOW);
        setCurrentVerb(invCandy);       setVerbColor(C_YELLOW);
        setCurrentVerb(invUniform);     setVerbColor(C_YELLOW);
        setCurrentVerb(invTowel);       setVerbColor(C_YELLOW);
        setCurrentVerb(invSoap);        setVerbColor(C_YELLOW);
        setCurrentVerb(invShaver);      setVerbColor(C_YELLOW);
        setCurrentVerb(invScrewdriver); setVerbColor(C_YELLOW);
        setCurrentVerb(invPowder);      setVerbColor(C_YELLOW);
        setCurrentVerb(invMirror);      setVerbColor(C_YELLOW);
        setCurrentVerb(invWallet);      setVerbColor(C_YELLOW);
        setCurrentVerb(invDollar);      setVerbColor(C_YELLOW);
        // Title screen menu, centred under the picture
        setCurrentVerb(NewGame);  initVerb(); setVerbName("New game"); setVerbKey('n');
        setCurrentVerb(QuitGame); initVerb(); setVerbName("Quit");     setVerbKey('q');
        makeVerb(NewGame,  160, 158);
        makeVerb(QuitGame, 160, 174);
        setCurrentVerb(NewGame);  verbCenter();
        setCurrentVerb(QuitGame); verbCenter();
        refreshInventory();
    }

    // The verb bar and sentence line during play, or the title menu
    script showGameVerb(int vrb, int on) {
        setCurrentVerb(vrb);
        if(on) setVerbOn(); else setVerbOff();
        redrawVerb();
    }

    script showGameVerbs(int on) {
        // erase first, then draw, so nothing wipes what's just been drawn
        showGameVerb(NewGame, 0);
        showGameVerb(QuitGame, 0);
        showGameVerb(Open, 0);   showGameVerb(Close, 0);  showGameVerb(TalkTo, 0);
        showGameVerb(PickUp, 0); showGameVerb(LookAt, 0); showGameVerb(Use, 0);
        showGameVerb(Push, 0);   showGameVerb(Pull, 0);   showGameVerb(WalkTo, 0);
        showGameVerb(SntcLine, 0);
        if(on) {
            showGameVerb(Open, 1);   showGameVerb(Close, 1);  showGameVerb(TalkTo, 1);
            showGameVerb(PickUp, 1); showGameVerb(LookAt, 1); showGameVerb(Use, 1);
            showGameVerb(Push, 1);   showGameVerb(Pull, 1);   showGameVerb(WalkTo, 1);
            showGameVerb(SntcLine, 1);
        } else {
            showGameVerb(NewGame, 1);
            showGameVerb(QuitGame, 1);
        }
        refreshInventory();
    }

    // Everything off: the game-over screen has no interface at all
    script hideAllVerbs() {
        showGameVerbs(1);
        showGameVerb(Open, 0);   showGameVerb(Close, 0);  showGameVerb(TalkTo, 0);
        showGameVerb(PickUp, 0); showGameVerb(LookAt, 0); showGameVerb(Use, 0);
        showGameVerb(Push, 0);   showGameVerb(Pull, 0);   showGameVerb(WalkTo, 0);
        showGameVerb(SntcLine, 0);
        showGameVerb(invMatchbook, 0);   showGameVerb(invCandy, 0);  showGameVerb(invUniform, 0);
        showGameVerb(invTowel, 0);       showGameVerb(invSoap, 0);   showGameVerb(invShaver, 0);
        showGameVerb(invScrewdriver, 0); showGameVerb(invPowder, 0); showGameVerb(invMirror, 0);
        showGameVerb(invWallet, 0);      showGameVerb(invDollar, 0);
    }

    // The second line: the room's colours start cycling through lurid tints
    // and keep at it, in every room, until the game ends. Indices 0..15 (text
    // and verbs) are left alone so the interface stays readable.
    script tripColors() {
        while(tripping) {
            setRoomRGBIntensity(420, 150, 330, 16, 255); delay(9);
            if(!tripping) break;
            setRoomRGBIntensity(240, 120, 460, 16, 255); delay(9);
            if(!tripping) break;
            setRoomRGBIntensity(130, 380, 380, 16, 255); delay(9);
            if(!tripping) break;
            setRoomRGBIntensity(170, 430, 150, 16, 255); delay(9);
            if(!tripping) break;
            setRoomRGBIntensity(430, 400, 110, 16, 255); delay(9);
            if(!tripping) break;
            setRoomRGBIntensity(460, 200, 130, 16, 255); delay(9);
        }
        setRoomRGBIntensity(255, 255, 255, 16, 255);
    }

    script startTrip() {
        if(tripping) return;
        tripping = 1;
        tripColors();
    }

    script stopTrip() {
        tripping = 0;
    }

    // "New game" on the title screen. Every puzzle flag and object state is
    // still at its boot value (the ending restarts the engine), so this just
    // brings up the verb bar and goes to the bedroom.
    script startNewGame() {
        titleMode = 0;
        curVerb = WalkTo;
        withItem = 0;
        showGameVerbs(1);
        startRoom(Hotel);
    }

    // Put one carried item in the next free inventory slot: five rows in
    // each of two columns, filled top to bottom, left column first.
    script placeInv(int vrb, int slot) {
        setCurrentVerb(vrb);
        if(slot < 5)
            setVerbXY(196, 154 + slot * 9);
        else
            setVerbXY(258, 154 + (slot - 5) * 9);
        setVerbOn();
        redrawVerb();
    }

    // Lay out carried items with no gaps. Every slot is erased first:
    // redrawing a moved verb clears its old spot, which would wipe whatever
    // item was just drawn there.
    script refreshInventory() {
        int slot;

        setCurrentVerb(invMatchbook);   setVerbOff(); redrawVerb();
        setCurrentVerb(invCandy);       setVerbOff(); redrawVerb();
        setCurrentVerb(invUniform);     setVerbOff(); redrawVerb();
        setCurrentVerb(invTowel);       setVerbOff(); redrawVerb();
        setCurrentVerb(invSoap);        setVerbOff(); redrawVerb();
        setCurrentVerb(invShaver);      setVerbOff(); redrawVerb();
        setCurrentVerb(invScrewdriver); setVerbOff(); redrawVerb();
        setCurrentVerb(invPowder);      setVerbOff(); redrawVerb();
        setCurrentVerb(invMirror);      setVerbOff(); redrawVerb();
        setCurrentVerb(invWallet);      setVerbOff(); redrawVerb();
        setCurrentVerb(invDollar);      setVerbOff(); redrawVerb();

        slot = 0;
        if(hasMatchbook)   { placeInv(invMatchbook, slot);   slot++; }
        if(hasCandy)       { placeInv(invCandy, slot);       slot++; }
        if(hasUniform)     { placeInv(invUniform, slot);     slot++; }
        if(hasTowel)       { placeInv(invTowel, slot);       slot++; }
        if(hasSoap)        { placeInv(invSoap, slot);        slot++; }
        if(hasShaver)      { placeInv(invShaver, slot);      slot++; }
        if(hasScrewdriver) { placeInv(invScrewdriver, slot); slot++; }
        if(hasPowder)      { placeInv(invPowder, slot);      slot++; }
        if(hasMirror)      { placeInv(invMirror, slot);      slot++; }
        if(hasWallet)      { placeInv(invWallet, slot);      slot++; }
        if(hasDollar)      { placeInv(invDollar, slot);      slot++; }
    }

    script showInterface(int show) {
        if(show) {
            cursorOn();
            userPutOn();
        } else {
            cursorOff();
            userPutOff();
        }
        cursorShown = show;
    }

    // What a plain click on obj does: asks the object (its DefaultVerb code
    // runs at once and sets defaultVerb), or 0 if it has no default.
    script queryDefault(int obj) {
        defaultVerb = 0;
        if(obj && getObjectVerbEntrypoint(obj, DefaultVerb))
            startObject(2, obj, DefaultVerb, [ DefaultVerb, obj, 0 ]);
    }

    // ------------------------------------------------------------ sentence line
    // Runs forever: rebuilds "Verb object" whenever the cursor or verb changes.
    script mouseWatch() {
        int obj, inv, lastObj, lastInv, lastVerb, lastWith, dflt, lastDflt;
        lastObj = -1;
        while(1) {
            if(titleMode) {
                lastObj = -1;
                breakScript();
                continue;
            }
            obj = getObjectAt(VAR_VIRT_MOUSE_X, VAR_VIRT_MOUSE_Y);
            if(withItem && getActorAt(VAR_VIRT_MOUSE_X, VAR_VIRT_MOUSE_Y) == VAR_EGO)
                obj = VAR_EGO;
            inv = getVerbAt(VAR_MOUSE_X, VAR_MOUSE_Y);
            unless(isAnyOf(inv, [ invMatchbook, invCandy, invUniform, invTowel, invSoap, invShaver, invScrewdriver, invPowder, invMirror, invWallet, invDollar ]))
                inv = 0;
            hoverObj = obj;
            hoverInv = inv;
            // the default can change while hovering (a drawer you just opened)
            dflt = 0;
            if(obj && obj != VAR_EGO && curVerb == WalkTo && !withItem) {
                queryDefault(obj);
                dflt = defaultVerb;
            }

            unless(obj == lastObj && inv == lastInv && curVerb == lastVerb && withItem == lastWith && dflt == lastDflt) {
                lastDflt = dflt;
                lastObj = obj;
                lastInv = inv;
                lastVerb = curVerb;
                lastWith = withItem;
                setCurrentVerb(SntcLine);
                if(withItem) {
                    if(inv)
                        setVerbName("Use %v{withItem} with %v{hoverInv}");
                    else
                        setVerbName("Use %v{withItem} with %n{hoverObj}");
                } else if(inv && curVerb == WalkTo)
                    setVerbName("%v{hoverInv}");      // no verb chosen: just the item
                else if(inv)
                    setVerbName("%v{curVerb} %v{hoverInv}");
                else if(curVerb == WalkTo && dflt) {
                    defaultVerb = dflt;
                    setVerbName("%v{defaultVerb} %n{hoverObj}");   // what a click will do
                } else if(curVerb == WalkTo && obj)
                    setVerbName("%n{hoverObj}");
                else
                    setVerbName("%v{curVerb} %n{hoverObj}");
                redrawVerb();
            }
            breakScript();
        }
    }

    // ------------------------------------------------------------ input
    // Called by the engine: area 1 = verb bar, 2 = room, 4 = keyboard.
    script inputHandler(int area, int cmd, int btn) {
        int obj;

        if(gameOver) return;

        if(titleMode) {
            if(area == 1 && cmd == NewGame) startNewGame();
            else if(area == 1 && cmd == QuitGame) shutdown();
            return;
        }

        if(area == 1) {
            if(isAnyOf(cmd, [ invMatchbook, invCandy, invUniform, invTowel, invSoap, invShaver, invScrewdriver, invPowder, invMirror, invWallet, invDollar ]))
                inventoryClick(cmd);
            else if(isAnyOf(cmd, [ Open, Close, TalkTo, PickUp, LookAt,
                                   Use, Push, Pull, WalkTo ])) {
                curVerb = cmd;
                withItem = 0;
            }
            return;
        }
        if(area != 2) return;

        obj = getObjectAt(VAR_VIRT_MOUSE_X, VAR_VIRT_MOUSE_Y);

        // "Use <item> with me"
        if(withItem && getActorAt(VAR_VIRT_MOUSE_X, VAR_VIRT_MOUSE_Y) == VAR_EGO) {
            stopSentence();
            useOnSelf(withItem);
            withItem = 0;
            curVerb = WalkTo;
            return;
        }

        // Right click is a shortcut for "Look at"
        if(btn == 2 && obj) {
            curVerb = LookAt;
            withItem = 0;
        }

        stopSentence();
        // Doorways handle Walk to themselves, so walking into one changes room
        if(obj && curVerb == WalkTo && getObjectVerbEntrypoint(obj, WalkTo)) {
            sentenceItem = 0;
            doSentence(WalkTo, obj, 0, 0);
            return;
        }
        // No verb chosen: objects with a default action do it
        if(obj && curVerb == WalkTo) {
            queryDefault(obj);
            if(defaultVerb) {
                sentenceItem = 0;
                doSentence(defaultVerb, obj, 0, 0);
                return;
            }
        }
        if(!obj || curVerb == WalkTo) {
            walkActorTo(VAR_EGO, VAR_VIRT_MOUSE_X, VAR_VIRT_MOUSE_Y);
            curVerb = WalkTo;
            withItem = 0;
            return;
        }
        // The inventory item (if any) travels as the sentence's second object
        // The item rides in sentenceItem, not the sentence itself: the engine
        // drops any sentence whose two objects have the same number, and
        // inventory items are verbs, numbered separately from room objects
        // (the screwdriver's number is the bathroom mirror's).
        sentenceItem = withItem;
        doSentence(curVerb, obj, 0, 0);
    }

    // The engine runs this for every doSentence(): walk over, then let the
    // object's own verb code handle it, or fall back to a stock reply.
    script sentenceHandler(int vrb, int objA, int unused) {
        int objB;
        objB = sentenceItem;
        sentenceItem = 0;
        walkActorToObj(VAR_EGO, objA, 0);
        waitForActor(VAR_EGO);
        if(getObjectVerbEntrypoint(objA, vrb))
            startObject(2, objA, vrb, [ vrb, objA, objB ]);
        else
            defaultAction(vrb, objB);
        curVerb = WalkTo;
        withItem = 0;
    }

    script defaultAction(int vrb, int item) {
        int r;
        r = getRandomNumber(1);
        if(item) {
            egoSay("That doesn't work.");
            return;
        }
        switch(vrb) {
        case LookAt:
            if(r) egoSay("Nothing special about it.");
            else egoSay("Looks like hotel furniture. Hotel-ish.");
            break;
        case PickUp:
            egoSay("I can't pick that up.");
            break;
        case Open:
            egoSay("It doesn't open.");
            break;
        case Close:
            egoSay("It doesn't close.");
            break;
        case Push:
        case Pull:
            if(r) egoSay("It won't budge.");
            else egoSay("I'd rather not rearrange the furniture.");
            break;
        case TalkTo:
            egoSay("It's not much of a conversationalist.");
            break;
        case Use:
            egoSay("I don't see how to use that.");
            break;
        default:
            egoSay("Hmm.");
        }
    }

    // ------------------------------------------------------------ inventory
    script inventoryClick(int item) {
        if(curVerb == Use && !withItem) {
            // Worn uniform: Use takes it off. Otherwise it goes into
            // "Use uniform with..." like any item: the coffee table to set it
            // down, yourself (or the uniform again) to put it on.
            if(item == invUniform && wearingUniform) {
                wearUniform(0);
                curVerb = WalkTo;
                return;
            }
            // Wait for the object to use it with
            withItem = item;
            return;
        }
        // Clicking the same item again uses it on yourself
        if(withItem && item == withItem) {
            useOnSelf(item);
            withItem = 0;
            curVerb = WalkTo;
            return;
        }
        if(withItem) {
            if(isAnyOf(withItem, [ invPowder, invMirror ]) && isAnyOf(item, [ invPowder, invMirror ]))
                egoSay("Not in my hands. I'd lose half of it. The mirror needs to lie flat.");
            else if(isAnyOf(withItem, [ invPowder, invShaver ]) && isAnyOf(item, [ invPowder, invShaver ]))
                egoSay("I need to pour it out on something flat first.");
            else
                egoSay("Combining those won't help.");
            withItem = 0;
            curVerb = WalkTo;
            return;
        }

        switch(item) {
        case invMatchbook:
            if(curVerb == LookAt || curVerb == Open)
                readMatchbook();
            else
                egoSay("Hotel Paradiso matches. Classy.");
            break;
        case invScrewdriver:
            if(curVerb == LookAt)
                egoSay("A screwdriver with a red handle. Why did I lock this in the safe?");
            else
                egoSay("It undoes screws. Use it on something with screws in it.");
            break;
        case invPowder:
            if(curVerb == LookAt) {
                egoSay("A little bag of white powder."); waitForMessage();
                egoSay("Party supplies. Past me thought of everything.");
            } else if(curVerb == Open)
                egoSay("Not here. I need a nice flat surface first.");
            else
                egoSay("I need to pour it out on something flat first.");
            break;
        case invWallet:
            if(curVerb == LookAt)
                egoSay("My wallet. It feels suspiciously light.");
            else if(curVerb == Open || curVerb == Use || curVerb == PickUp)
                openWallet();
            else
                egoSay("It's my wallet. I could open it.");
            break;
        case invDollar:
            if(curVerb == LookAt)
                egoSay("One dollar. My entire remaining budget. Crisp, though.");
            else
                egoSay("Crisp enough to roll up tight.");
            break;
        case invMirror:
            if(curVerb == LookAt)
                egoSay("The mirror door off the medicine cabinet. Nice and flat.");
            else
                egoSay("It needs to lie flat somewhere. The coffee table, maybe.");
            break;
        case invUniform:
            if(curVerb == LookAt && wearingUniform)
                egoSay("Red, gold buttons, a little hat. I look extremely official.");
            else if(curVerb == LookAt)
                egoSay("A bellhop uniform. Not mine. Probably.");
            else if(curVerb == Open || curVerb == PickUp)
                egoSay("I could put it on. Use it, I mean.");
            else
                egoSay("It's a uniform. It doesn't do much on its own.");
            break;
        case invCandy:
            if(curVerb == LookAt)
                egoSay("A Paradiso Bar. Fourteen dollars of nougat.");
            else
                egoSay("I could eat it. Use it, I mean. I'm starving.");
            break;
        case invTowel:
            if(curVerb == LookAt)
                egoSay("A fluffy hotel towel. Embroidered: PROPERTY OF HOTEL PARADISO.");
            else
                egoSay("I could dry off with it. Use it, I mean.");
            break;
        case invShaver:
            if(curVerb == LookAt)
                egoSay("A razor with extra blades.");
            else if(curVerb == Open)
                egoSay("A razor, a pack of spare blades and a tiny tube of shaving cream.");
            else
                egoSay("I could have a shave. Use it, I mean.");
            break;
        case invSoap:
            if(curVerb == LookAt)
                egoSay("A tiny bar of hotel soap. Smells like a meadow that's trying too hard.");
            else
                egoSay("It works better with water.");
            break;
        }
        curVerb = WalkTo;
    }

    // Swap the player's sprite set. Both costumes define the same
    // animations, so the actor keeps walking and talking as before.
    script wearUniform(int on) {
        wearingUniform = on;
        setCurrentActor(VAR_EGO);
        if(on) {
            setActorCostume(bellhopCost);
            egoSay("There. Very official."); waitForMessage();
        } else {
            setActorCostume(guestCost);
            egoSay("Back to the bathrobe. Much breezier."); waitForMessage();
        }
    }

    // "Use <item> with me": eat the candy, put on the uniform
    script useOnSelf(int item) {
        if(item == invUniform)
            wearUniform(1);
        else if(item == invCandy) {
            hasCandy = 0;
            ateCandy = 1;
            refreshInventory();
            egoSay("I wolf it down in three bites."); waitForMessage();
            egoSay("Mmm. Nougat and regret. That's going on the bill.");
        } else if(item == invPowder)
            egoSay("Straight from the bag? I'm not an animal. I need a mirror and a flat surface.");
        else if(item == invScrewdriver)
            egoSay("I'm not that loose.");
        else if(item == invWallet)
            openWallet();
        else if(item == invDollar)
            egoSay("I tuck it behind my ear. Very bellhop.");
        else if(item == invMirror) {
            if(wearingUniform) egoSay("Dashing. Truly a bellhop among bellhops.");
            else egoSay("I look like I slept in a hotel. Which I did.");
        } else if(item == invTowel)
            egoSay("I pat my face dry. Refreshing, in a hotel sort of way.");
        else if(item == invSoap)
            egoSay("I'd need some water for that. There's a sink in the bathroom.");
        else if(item == invShaver)
            egoSay("I give myself a quick dry shave. Ow. But smooth.");
        else
            egoSay("I'd rather keep it in my pocket.");
    }

    // The wallet only holds the dollar bill. Taking it out leaves the wallet
    // in my pocket, so the inventory shows one or the other.
    script openWallet() {
        hasWallet = 0;
        hasDollar = 1;
        refreshInventory();
        egoSay("Inside: one dollar bill. And a receipt for a fourteen-dollar candy bar."); waitForMessage();
        egoSay("I'll keep the dollar handy and the wallet in my pocket.");
    }

    script readMatchbook() {
        if(lampOn) {
            egoSay("Inside the cover, in my handwriting: SAFE 7 1 4."); waitForMessage();
            egoSay("Same as the room number. Past me was not a security genius.");
            knowsCode = 1;
        } else
            egoSay("Something's scribbled inside, but it's too dark to read.");
    }

    // ------------------------------------------------------------ boot
    // The first script the engine runs. No room is loaded yet.
    script main(int bootParam) {
        VAR_MAINMENU_KEY = 319;      // F5
        VAR_TALKSTOP_KEY = 46;       // '.' skips a line
        VAR_PAUSE_KEY = ' ';
        VAR_CUTSCENEEXIT_KEY = 27;   // Esc
        VAR_TIMER_NEXT = 2;

        VAR_VERB_SCRIPT = inputHandler;
        VAR_SENTENCE_SCRIPT = sentenceHandler;

        loadRoom(ResRoom);
        lockRoom(ResRoom);
        loadCostume(guestCost);
        lockCostume(guestCost);
        loadCostume(bellhopCost);
        lockCostume(bellhopCost);

        // The room picture is 144 lines tall; the verb bar gets the rest
        setScreen(0, 144);
        initCharset(font);
        // charset colours: 0 transparent, 1 text, 2 drop shadow
        setCharsetColors([ 0, C_WHITE, C_BLACK ]);

        setCurrentActor(guest);
        initActor();
        setActorCostume(guestCost);
        setActorWalkFrame(guest_anim_walk);
        setActorStandFrame(guest_anim_stand);
        setActorInitFrame(guest_anim_init);
        setActorTalkFrame(guest_anim_talkStart, guest_anim_talkStop);
        setActorTalkColor(C_WHITE);
        setActorTalkPos(0, -64);
        setActorWidth(24);
        setActorName("me");
        VAR_EGO = guest;

        // Talk text floats centred over the speaker. Center clears the
        // overhead flag, so it must come first.
        egoPrintBegin();
        actorPrintCenter();
        actorPrintOverhead();
        actorPrintEnd();

        curVerb = WalkTo;
        setupVerbs();
        mouseWatch();

        titleMode = 1;
        showGameVerbs(0);
        startRoom(Title);
    }
}
