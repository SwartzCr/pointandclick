// Hotel Paradiso: Sacra Pasta -- global script
//
// Everything lives here: the verb interface (drawn into one overlay below the
// room), the conversation picker, and the puzzles of both rooms. Room
// objects and hotspots are addressed by the index constants in _Things.ash,
// which tools/build.py generates from the room descriptions.

// ======================================================================
// state
// ======================================================================

// interface
String verbName[10];
int curVerb;                 // verb picked in the grid (V_NONE: default action)
InventoryItem* selItem;      // "Use <selItem> with ..."
int hovType;                 // T_* under the cursor
int hovIdx;
int hovVerb;                 // verb button under the cursor
int hovOpt;                  // menu / conversation line under the cursor
DynamicSprite* uiSpr;
Overlay* uiOv;
bool uiDirty;
bool titleMode;
bool inChoice;
String optText[6];
int optCount;
int invItems[12];            // inventory ids shown in the grid, in order
int invCount;

// the guest
bool wearBeads;
bool wearUV;

// the Nave
bool met;
bool knowWord;
bool saidWord;
bool gaveOffering;
bool ordained;
bool beadsTaken;
bool pamphletTaken;
int drum[4];
int tileStep;                // how many timeline tiles are lit (4 = solved)
int tileMask;                // which tiles are lit, one bit each
bool tileWrong;              // a tile was pressed out of order this round
bool pendantTaken;
int boxStep;
bool boxOpen;
bool rigTaken;
bool backFromHotel;           // just logged off HOTEL.EXE
int tvChannel;
bool hotelLamp;
bool hotelCurtains;
bool hotelMinibar;
bool stringTaken;            // the thread pulled out of the tapestry
bool whipFound;              // the tiny folk dug up a whip-it for their god
bool knowCombo;              // Khuc has read out the box's riddle
bool boxWarned;
int forkFrame;
int forkTimer;
bool phoneHeard;
int phoneStory;              // which audio story the handset plays next
bool heardRecipe;
bool heardProphecy;
int pumpR;                   // pumps of each sauce in the bowl
int pumpG;
int pumpY;
int dipR;                    // the mix the rigatone was dipped in
int dipG;
int dipY;
int miracle;                 // signs shown to the tiny folk, in order (0..3)

// the Crypt
bool cryptVisited;
int recess[4];                 // the shape in each Pasta Identification recess (-1 = empty)
bool compOpen;               // the board's brass plate has opened
bool crankTaken;
bool crankFitted;            // the crank is on the Pope Seat
bool trackballWon;           // Meatball Madness beaten
bool rexWon;                 // Chuk's T. Rex high score beaten
bool powered;                // Chuk has plugged the computer in
bool khucAtCrank;
int sins;
bool confessed[5];
bool absolved;
bool tokenTaken;
bool boothOpened;            // the CONFESS booth, opened the first time you play
bool curtainOpen;
bool hatDown;
bool endingMode;
int endingKind;              // 1 room service, 2 free play, 3 party
bool wasIdle;

// walk target for objects and characters (set by ThingWalk)
int wx;
int wy;

int C(int r, int g, int b)
{
  return Game.GetColorFromRGB(r, g, b);
}

// ======================================================================
// sounds
// ======================================================================
void Sfx(AudioClip* clip)
{
  if (clip != null) clip.Play(eAudioPriorityNormal, eOnce);
}

void SfxVol(AudioClip* clip, int vol)
{
  if (clip == null) return;
  AudioChannel* ch = clip.Play(eAudioPriorityNormal, eOnce);
  if (ch != null) ch.Volume = vol;
}

// ======================================================================
// the interface
// ======================================================================
#define VERB_X0 12
#define VERB_W 96
#define VERB_Y0 24
#define VERB_H 27
#define INV_X0 316
#define INV_Y0 22
#define INV_W 78
#define INV_H 44

int VerbAt(int x, int y)
{
  if (y < UI_Y + VERB_Y0 || y >= UI_Y + VERB_Y0 + 3 * VERB_H) return 0;
  if (x < VERB_X0 || x >= VERB_X0 + 3 * VERB_W) return 0;
  int col = (x - VERB_X0) / VERB_W;
  int row = (y - UI_Y - VERB_Y0) / VERB_H;
  return row * 3 + col + 1;
}

int SlotAt(int x, int y)
{
  if (y < UI_Y + INV_Y0 || y >= UI_Y + INV_Y0 + 2 * INV_H) return -1;
  if (x < INV_X0 || x >= INV_X0 + 4 * INV_W) return -1;
  return ((y - UI_Y - INV_Y0) / INV_H) * 4 + (x - INV_X0) / INV_W;
}

void RefreshInventory()
{
  invCount = 0;
  int i = 1;
  while (i <= Game.InventoryItemCount && invCount < 8) {
    if (player.InventoryQuantity[i] > 0) {
      invItems[invCount] = i;
      invCount++;
    }
    i++;
  }
  uiDirty = true;
}

String ThingName(int t, int i)
{
  if (t == T_HOT) return hotspot[i].Name;
  if (t == T_OBJ) return object[i].Name;
  if (t == T_CHAR) return character[i].Name;
  if (t == T_INV) return inventory[i].Name;
  return "";
}

int DefaultVerb(int t, int i)
{
  int r = player.Room;
  if (t == T_CHAR && i == player.ID) return V_LOOK;
  if (t == T_CHAR) return V_TALK;
  if (t == T_INV) return V_USE;
  if (r == R_NAVE) {
    if (t == T_OBJ) {
      if (i == O_NAVE_TAPESTRY) {
        if (stringTaken) return V_LOOK;
        return V_PULL;
      }
      if (i == O_NAVE_BEADS || i == O_NAVE_PAMPHLET || i == O_NAVE_PENDANT || i == O_NAVE_RIGATONE) return V_PICKUP;
      if (i == O_NAVE_BOX) return V_OPEN;
      if (i == O_NAVE_ARCHPANEL || i == O_NAVE_FORK) return V_LOOK;
      return V_PUSH;          // drums, tiles, buttons
    }
    if (i == H_NAVE_ARCH) return V_WALK;
    if (i == H_NAVE_DOOR) return V_OPEN;
    if (i == H_NAVE_SAUCE || i == H_NAVE_HANDSET || i == H_NAVE_SODTABLE || i == H_NAVE_SPINNER) return V_USE;
    if (i == H_NAVE_REDSAUCE || i == H_NAVE_GREENSAUCE || i == H_NAVE_YELLOWSAUCE) return V_PUSH;
    return V_LOOK;
  }
  if (r == R_CRYPT) {
    if (t == T_OBJ) {
      if (i == O_CRYPT_TOKEN) return V_PICKUP;
      if (i == O_CRYPT_CURTAIN) return V_OPEN;
      if (i == O_CRYPT_SEAT) return V_USE;
      if (i == O_CRYPT_HAT) return V_LOOK;
      if (i == O_CRYPT_CRANK || (i == O_CRYPT_COMPARTMENT && compOpen && !crankTaken)) return V_PICKUP;
      if (i >= O_CRYPT_SLOT1 && i <= O_CRYPT_SLOT4) return V_PICKUP;
      return V_LOOK;
    }
    if (i == H_CRYPT_ARCH) return V_WALK;
    if (i == H_CRYPT_3BUTTON || i == H_CRYPT_TRACKBALL || i == H_CRYPT_COMPUTER || i == H_CRYPT_REX) return V_USE;
    if (i == H_CRYPT_STAFF) return V_OPEN;
    return V_LOOK;
  }
  if (r == R_HOTEL) {
    if (t == T_OBJ) return V_PICKUP;
    if (i == H_HOTEL_LOGOFF) return V_USE;
    if (i == H_HOTEL_PHONE || i == H_HOTEL_TV) return V_USE;
    return V_LOOK;
  }
  return V_LOOK;
}

String Sentence()
{
  if (titleMode || inChoice) return "";
  String target = ThingName(hovType, hovIdx);
  if (curVerb == V_USE && selItem != null) {
    if (hovType != T_NONE && !(hovType == T_INV && hovIdx == selItem.ID))
      return String.Format("Use %s with %s", selItem.Name, target);
    return String.Format("Use %s with", selItem.Name);
  }
  if ((curVerb == V_PICKUP || curVerb == V_PULL) && hovType == T_CHAR && hovIdx == player.ID) {
    if (wearBeads && wearUV) return "Take off something";
    if (wearBeads) return "Take off pasta rosary beads";
    if (wearUV) return "Take off UV pendant";
  }
  if (curVerb != V_NONE) {
    if (hovType == T_NONE) return verbName[curVerb];
    return String.Format("%s %s", verbName[curVerb], target);
  }
  if (hovType == T_INV) return target;
  if (hovType == T_NONE) return "Walk to";
  return String.Format("%s %s", verbName[DefaultVerb(hovType, hovIdx)], target);
}

void DrawUI()
{
  DrawingSurface* ds = uiSpr.GetDrawingSurface();
  ds.Clear(C(8, 6, 12));
  ds.DrawingColor = C(60, 34, 44);
  ds.DrawLine(0, 0, 639, 0);
  String s = Sentence();
  ds.DrawingColor = C(140, 230, 230);
  ds.DrawString((640 - GetTextWidth(s, eFont0)) / 2, 3, eFont0, s);

  if (titleMode) {
    int k = 0;
    while (k < 2) {
      String t = "New game";
      if (k == 1) t = "Quit";
      if (hovOpt == k) ds.DrawingColor = C(255, 230, 120);
      else ds.DrawingColor = C(200, 150, 90);
      ds.DrawString((640 - GetTextWidth(t, eFont0)) / 2, 36 + k * 26, eFont0, t);
      k++;
    }
  } else if (inChoice) {
    int k = 0;
    while (k < optCount) {
      if (hovOpt == k) ds.DrawingColor = C(255, 240, 140);
      else ds.DrawingColor = C(130, 210, 210);
      ds.DrawString(16, 22 + k * 17, eFont0, optText[k]);
      k++;
    }
  } else {
    // verbs
    int defv = 0;
    if (curVerb == V_NONE && hovType != T_NONE && hovType != T_INV) defv = DefaultVerb(hovType, hovIdx);
    int v = 1;
    while (v <= 9) {
      int col = (v - 1) % 3;
      int row = (v - 1) / 3;
      int x = VERB_X0 + col * VERB_W;
      int y = VERB_Y0 + row * VERB_H;
      if (v == curVerb) ds.DrawingColor = C(255, 255, 255);
      else if (v == hovVerb) ds.DrawingColor = C(170, 250, 250);
      else if (v == defv) ds.DrawingColor = C(150, 240, 240);
      else ds.DrawingColor = C(40, 150, 150);
      ds.DrawString(x + 6, y + 5, eFont0, verbName[v]);
      v++;
    }
    // inventory
    int n = 0;
    while (n < 8) {
      int x = INV_X0 + (n % 4) * INV_W;
      int y = INV_Y0 + (n / 4) * INV_H;
      ds.DrawingColor = C(26, 20, 32);
      ds.DrawRectangle(x + 2, y + 1, x + INV_W - 3, y + INV_H - 2);
      if (n < invCount) {
        InventoryItem* it = inventory[invItems[n]];
        if (selItem == it) {
          ds.DrawingColor = C(90, 60, 30);
          ds.DrawRectangle(x + 2, y + 1, x + INV_W - 3, y + INV_H - 2);
        } else if (hovType == T_INV && hovIdx == it.ID) {
          ds.DrawingColor = C(46, 40, 60);
          ds.DrawRectangle(x + 2, y + 1, x + INV_W - 3, y + INV_H - 2);
        }
        ds.DrawImage(x + (INV_W - 48) / 2, y + 2, it.Graphic);
      }
      n++;
    }
  }
  // a nearly-black status dot in the corner, for the automated playtest:
  // blue ~40 = waiting for a click, ~64 = picking an option, ~88 = busy
  // (AGS colour numbers below 32 are palette entries, hence the bit of green)
  if (inChoice) ds.DrawingColor = C(0, 4, 64);
  else if (IsInterfaceEnabled()) ds.DrawingColor = C(0, 4, 40);
  else ds.DrawingColor = C(0, 4, 88);
  ds.DrawPixel(639, 111);
  ds.Release();
  // overlays don't survive a room change, so make a new one when needed
  if (uiOv == null || !uiOv.Valid) uiOv = Overlay.CreateGraphical(0, UI_Y, uiSpr.Graphic, false);
  else uiOv.Graphic = uiSpr.Graphic;
  uiDirty = false;
}

void ResetVerb()
{
  curVerb = V_NONE;
  selItem = null;
  uiDirty = true;
}

void UpdateHover()
{
  int x = mouse.x;
  int y = mouse.y;
  int nt = T_NONE;
  int ni = 0;
  int nv = 0;
  int no = -1;
  if (y >= UI_Y) {
    if (titleMode) {
      if (y >= UI_Y + 32 && y < UI_Y + 32 + 52) no = (y - UI_Y - 32) / 26;
    } else if (inChoice) {
      if (y >= UI_Y + 20) {
        no = (y - UI_Y - 20) / 17;
        if (no >= optCount) no = -1;
      }
    } else {
      nv = VerbAt(x, y);
      int slot = SlotAt(x, y);
      if (slot >= 0 && slot < invCount) {
        nt = T_INV;
        ni = invItems[slot];
      }
    }
  } else if (!titleMode && !inChoice && IsInterfaceEnabled()) {
    // the guest is clickable (to wear things), but only wins over what's
    // behind him when an item is in hand; otherwise look through him
    int lt = GetLocationType(x, y);
    bool selfHere = (lt == eLocationCharacter && Character.GetAtScreenXY(x, y) == player);
    // with an item in hand (or taking something off) the guest wins over bare
    // wall and floor behind him, but not over the things he could use it on
    bool selfVerb = (curVerb == V_USE && selItem != null) ||
                    ((curVerb == V_PICKUP || curVerb == V_PULL) && (wearBeads || wearUV));
    player.Clickable = false;
    lt = GetLocationType(x, y);
    bool bare = (lt == eLocationNothing);
    if (lt == eLocationHotspot && player.Room == R_NAVE) {
      Hotspot* hb = Hotspot.GetAtScreenXY(x, y);
      if (hb != null && hb.ID == H_NAVE_WALLPAPER) bare = true;
    }
    bool holding = (curVerb == V_USE && selItem != null);
    if (selfHere && (lt == eLocationNothing || holding || (selfVerb && bare))) {
      nt = T_CHAR;
      ni = player.ID;
    } else if (lt == eLocationCharacter) {
      Character* c = Character.GetAtScreenXY(x, y);
      if (c != null && (c == player || c.Clickable)) {
        nt = T_CHAR;
        ni = c.ID;
      }
    } else if (lt == eLocationObject) {
      Object* o = Object.GetAtScreenXY(x, y);
      if (o != null) {
        nt = T_OBJ;
        ni = o.ID;
      }
    } else if (lt == eLocationHotspot) {
      Hotspot* h = Hotspot.GetAtScreenXY(x, y);
      if (h != null && h.ID > 0) {
        nt = T_HOT;
        ni = h.ID;
      }
    }
    player.Clickable = true;
  }
  if (nt != hovType || ni != hovIdx || nv != hovVerb || no != hovOpt) {
    hovType = nt;
    hovIdx = ni;
    hovVerb = nv;
    hovOpt = no;
    uiDirty = true;
  }
}

// ======================================================================
// conversation picker, notes and narration
// ======================================================================
int Choose(String a, String b, String c, String d, String e)
{
  // returns 1..5: which of the given (non-null) options was clicked
  int map[];
  map = new int[6];
  optCount = 0;
  if (a != null) { optText[optCount] = a; map[optCount] = 1; optCount++; }
  if (b != null) { optText[optCount] = b; map[optCount] = 2; optCount++; }
  if (c != null) { optText[optCount] = c; map[optCount] = 3; optCount++; }
  if (d != null) { optText[optCount] = d; map[optCount] = 4; optCount++; }
  if (e != null) { optText[optCount] = e; map[optCount] = 5; optCount++; }
  inChoice = true;
  hovType = T_NONE;
  hovOpt = -1;
  uiDirty = true;
  DrawUI();
  int picked = -1;
  // let go of the click that brought us here
  while (Mouse.IsButtonDown(eMouseLeft)) Wait(1);
  while (picked < 0) {
    Wait(1);
    UpdateHover();
    if (uiDirty) DrawUI();
    if (Mouse.IsButtonDown(eMouseLeft) && hovOpt >= 0) {
      picked = hovOpt;
      while (Mouse.IsButtonDown(eMouseLeft)) Wait(1);
    }
  }
  inChoice = false;
  hovOpt = -1;
  uiDirty = true;
  DrawUI();
  return map[picked];
}

void Narrate(int x, int y, int color, String text)
{
  cVoice.SpeechColor = color;
  cVoice.SayAt(x, y, 360, text);
}

void ShowNote(String title, String body, int style)
{
  // style 0: printed paper, 1: green-screen computer, 2: arcade screen
  DynamicSprite* page = DynamicSprite.Create(520, 252, false);
  DrawingSurface* ds = page.GetDrawingSurface();
  int bg = C(246, 236, 210);
  int ink = C(50, 36, 30);
  int head = C(160, 40, 40);
  FontType f = eFont2;
  if (style == 1) { bg = C(14, 20, 16); ink = C(110, 240, 130); head = C(170, 255, 180); f = eFont3; }
  if (style == 2) { bg = C(20, 10, 40); ink = C(250, 210, 255); head = C(255, 230, 90); f = eFont0; }
  int bodyY = 42;
  ds.Clear(C(40, 26, 20));
  ds.DrawingColor = bg;
  if (style == 3) ds.DrawingColor = C(232, 226, 206);       // newsprint
  ds.DrawRectangle(4, 4, 515, 247);
  if (style == 3) {
    // a masthead between double rules, then the story in a serif face
    ds.DrawingColor = C(24, 20, 20);
    ds.DrawStringWrapped(20, 12, 480, eFont4, eAlignCenter, title);
    ds.DrawLine(20, 42, 499, 42);
    ds.DrawLine(20, 45, 499, 45);
    ds.DrawStringWrapped(20, 47, 480, eFont5, eAlignCenter, "Late Edition  -  Hotel Paradiso  -  Free to Guests");
    ds.DrawLine(20, 62, 499, 62);
    ink = C(28, 24, 24);
    f = eFont5;
    bodyY = 70;
  } else {
    ds.DrawingColor = head;
    ds.DrawStringWrapped(20, 16, 480, eFont0, eAlignCenter, title);
  }
  ds.DrawingColor = ink;
  ds.DrawStringWrapped(24, bodyY, 472, f, eAlignLeft, body);
  ds.DrawingColor = C(150, 130, 110);
  if (style == 1) ds.DrawingColor = C(60, 140, 70);
  ds.DrawStringWrapped(20, 230, 480, eFont2, eAlignRight, "(click to close)");
  ds.Release();
  Overlay* ov = Overlay.CreateGraphical(60, 18, page.Graphic, true);
  while (Mouse.IsButtonDown(eMouseLeft)) Wait(1);
  WaitMouseKey(-1);
  while (Mouse.IsButtonDown(eMouseLeft)) Wait(1);
  ov.Remove();
  page.Delete();
}

// ======================================================================
// the guest's outfit and the UV light
// ======================================================================
void UpdateOutfit()
{
  if (wearBeads && wearUV) { cGuest.ChangeView(VGUESTBU); cGuest.SpeechView = VGTALKBU; }
  else if (wearBeads) { player.ChangeView(VGUESTB); player.SpeechView = VGTALKB; }
  else if (wearUV) { player.ChangeView(VGUESTU); player.SpeechView = VGTALKU; }
  else { player.ChangeView(VGUEST); player.SpeechView = VGTALK; }
}

void ApplyUV()
{
  int r = player.Room;
  if (r != R_NAVE && r != R_CRYPT) return;
  if (wearUV) SetBackgroundFrame(1);
  else SetBackgroundFrame(0);
  int i = 0;
  while (i < Room.ObjectCount) {
    bool special = false;
    if (r == R_NAVE) {
      if (i == O_NAVE_DRUM1 || i == O_NAVE_DRUM2 || i == O_NAVE_DRUM3 || i == O_NAVE_DRUM4) special = true;
      if (i == O_NAVE_BOX || i == O_NAVE_BTN1 || i == O_NAVE_BTN2 || i == O_NAVE_BTN3) special = true;
      if (i == O_NAVE_ARCHPANEL || i == O_NAVE_RUINS || i == O_NAVE_TAPESTRY || i == O_NAVE_DRAWER || i == O_NAVE_SCALES) special = true;
    }
    if (special || !wearUV) object[i].RemoveTint();
    else object[i].Tint(110, 60, 220, 90, 35);
    i++;
  }
  if (wearUV) {
    player.Tint(110, 60, 220, 80, 45);
    cKhuc.Tint(110, 60, 220, 80, 45);
  } else {
    player.RemoveTint();
    cKhuc.RemoveTint();
  }
}

// ======================================================================
// room set-up from the state variables (called whenever a room is entered)
// ======================================================================
int DrumSprite(int i)
{
  int base = S_NAVE_DRUM1_W0;
  if (i == 1) base = S_NAVE_DRUM2_W0;
  if (i == 2) base = S_NAVE_DRUM3_W0;
  if (i == 3) base = S_NAVE_DRUM4_W0;
  // sprites per drum: w0 u0 w1 u1 w2 u2 w3 u3
  int s = base + drum[i] * 2;
  if (wearUV) s++;
  return s;
}

String DrumWord(int d)
{
  int k = drum[d];
  if (d == 0) {
    if (k == 0) return "THE";
    if (k == 1) return "ALL";
    if (k == 2) return "NO";
    return "SOME";
  }
  if (d == 1) {
    if (k == 0) return "FORKS";
    if (k == 1) return "SAUCE";
    if (k == 2) return "PASTA";
    return "BREAD";
  }
  if (d == 2) {
    if (k == 0) return "IS";
    if (k == 1) return "SEEM";
    if (k == 2) return "LOOK";
    return "FEEL";
  }
  if (k == 0) return "SOGGY";
  if (k == 1) return "HOLY";
  if (k == 2) return "BLAND";
  return "RAW";
}

int TileRank(int i)
{
  // chronological rank of the tile in slot i: noodles, fork, string, counting
  if (i == 0) return 2;
  if (i == 1) return 3;
  if (i == 2) return 0;
  return 1;
}

int ButtonRank(int i)
{
  // press order of the buttons: penne 2nd, farfalle 3rd, shell 1st
  if (i == 0) return 1;
  if (i == 1) return 2;
  return 0;
}

void SetupNave()
{
  int i = 0;
  object[O_NAVE_ARCHPANEL].Visible = !ordained;
  object[O_NAVE_ARCHPANEL].Transparency = 0;
  if (wearUV) object[O_NAVE_ARCHPANEL].Graphic = S_NAVE_ARCHPANEL_UV;
  else object[O_NAVE_ARCHPANEL].Graphic = S_NAVE_ARCHPANEL_CLOSED;
  // pieces with their own ultraviolet pictures (a tint wouldn't match the room's UV look)
  if (stringTaken && wearUV) object[O_NAVE_TAPESTRY].Graphic = S_NAVE_TAPESTRY_UVRUINED;
  else if (stringTaken) object[O_NAVE_TAPESTRY].Graphic = S_NAVE_TAPESTRY_RUINED;
  else if (wearUV) object[O_NAVE_TAPESTRY].Graphic = S_NAVE_TAPESTRY_UVCLOSED;
  else object[O_NAVE_TAPESTRY].Graphic = S_NAVE_TAPESTRY_CLOSED;
  if (wearUV) { object[O_NAVE_DRAWER].Graphic = S_NAVE_DRAWER_UV; object[O_NAVE_SCALES].Graphic = S_NAVE_SCALES_UV; }
  else { object[O_NAVE_DRAWER].Graphic = S_NAVE_DRAWER_OPEN; object[O_NAVE_SCALES].Graphic = S_NAVE_SCALES_EMPTY; }
  object[O_NAVE_BEADS].Visible = false;   // the beads are made, not found
  object[O_NAVE_RUINS].Visible = whipFound;   // the village after the dig
  object[O_NAVE_SCALES].Visible = beadsTaken; // its macaroni is on the string now
  if (wearUV) object[O_NAVE_RUINS].Graphic = S_NAVE_RUINS_UV;
  else object[O_NAVE_RUINS].Graphic = S_NAVE_RUINS_ON;
  object[O_NAVE_PAMPHLET].Visible = !pamphletTaken;
  while (i < 4) {
    object[O_NAVE_DRUM1 + i].Graphic = DrumSprite(i);
    int tileObj = O_NAVE_TILE1 + i;
    if ((tileMask & (1 << i)) != 0) object[tileObj].Graphic = S_NAVE_TILE1_ON + i * 2;
    else object[tileObj].Graphic = S_NAVE_TILE1_OFF + i * 2;
    i++;
  }
  object[O_NAVE_DRAWER].Visible = (tileStep >= 4);
  object[O_NAVE_PENDANT].Visible = (tileStep >= 4) && !pendantTaken;
  if (boxOpen) {
    if (wearUV) object[O_NAVE_BOX].Graphic = S_NAVE_BOX_UVOPEN;
    else object[O_NAVE_BOX].Graphic = S_NAVE_BOX_OPEN;
  } else {
    if (wearUV) object[O_NAVE_BOX].Graphic = S_NAVE_BOX_UVCLOSED;
    else object[O_NAVE_BOX].Graphic = S_NAVE_BOX_CLOSED;
  }
  i = 0;
  while (i < 3) {
    int b = O_NAVE_BTN1 + i;
    object[b].Visible = !boxOpen;
    // sprites per button: up down uv
    if (wearUV) object[b].Graphic = S_NAVE_BTN1_UP + i * 3 + 2;
    else if (ButtonRank(i) < boxStep) object[b].Graphic = S_NAVE_BTN1_UP + i * 3 + 1;
    else object[b].Graphic = S_NAVE_BTN1_UP + i * 3;
    i++;
  }
  object[O_NAVE_RIGATONE].Visible = boxOpen && !rigTaken;
  object[O_NAVE_FORK].Graphic = S_NAVE_FORK_F0 + forkFrame;
  ApplyUV();
}

void SetupCrypt()
{
  int i = 0;
  while (i < 4) {
    // sprites per recess: empty trefoil infinity mobius torus
    object[O_CRYPT_SLOT1 + i].Graphic = S_CRYPT_SLOT1_EMPTY + i * 5 + recess[i] + 1;
    i++;
  }
  if (compOpen) object[O_CRYPT_COMPARTMENT].Graphic = S_CRYPT_COMPARTMENT_OPEN;
  else object[O_CRYPT_COMPARTMENT].Graphic = S_CRYPT_COMPARTMENT_SHUT;
  object[O_CRYPT_CRANK].Visible = compOpen && !crankTaken;
  object[O_CRYPT_SCREEN].Visible = powered;     // the room shows it off; this is the screen on
  object[O_CRYPT_TOKEN].Visible = absolved && !tokenTaken;
  if (boothOpened) object[O_CRYPT_BOOTH].Graphic = S_CRYPT_BOOTH_OPEN;
  else object[O_CRYPT_BOOTH].Graphic = S_CRYPT_BOOTH_SHUT;
  if (rexWon) object[O_CRYPT_REXSCREEN].Graphic = S_CRYPT_REXSCREEN_SCORES;
  else if (trackballWon) object[O_CRYPT_REXSCREEN].Graphic = S_CRYPT_REXSCREEN_OFF;
  else object[O_CRYPT_REXSCREEN].Graphic = S_CRYPT_REXSCREEN_PLAY;
  if (trackballWon) object[O_CRYPT_MEATSCREEN].Graphic = S_CRYPT_MEATSCREEN_GAME;
  else object[O_CRYPT_MEATSCREEN].Graphic = S_CRYPT_MEATSCREEN_COIN;
  if (curtainOpen) object[O_CRYPT_CURTAIN].Graphic = S_CRYPT_CURTAIN_OPEN;
  else object[O_CRYPT_CURTAIN].Graphic = S_CRYPT_CURTAIN_CLOSED;
  if (crankFitted) object[O_CRYPT_SEAT].Graphic = S_CRYPT_SEAT_CRANK;
  else object[O_CRYPT_SEAT].Graphic = S_CRYPT_SEAT_EMPTY;
  object[O_CRYPT_HAT].SetPosition(521, 87);
  object[O_CRYPT_HAT].Visible = true;
  if (cKhuc.Room == R_CRYPT) {
    if (khucAtCrank) {
      cKhuc.UnlockView();
      cKhuc.x = 566;
      cKhuc.y = 266;
      cKhuc.Loop = 1;
    } else if (trackballWon) {
      cKhuc.UnlockView();          // up off the Rex Seat
      if (rexWon) { cKhuc.x = 566; cKhuc.y = 270; cKhuc.Loop = 1; }
      else { cKhuc.x = 324; cKhuc.y = 272; cKhuc.Loop = 1; }
    } else {
      cKhuc.LockView(VKPLAY);
      cKhuc.x = 254;
      cKhuc.y = 254;
      cKhuc.Animate(0, 3, eRepeat, eNoBlock);
    }
  }
  ApplyUV();
}

// ======================================================================
// game state
// ======================================================================
void ResetState()
{
  wearBeads = false; wearUV = false;
  met = false; knowWord = false; saidWord = false; gaveOffering = false; ordained = false;
  beadsTaken = false; pamphletTaken = false;
  drum[0] = 0; drum[1] = 0; drum[2] = 1; drum[3] = 2;
  tileStep = 0; tileMask = 0; tileWrong = false; pendantTaken = false; boxStep = 0; boxOpen = false; rigTaken = false;
  whipFound = false; knowCombo = false; stringTaken = false; boxWarned = false;
  phoneHeard = false;
  phoneStory = 0; heardRecipe = false; heardProphecy = false;
  pumpR = 0; pumpG = 0; pumpY = 0; dipR = 0; dipG = 0; dipY = 0;
  miracle = 0;
  cryptVisited = false;
  recess[0] = -1; recess[1] = -1; recess[2] = -1; recess[3] = -1;
  compOpen = false; crankTaken = false; crankFitted = false;
  trackballWon = false; rexWon = false; powered = false;
  khucAtCrank = false; sins = 0;
  int i = 0;
  while (i < 5) { confessed[i] = false; i++; }
  absolved = false; tokenTaken = false; boothOpened = false; curtainOpen = false; hatDown = false; endingKind = 0;
  cClown1.ChangeRoom(-1); cClown2.ChangeRoom(-1); cClown3.ChangeRoom(-1);
  cKhuc.Transparency = 0;
  i = 1;
  while (i <= Game.InventoryItemCount) {
    if (player.InventoryQuantity[i] > 0) player.LoseInventory(inventory[i]);
    i++;
  }
  cKhuc.UnlockView();
  cKhuc.ChangeRoom(R_NAVE, 540, 262);   // beside the wall he keeps
  cKhuc.Loop = 0;
  player.Transparency = 0;
  UpdateOutfit();
  RefreshInventory();
  ResetVerb();
}

// ======================================================================
// walking up to things
// ======================================================================
void ThingWalk(int t, int i)
{
  wx = -1;
  wy = -1;
  if (t == T_HOT) {
    wx = hotspot[i].WalkToX;
    wy = hotspot[i].WalkToY;
  } else if (t == T_CHAR) {
    Character* c = character[i];
    if (c == cKhuc && player.Room == R_NAVE) { wx = 500; wy = 264; }
    else if (c == cKhuc && khucAtCrank) { wx = 536; wy = 274; }
    else if (c == cKhuc && rexWon) { wx = 536; wy = 274; }
    else if (c == cKhuc && trackballWon) { wx = 356; wy = 272; }
    else if (c == cKhuc) { wx = 312; wy = 270; }
  } else if (t == T_OBJ) {
    int r = player.Room;
    if (r == R_NAVE) {
      if (i == O_NAVE_TAPESTRY || i == O_NAVE_BEADS) { wx = 502; wy = 262; }
      else if (i == O_NAVE_PAMPHLET) { wx = 240; wy = 262; }
      else if (i >= O_NAVE_DRUM1 && i <= O_NAVE_DRUM4) { wx = 453; wy = 262; }
      else if (i == O_NAVE_BOX || i == O_NAVE_RIGATONE || (i >= O_NAVE_BTN1 && i <= O_NAVE_BTN3)) { wx = 110; wy = 268; }
      else if ((i >= O_NAVE_TILE1 && i <= O_NAVE_TILE4) || i == O_NAVE_DRAWER || i == O_NAVE_PENDANT) { wx = 418; wy = 262; }
      else if (i == O_NAVE_ARCHPANEL) { wx = 586; wy = 266; }
      else if (i == O_NAVE_FORK) { wx = 112; wy = 262; }
    } else if (r == R_HOTEL) {
      if (i == O_HOTEL_NEWSPAPER) { wx = 120; wy = 232; }
      else if (i == O_HOTEL_CANDY) { wx = 378; wy = 214; }
    } else if (r == R_CRYPT) {
      if ((i >= O_CRYPT_SLOT1 && i <= O_CRYPT_SLOT4) || i == O_CRYPT_COMPARTMENT || i == O_CRYPT_CRANK) { wx = 338; wy = 250; }
      else if (i == O_CRYPT_TOKEN) { wx = 150; wy = 274; }
      else if (i == O_CRYPT_CURTAIN) { wx = 462; wy = 242; }
      else if (i == O_CRYPT_SEAT || i == O_CRYPT_HAT) { wx = 526; wy = 270; }
    }
  }
  if (wx > 0) player.Walk(wx, wy, eBlock, eWalkableAreas);
}

void FaceThing(int t, int i)
{
  int x = -1;
  int y = -1;
  if (t == T_OBJ) {
    x = object[i].X + Game.SpriteWidth[object[i].Graphic] / 2;
    y = object[i].Y - Game.SpriteHeight[object[i].Graphic] / 2;
  } else if (t == T_CHAR) {
    x = character[i].x;
    y = character[i].y;
  } else if (t == T_HOT) {
    // the walk-to points are all in front of the thing
    x = player.x;
    y = player.y - 30;
    if (player.Room == R_CRYPT && (i == H_CRYPT_3BUTTON)) { x = 0; y = player.y; }
    if (player.Room == R_CRYPT && (i == H_CRYPT_TRACKBALL)) { x = 639; y = player.y; }
  }
  if (x >= 0) player.FaceLocation(x, y, eBlock);
}

// ======================================================================
// stock replies
// ======================================================================
void Stock(int v)
{
  if (v == V_OPEN) player.Say("That doesn't open.");
  else if (v == V_CLOSE) player.Say("That doesn't close.");
  else if (v == V_PICKUP) player.Say("I don't need that.");
  else if (v == V_PUSH) player.Say("Pushing it won't help.");
  else if (v == V_PULL) player.Say("Pulling it won't help.");
  else if (v == V_TALK) player.Say("It's not much of a talker.");
  else if (v == V_USE) player.Say("I can't do anything with that.");
  else if (v == V_LOOK) player.Say("Nothing special.");
}

// ======================================================================
// THE NAVE
// ======================================================================
void CheckWord()
{
  if (drum[0] == 1 && drum[1] == 2 && drum[2] == 0 && drum[3] == 1) {
    Wait(10);
    player.Say("\"ALL PASTA IS HOLY.\"");
    if (!knowWord) {
      knowWord = true;
      if (wearUV) player.Say("Every window is glowing. That has to be the Word.");
      else player.Say("That sounds exactly like something a password would say.");
    }
  }
}

void Ceremony()
{
  ordained = true;
  cKhuc.FaceCharacter(player, eBlock);
  cKhuc.Say("The beads. The Word. The offering, golden and sauced.");
  cKhuc.LockView(VKRAISE);
  cKhuc.Say("By the Noodly Appendage, you are ordained!");
  player.Say("Do I get a certificate?");
  cKhuc.Say("You get a door.");
  cKhuc.UnlockView();
  cKhuc.FaceDirection(eDirectionRight, eBlock);
  Sfx(aStone);
  int t = 0;
  while (t <= 100) {
    object[O_NAVE_ARCHPANEL].Transparency = t;
    Wait(3);
    t += 5;
  }
  object[O_NAVE_ARCHPANEL].Visible = false;
  cKhuc.FaceCharacter(player, eBlock);
  cKhuc.Say("The Crypt is open. Nobody has beaten my T. rex score all night, and I intend to keep it that way.");
  cKhuc.Say("Come find me at the Rex Seat.");
  cKhuc.Walk(586, 266, eBlock, eAnywhere);
  cKhuc.Walk(586, 250, eBlock, eAnywhere);
  cKhuc.ChangeRoom(R_CRYPT, 254, 254);
}

void CheckOrdained()
{
  if (ordained || player.Room != R_NAVE) return;
  if (saidWord && gaveOffering) {
    if (!wearBeads) {
      cKhuc.Say("Word and offering. Now put on the beads, pilgrim.");
      return;
    }
    Ceremony();
  }
}

bool SauceRight()
{
  return dipR == 2 && dipG == 0 && dipY == 1;
}

void KhucOpensBox()
{
  // Chuk walks over to his reliquary, presses its buttons in order and walks back
  knowCombo = true;
  cKhuc.Say("Oh fine, I'll do it myself.");
  cKhuc.Walk(112, 272, eBlock, eAnywhere);
  cKhuc.FaceDirection(eDirectionLeft, eBlock);
  int k = 0;
  while (k < 3) {
    int b = 0;
    while (ButtonRank(b) != k) b++;
    Sfx(aButton);
    if (!wearUV) object[O_NAVE_BTN1 + b].Graphic = S_NAVE_BTN1_UP + b * 3 + 1;
    Wait(18);
    k++;
  }
  Sfx(aBoxOpen);
  boxStep = 3;
  boxOpen = true;
  SetupNave();
  cKhuc.Say("There. Mind the rigatone, it's older than you are.");
  cKhuc.Say("Years I spent on those riddles. Years! And does anyone solve them? No. Everyone just wants the box open.");
  player.Say("Everyone has their price, Chuk. Yours is a whip-it.");
  cKhuc.Walk(540, 262, eBlock, eAnywhere);
  cKhuc.Loop = 0;
}

void GiveWhipit()
{
  player.Say("One whip-it, fresh from the sod.");
  cKhuc.Say("Bless you, pilgrim. The party upstairs ran dry hours ago.");
  player.LoseInventory(iWhipit);
  RefreshInventory();
  if (boxOpen) {
    cKhuc.Say("And my box is open already. Consider this a tip.");
    knowCombo = true;
    return;
  }
  KhucOpensBox();
}

void KhucHint()
{
  // a nudge towards the first thing not yet done
  if (tileStep < 4) {
    if (!pamphletTaken) cKhuc.Say("Start with the pamphlet on the sod table. I wrote it. It's very good.");
    else cKhuc.Say("The Timeline wants its tiles pressed oldest first. The pamphlet knows the order.");
  } else if (!pendantTaken) cKhuc.Say("The Timeline gave you something. Look in its drawer.");
  else if (!wearUV && !knowWord) cKhuc.Say("A pendant does nothing in a pocket. Wear it, and look around.");
  else if (!knowWord) cKhuc.Say("The Word is spun, not spoken. Spin the windows by the pendant's light.");
  else if (!rigTaken && !knowCombo && !whipFound && !heardProphecy) cKhuc.Say("Bring me one whip-it and I'll open my box for you. The tiny folk will dig for anything their god asks. The telephone tells their prophecy.");
  else if (!rigTaken && !knowCombo && !whipFound) cKhuc.Say("Bring me one whip-it and I'll open my box for you. Show the tiny folk their three signs, in order, and they'll dig for you.");
  else if (!rigTaken && !knowCombo) cKhuc.Say("Is that a whip-it? Give it here, and I'll open my box.");
  else if (!rigTaken) cKhuc.Say("The box is open, pilgrim. Take the rigatone.");
  else if (!gaveOffering && !heardRecipe) cKhuc.Say("The telephone tells stories. One of them is a recipe. Keep listening.");
  else if (!gaveOffering) cKhuc.Say("Pump the sauce into the bowl as the First Supper says, then dip the rigatone.");
  else if (!beadsTaken && !stringTaken) cKhuc.Say("Holy beads are made, not found. Start with a string. That old tapestry has a thread hanging loose.");
  else if (!beadsTaken) cKhuc.Say("A string, and some pasta to thread on it. The Scales of Pasta hold plenty.");
  else if (!wearBeads) cKhuc.Say("You have the beads. Wear them.");
  else if (!saidWord) cKhuc.Say("Speak the Word to me.");
  else cKhuc.Say("You are nearly there, pilgrim.");
}

void PlaytestSkip()
{
  // for playtesting: everything in the Nave counts as done, then the ceremony
  int i = 1;
  while (i <= Game.InventoryItemCount) {
    if (player.InventoryQuantity[i] > 0) player.LoseInventory(inventory[i]);
    i++;
  }
  pamphletTaken = true; stringTaken = true; beadsTaken = true; wearBeads = true;
  tileStep = 4; tileMask = 15; pendantTaken = true; knowWord = true; saidWord = true;
  whipFound = true; knowCombo = true; boxOpen = true; rigTaken = true; gaveOffering = true;
  phoneHeard = true; heardRecipe = true; heardProphecy = true; miracle = 3;
  player.AddInventory(iPamphlet);
  player.AddInventory(iPendant);
  RefreshInventory();
  UpdateOutfit();
  SetupNave();
  cKhuc.Say("Very well. Consider yourself beaded, worded and sauced.");
  Ceremony();
}

void TalkKhucNave()
{
  player.FaceCharacter(cKhuc, eBlock);
  cKhuc.FaceCharacter(player, eBlock);
  if (ordained) return;
  bool done = false;
  while (!done) {
    String wordOpt = null;
    if (knowWord && !saidWord) wordOpt = "\"ALL PASTA IS HOLY.\"";
    int c = Choose("Who are you, and what's behind the wall?", "How do I get through?", wordOpt, "I'm stuck.", "See you later.");
    if (c == 1) {
      player.Say("Who are you?");
      cKhuc.Say("I am Chuk, Keeper of the Archway, Brother of the Noodle.");
      cKhuc.Say("The colander is load-bearing. Spiritually.");
      c = 10;
    }
    if (c == 10) {
      player.Say("What's behind the wall?");
      cKhuc.Say("The Crypt. The arcade. The real party.");
      cKhuc.Say("And the Pope Seat, which nobody has sat in all night.");
      player.Say("So it's not really a wall.");
      cKhuc.Say("It is a wall until you are ordained.");
    } else if (c == 2) {
      player.Say("How do I get through?");
      cKhuc.Say("A pilgrim must be ordained. Three things are required.");
      cKhuc.Say("Wear the holy beads. Speak the Word. Bring an offering of golden pasta, properly sauced.");
      if (wearBeads) cKhuc.Say("The beads you already wear. Very fetching.");
      if (saidWord) cKhuc.Say("The Word you have spoken.");
      if (gaveOffering) cKhuc.Say("Your offering is accepted.");
      if (!beadsTaken) {
        player.Say("Where are the beads?");
        cKhuc.Say("Holy beads are made, not found. A string, some pasta, and a little devotion.");
      }
      if (!knowWord) {
        player.Say("And what's the Word?");
        cKhuc.Say("If I told you, it would just be a word.");
      }
    } else if (c == 3) {
      player.Say("ALL PASTA IS HOLY.");
      cKhuc.Say("...");
      cKhuc.Say("The Word is spoken.");
      saidWord = true;
      if (!gaveOffering) cKhuc.Say("Now, the offering.");
      CheckOrdained();
      if (ordained) done = true;
    } else if (c == 4) {
      player.Say("I'm stuck.");
      KhucHint();
      if (Choose("Thanks, I'll keep trying.", "[PLAYTEST] Just let me through to the Crypt.", null, null, null) == 2) {
        PlaytestSkip();
        done = true;
      }
    } else {
      player.Say("See you later.");
      cKhuc.Say("Noodle be with you.");
      done = true;
    }
  }
}

// ---- the Crypt's shapes and crank (used before the Crypt section)
InventoryItem* ShapeItem(int n)
{
  if (n == 0) return iTrefoil;
  if (n == 1) return iInfinity;
  if (n == 2) return iMobius;
  return iTorus;
}

int ItemShape(InventoryItem* it)
{
  if (it == iTrefoil) return 0;
  if (it == iInfinity) return 1;
  if (it == iMobius) return 2;
  if (it == iTorus) return 3;
  return -1;
}

String ShapeName(int n)
{
  if (n == 0) return "the three-lobed knot";
  if (n == 1) return "the figure-eight loop";
  if (n == 2) return "the twisted band";
  return "the stone ring";
}

String SlotPasta(int k)
{
  if (k == 0) return "OTTINI";
  if (k == 1) return "TORTINI";
  if (k == 2) return "ANELLI";
  return "NODINI";
}

int SlotAnswer(int k)
{
  // OTTINI the figure-eight, TORTINI the twisted band, ANELLI the ring, NODINI the knot
  if (k == 0) return 1;
  if (k == 1) return 2;
  if (k == 2) return 3;
  return 0;
}

void FitCrank()
{
  player.LoseInventory(iCrank);
  RefreshInventory();
  cKhuc.Say("The crank! Let me.");
  cKhuc.Walk(566, 266, eBlock, eAnywhere);
  cKhuc.FaceDirection(eDirectionLeft, eBlock);
  Sfx(aCrank);
  crankFitted = true;
  khucAtCrank = true;
  SetupCrypt();
  cKhuc.Say("Fitted. Now sit, your holiness-to-be, and I'll do the cranking.");
}

void GiveKhuc(InventoryItem* it)
{
  player.FaceCharacter(cKhuc, eBlock);
  if (player.Room != R_NAVE) {
    if (it == iCrank) { FitCrank(); return; }
    if (it == iToken && !trackballWon) { cKhuc.Say("Keep it. Tokens are for the meatball cabinet."); return; }
    if (ItemShape(it) >= 0) { cKhuc.Say("Not for me. They go on the board."); return; }
    if (rexWon) cKhuc.Say("Keep it. I've given up being the high score.");
    else cKhuc.Say("Keep it. I'm busy being the high score.");
    return;
  }
  if (it == iSauced && !SauceRight()) {
    player.Say("One golden rigatone. Sauced.");
    cKhuc.Say("Let me taste.");
    if (dipR < 2) cKhuc.Say("Not enough red.");
    else if (dipR > 2) cKhuc.Say("Far too much red.");
    if (dipG > 0) cKhuc.Say("And green? Whose nose was that for?");
    if (dipY == 0) cKhuc.Say("No yellow. The One True Noodle weeps.");
    else if (dipY > 1) cKhuc.Say("So much yellow. One is the number of the One True Noodle.");
    cKhuc.Say("Improperly sauced.");
    Sfx(aSlurp);
    player.Say("He licks it clean and hands it back.");
    cKhuc.Say("Try again, pilgrim.");
    player.LoseInventory(iSauced);
    player.AddInventory(iRigatone);
    RefreshInventory();
  } else if (it == iSauced) {
    player.Say("One golden rigatone. Sauced.");
    cKhuc.Say("Golden. Sauced exactly as the First Supper says. A worthy offering.");
    player.LoseInventory(iSauced);
    RefreshInventory();
    gaveOffering = true;
    if (!saidWord) cKhuc.Say("Now, speak the Word.");
    CheckOrdained();
  } else if (it == iRigatone) {
    cKhuc.Say("Golden, yes. But naked. An offering must be properly sauced.");
  } else if (it == iBeads) {
    cKhuc.Say("The beads are not for me. You wear them.");
  } else if (it == iPamphlet) {
    cKhuc.Say("I wrote that pamphlet. Read it.");
  } else if (it == iPendant) {
    cKhuc.Say("Hold onto that. Things look different in the right light.");
  } else if (it == iWhipit) {
    GiveWhipit();
  } else {
    cKhuc.Say("No, thank you.");
  }
}

void ReadPamphlet()
{
  Sfx(aPaper);
  ShowNote("THE SPAGHETTI THEORY",
    "In the beginning was the String, and the String was boiled.[[I. Of all technologies, the String came first. Then came counting, then noodles, then at last the fork.[[II. The Word is spun, not spoken. It shows itself only under the holy ultraviolet light.[[III. An offering must be golden, and properly sauced.[[IV. Wear the beads. Always wear the beads.[[V. For the sauce, listen to the story of the First Supper.", 0);
}

void PressTile(int i)
{
  if (tileStep >= 4) {
    player.Say("The timeline's done. The drawer's open.");
    return;
  }
  if ((tileMask & (1 << i)) != 0) {
    player.Say("That one's already lit.");
    return;
  }
  // every press lights its tile; the order is only checked once all four are lit
  Sfx(aClack);
  if (TileRank(i) != tileStep) tileWrong = true;
  tileStep++;
  tileMask = tileMask | (1 << i);
  object[O_NAVE_TILE1 + i].Graphic = S_NAVE_TILE1_ON + i * 2;
  if (tileStep < 4) return;
  if (!tileWrong) {
    Wait(8);
    Sfx(aDrawer);
    Wait(20);
    object[O_NAVE_DRAWER].Visible = true;
    object[O_NAVE_PENDANT].Visible = !pendantTaken;
    Sfx(aChime);
    player.Say("Oldest to newest! A little drawer popped open.");
    return;
  }
  Wait(12);
  Sfx(aReset);
  tileStep = 0;
  tileMask = 0;
  tileWrong = false;
  int k = 0;
  while (k < 4) {
    object[O_NAVE_TILE1 + k].Graphic = S_NAVE_TILE1_OFF + k * 2;
    k++;
  }
  player.Say("Clunk. All four tiles went dark again. Wrong order, somewhere.");
}

String TileLook(int i)
{
  if (i == 0) return "A bowl of noodles. The plaque says they're about 4,000 years old.";
  if (i == 1) return "A dinner fork. About 2,000 years old, give or take a Roman.";
  if (i == 2) return "A piece of twisted cord. The plaque says string is about 50,000 years old.";
  return "A bone with tally marks on it: counting. About 20,000 years old.";
}

void WarnBox()
{
  // the first time the guest fiddles with the box, Khuc notices
  if (boxWarned) return;
  boxWarned = true;
  if (cKhuc.Room != player.Room) return;
  cKhuc.Say("Hands off, pilgrim! That is my reliquary.");
  player.Say("Can I open it?");
  cKhuc.Say("Only the worthy may open it. Solve every riddle in this room, and the answer will reveal itself.");
  player.Say("Every riddle? I'm much too lazy for that.");
  player.Say("Is there an easier way?");
  cKhuc.Say("...");
  cKhuc.Say("Bring me a whip-it, and I'll open it for you. A little steel canister. The party upstairs ran out of them hours ago.");
  player.Say("Where am I supposed to find a whip-it in a noodle shrine?");
  cKhuc.Say("The tiny folk find all sorts of things in the sod. If you can get them to listen to you.");
}

void PressButton(int i)
{
  if (boxOpen) return;
  Sfx(aButton);
  if (ButtonRank(i) == boxStep) {
    boxStep++;
    if (!wearUV) object[O_NAVE_BTN1 + i].Graphic = S_NAVE_BTN1_UP + i * 3 + 1;
    if (boxStep == 3) {
      Wait(10);
      Sfx(aBoxOpen);
      boxOpen = true;
      SetupNave();
      player.Say("The lid popped open! There's a golden rigatone inside.");
    }
  } else {
    Wait(6);
    Sfx(aReset);
    boxStep = 0;
    SetupNave();
    player.Say("Click. The buttons all popped back up.");
  }
}

void SpinDrum(int i)
{
  Sfx(aRatchet);
  drum[i] = (drum[i] + 1) % 4;
  object[O_NAVE_DRUM1 + i].Graphic = DrumSprite(i);
  Wait(8);
  CheckWord();
}

void PlayPhone()
{
  // three audio stories, one per pick-up, round and round
  Sfx(aPhone);
  int col = C(200, 170, 255);
  if (phoneStory == 0) {
    Narrate(40, 140, col, "\"Story one: the Creation.\"");
    Narrate(40, 140, col, "\"On the first day, the Noodly One boiled the waters. On the second, the sauce. On the third, the leftovers...\"");
    Narrate(40, 140, col, "\"...and the faithful shall know the Word by its glow, for it is spun and not spoken.\"");
  } else if (phoneStory == 1) {
    Narrate(40, 140, col, "\"Story two: the First Supper.\"");
    Narrate(40, 140, col, "\"And the Noodly One said: sauce Me an offering, and sauce it thus.\"");
    Narrate(40, 140, col, "\"A pump of red for each of My eyes. A pump of green for each of My noses.\"");
    Narrate(40, 140, col, "\"And a single pump of yellow, for the One True Noodle. Then dip, and be fed.\"");
    heardRecipe = true;
  } else {
    Narrate(40, 140, col, "\"Story three: the Prophecy of the Tiny Folk.\"");
    Narrate(40, 140, col, "\"The little ones of the sod will serve any god who shows them three signs. Ask, and they will search the very earth for you.\"");
    Narrate(40, 140, col, "\"First, the mountain shall rise. Then the river shall part. And last, a purple star shall shine.\"");
    Narrate(40, 140, col, "\"In that order. They are very particular.\"");
    heardProphecy = true;
  }
  phoneStory = (phoneStory + 1) % 3;
  if (!phoneHeard) {
    phoneHeard = true;
    player.Say("Audio stories. There seem to be a few; I'll get the next one if I pick it up again.");
  }
}

// ---------------------------------------------------------------- the sauce
void Pump(int which)
{
  if (pumpR + pumpG + pumpY >= 6) {
    player.Say("The bowl's full. I'd better tip it out and start again.");
    return;
  }
  Sfx(aSquirt);
  if (which == 0) { pumpR++; player.Say("Squirt. A pump of red."); }
  else if (which == 1) { pumpG++; player.Say("Squirt. A pump of green."); }
  else { pumpY++; player.Say("Squirt. A pump of yellow."); }
}

String BowlContents()
{
  if (pumpR + pumpG + pumpY == 0) return "The bowl is empty.";
  return String.Format("In the bowl: %d red, %d green and %d yellow.", pumpR, pumpG, pumpY);
}

void EmptyBowl()
{
  if (pumpR + pumpG + pumpY == 0) { player.Say("It's already empty."); return; }
  pumpR = 0; pumpG = 0; pumpY = 0;
  player.Say("I tip the bowl out into the marinara river on the sod table. The tiny villagers are thrilled.");
}

void Dip()
{
  if (pumpR + pumpG + pumpY == 0) {
    player.Say("The bowl's empty. I'll need to pump some sauce into it first.");
    return;
  }
  Sfx(aSlurp);
  dipR = pumpR; dipG = pumpG; dipY = pumpY;
  pumpR = 0; pumpG = 0; pumpY = 0;
  player.LoseInventory(iRigatone);
  player.AddInventory(iSauced);
  RefreshInventory();
  player.Say("I roll the rigatone in the bowl. It soaks up every drop. Sauced!");
}

// ---------------------------------------------------------------- the tiny folk
void FindWhipit()
{
  Sfx(aRattle);
  whipFound = true;
  player.Say("The villagers bow down. I am their god now. I'd better ask for something useful.");
  player.Say("\"My people! Search the sod, and bring me... a whip-it!\"");
  player.Say("They scatter, digging under every tuft of grass. After a while a tiny procession comes back, carrying a little steel canister over their heads.");
  object[O_NAVE_RUINS].Visible = true;
  player.AddInventory(iWhipit);
  RefreshInventory();
  player.Say("A whip-it. The tiny folk are very thorough.");
  player.Say("They also dug up their entire village to find it. Very, very thorough.");
}

void Miracle(int n)
{
  // n: 0 mountain, 1 river, 2 purple star
  if (whipFound) {
    player.Say("They've already dug up their whole village for me. I think they've suffered enough.");
    return;
  }
  if (n == 0) player.Say("I push up a little mountain in the middle of the sod. The tiny villagers gasp.");
  else if (n == 1) player.Say("I run a finger through the marinara river. It parts! The villagers cross on dry sod.");
  else player.Say("I hold the glowing pendant high over the tiny world. A purple star! The villagers fall to their knees.");
  if (n == miracle) {
    miracle++;
    if (miracle == 3) FindWhipit();
    else if (miracle == 1) player.Say("They look up at me, waiting for something more.");
    else player.Say("They're whispering excitedly. One more sign, I think.");
  } else if (n < miracle) {
    player.Say("They've seen that one. They wait politely for something new.");
  } else {
    miracle = 0;
    player.Say("They mutter and shake their tiny heads. Whatever that was, it wasn't in their prophecy. Not in that order.");
  }
}

void PlayGod()
{
  String star = null;
  if (wearUV) star = "Make a purple star shine.";
  int c = Choose("Raise a mountain.", "Part the marinara river.", star, "Smite them.", "Never mind.");
  if (c == 1) Miracle(0);
  else if (c == 2) Miracle(1);
  else if (c == 3) Miracle(2);
  else if (c == 4) player.Say("I'm a benevolent god. Mostly.");
}

void MakeBeads()
{
  Sfx(aRattle);
  beadsTaken = true;
  SetupNave();
  player.LoseInventory(iString);
  player.AddInventory(iBeads);
  RefreshInventory();
  player.Say("I thread the elbow macaroni from the scale onto the string, one by one, and tie the medal on at the bottom.");
  player.Say("Pasta rosary beads! Handmade, holy, and slightly al dente.");
}

bool NaveHot(int v, int i, InventoryItem* it)
{
  if (i == H_NAVE_ARCH) {
    if (v == V_LOOK) {
      if (ordained) player.Say("The archway to the Crypt. Purple light, and arcade noises.");
      else player.Say("An archway in the wall.");
      return true;
    }
    if (ordained && (v == V_WALK || v == V_USE || v == V_OPEN)) {
      player.Walk(586, 266, eBlock, eWalkableAreas);
      player.Walk(586, 250, eBlock, eAnywhere);
      player.ChangeRoom(R_CRYPT, 152, 232);
      return true;
    }
  }
  if (i == H_NAVE_DOOR) {
    if (v == V_LOOK) { player.Say("Room 913, where I came in. Someone hung a Do Not Disturb sign on the inside."); return true; }
    if (v == V_OPEN || v == V_USE || v == V_PULL) { player.Say("The party's in here. Well, somewhere in here."); return true; }
  }
  if (i == H_NAVE_WALLPAPER) {
    if (v == V_LOOK) { player.Say("Wallpaper strips, hung by hand. Tiny forks, all the way up."); return true; }
    if (v == V_PULL) { player.Say("I'm not peeling the art off the walls."); return true; }
  }
  if (i == H_NAVE_SAUCE) {
    if (v == V_LOOK) {
      player.Say("\"Weird Sauce.\" Three dispensers, red, green and yellow, pump into one spout over a little bowl.");
      return true;
    }
    if (v == V_USE && it == null) {
      Sfx(aSquirt);
      player.Say("I put a finger under the spout and taste it.");
      player.Say("Marinara, chocolate, and something like pickle brine. Weird. As advertised.");
      return true;
    }
    if (v == V_USE && it == iRigatone) { Dip(); return true; }
    if (v == V_USE && it == iSauced) { player.Say("It's sauced enough. Any more and it's soup."); return true; }
    if (v == V_USE) { player.Say("That doesn't need sauce."); return true; }
    if (v == V_PUSH || v == V_PULL) { player.Say("Which one? There's red, green and yellow."); return true; }
  }
  if (i == H_NAVE_REDSAUCE || i == H_NAVE_GREENSAUCE || i == H_NAVE_YELLOWSAUCE) {
    int which = 0;
    if (i == H_NAVE_GREENSAUCE) which = 1;
    if (i == H_NAVE_YELLOWSAUCE) which = 2;
    if (v == V_LOOK) {
      if (which == 0) player.Say("The red dispenser. Marinara, by the smell of it.");
      else if (which == 1) player.Say("The green dispenser. Pesto, I hope.");
      else player.Say("The yellow dispenser. It might be custard. It might not.");
      return true;
    }
    if (v == V_PUSH || v == V_PULL || (v == V_USE && it == null)) { Pump(which); return true; }
    if (v == V_USE && it == iRigatone) { player.Say("It pumps into the bowl. I'll dip the rigatone in the bowl."); return true; }
  }
  if (i == H_NAVE_BOWL) {
    if (v == V_LOOK) { player.Say(BowlContents()); return true; }
    if (v == V_PICKUP || v == V_PULL || v == V_PUSH || v == V_CLOSE || (v == V_USE && it == null)) { EmptyBowl(); return true; }
    if (v == V_USE && it == iRigatone) { Dip(); return true; }
    if (v == V_USE && it == iSauced) { player.Say("It's sauced already. More would just be soup."); return true; }
  }
  if (i == H_NAVE_GLUTENOUS) {
    if (v == V_LOOK) { player.Say("\"Glutenous Truth.\" A glowing loaf. I feel enlightened and slightly full."); return true; }
  }
  if (i == H_NAVE_FLAT) {
    if (v == V_LOOK) {
      player.Say("A painted flat in the style of stained glass: the Noodly One, blessing a field.");
      player.Say("Two eyes on stalks. No nose that I can see. Gods don't need noses, I suppose.");
      return true;
    }
    if (v == V_PUSH || v == V_PULL) { player.Say("It's plywood. Very nicely painted plywood."); return true; }
  }
  if (i == H_NAVE_TIMELINE) {
    if (v == V_LOOK) {
      player.Say("\"Timeline of Ancient Technology.\" Four tiles, and an arrow from OLDEST to NEWEST.");
      if (tileStep < 4) player.Say("I think you press them in order.");
      return true;
    }
  }
  if (i == H_NAVE_TOPOLOGY) {
    if (v == V_LOOK) { player.Say("\"Sacred Topology.\" Two trefoil knots and a figure eight. None of them come undone without scissors. That's the point."); return true; }
  }
  if (i == H_NAVE_CROCHET) {
    if (v == V_LOOK) { player.Say("Crocheted pasta: farfalle, shells, a little ravioli. All yarn. I checked."); return true; }
    if (v == V_PICKUP) { player.Say("They're yarn. I can't sauce yarn. Well, I could, but I shouldn't."); return true; }
  }
  if (i == H_NAVE_FIRSTTASTE) {
    if (v == V_LOOK) { player.Say("\"First Taste.\" Someone eating their very first noodle. I remember mine."); return true; }
  }
  if (i == H_NAVE_SODTABLE) {
    if (v == V_LOOK) {
      if (whipFound) {
        player.Say("The tiny village is in ruins. Holes everywhere, houses on their sides, the temple leaning like a drunk.");
        player.Say("The villagers are sitting in the rubble, looking up at me, very proud of themselves.");
        player.Say("The sign still says PLAY GOD. I've played enough.");
        return true;
      }
      player.Say("A table covered in real sod. There's a tiny world on it: hills, a river of marinara, some very small villagers.");
      player.Say("A sign says PLAY GOD.");
      player.Say("In the middle there's a tiny temple, and the villagers keep glancing up, as if waiting for a sign.");
      return true;
    }
    if ((v == V_USE && it == null) || v == V_PUSH || v == V_PULL) { PlayGod(); return true; }
    if (v == V_USE && it == iPendant) { Miracle(2); return true; }
    if (v == V_PICKUP) { if (whipFound) player.Say("It's a whole disaster area now."); else player.Say("It's a whole ecosystem."); return true; }
  }
  if (i == H_NAVE_HANDSET) {
    if (v == V_LOOK) { player.Say("An old telephone handset. A label says AUDIO STORIES."); return true; }
    if (v == V_USE || v == V_PICKUP || v == V_TALK) { PlayPhone(); return true; }
  }
  if (i == H_NAVE_SCULPTURE) {
    if (v == V_LOOK) { player.Say("A spaghetti sculpture: a spiralling tower of noodles that turns, at the top, into the Noodly One himself. Two eyes, no nose."); return true; }
    if (v == V_PICKUP) { player.Say("Hands off the art."); return true; }
    if (v == V_PUSH || v == V_PULL) { player.Say("It wobbles terrifyingly. I stop."); return true; }
    if (v == V_USE && it != null) { player.Say("I'm not adding to the sculpture."); return true; }
  }
  if (i == H_NAVE_SPINNER) {
    if (v == V_LOOK) {
      player.Say("A paragraph spinner. Four windows of words, each with a lever. Spin them to make a sentence.");
      player.Say(String.Format("Right now it says: \"%s %s %s %s.\"", DrumWord(0), DrumWord(1), DrumWord(2), DrumWord(3)));
      return true;
    }
    if (v == V_USE || v == V_PUSH || v == V_PULL) { player.Say("I'll spin the windows one at a time, with their levers."); return true; }
  }
  if (i == H_NAVE_SCALES) {
    if (v == V_LOOK) {
      player.Say("Scales of Pasta. One pan holds a little brass weight stamped ONE HOLY OUNCE.");
      if (!beadsTaken) player.Say("The other holds exactly one holy ounce of elbow macaroni, and a big flat macaroni medal.");
      else player.Say("The other pan is empty. I'm wearing its contents.");
      return true;
    }
    if (v == V_USE && it == iString) { MakeBeads(); return true; }
    if ((v == V_PICKUP || (v == V_USE && it == null)) && !beadsTaken) {
      player.Say("I'd just have loose macaroni rattling around my pockets. If I had something to thread them on...");
      return true;
    }
    if (v == V_USE && (it == iRigatone || it == iSauced)) {
      Sfx(aClack);
      player.Say("Exactly one holy ounce. Of course it is.");
      return true;
    }
    if (v == V_USE && it != null) { player.Say("I don't need that weighed."); return true; }
  }
  return false;
}

bool NaveObj(int v, int i, InventoryItem* it)
{
  if (i == O_NAVE_ARCHPANEL) {
    if (v == V_LOOK) {
      player.Say("A wall. Probably.");
      return true;
    }
    if (v == V_PUSH || v == V_PULL || v == V_OPEN) {
      player.Say("Solid. Ish.");
      cKhuc.Say("Only the ordained may pass.");
      return true;
    }
  }
  if (i == O_NAVE_TAPESTRY) {
    if (v == V_LOOK) {
      if (stringTaken) {
        player.Say("The tapestry of the Noodly One. Or what's left of it. There's a big ragged gap up the middle where his noodles used to be.");
        player.Say("I'm going to hell. A very specific, carb-heavy hell.");
      } else {
        player.Say("A tapestry of the Flying Spaghetti Monster, woven in red and gold. It says R'AMEN.");
        player.Say("There's a loose gold thread hanging from the bottom.");
        if (wearUV) player.Say("And glowing letters across it: PULL THE THREAD. Well, if it insists.");
      }
      return true;
    }
    if (!stringTaken && (v == V_PULL || v == V_PICKUP || (v == V_USE && it == null))) {
      stringTaken = true;
      Sfx(aWhoosh);
      SetupNave();
      player.AddInventory(iString);
      RefreshInventory();
      player.Say("I give the loose thread a little tug. And another. And it keeps coming...");
      player.Say("Oh no. Oh no no no.");
      player.Say("Well. I have a good long string now. The tapestry has rather less Noodly One.");
      if (cKhuc.Room == player.Room) cKhuc.Say("Was that... the R'amen tapestry? My grandmother wove that.");
      return true;
    }
    if (v == V_PULL || v == V_PICKUP) { player.Say("I've done enough damage to that tapestry for one lifetime."); return true; }
    if (v == V_OPEN || v == V_CLOSE) { player.Say("It's a tapestry. It doesn't open. It barely even holds together any more."); return true; }
    if (v == V_PUSH) { player.Say("There's just wall behind it."); return true; }
  }
  if (i == O_NAVE_BEADS) {
    if (v == V_LOOK) { player.Say("Pasta rosary beads. Macaroni on a string, with a big elbow medal."); return true; }
    if (v == V_PICKUP || v == V_USE || v == V_PULL) {
      Sfx(aRattle);
      beadsTaken = true;
      object[O_NAVE_BEADS].Visible = false;
      player.AddInventory(iBeads);
      RefreshInventory();
      return true;
    }
  }
  if (i == O_NAVE_PAMPHLET) {
    if (v == V_LOOK || v == V_OPEN) { ReadPamphlet(); return true; }
    if (v == V_PICKUP || v == V_USE) {
      Sfx(aPaper);
      pamphletTaken = true;
      object[O_NAVE_PAMPHLET].Visible = false;
      player.AddInventory(iPamphlet);
      RefreshInventory();
      return true;
    }
  }
  if (i >= O_NAVE_DRUM1 && i <= O_NAVE_DRUM4) {
    int d = i - O_NAVE_DRUM1;
    if (v == V_LOOK) {
      if (wearUV && ((d == 0 && drum[0] == 1) || (d == 1 && drum[1] == 2) || (d == 2 && drum[2] == 0) || (d == 3 && drum[3] == 1)))
        player.Say("A window of words. This one is glowing so brightly I can't read it.");
      else player.Say(String.Format("A window of words. This one says %s. Its lever spins it.", DrumWord(d)));
      return true;
    }
    if (v == V_PUSH || v == V_PULL || v == V_USE || v == V_OPEN || v == V_CLOSE) {
      if (it != null) { player.Say("I'll just pull its lever."); return true; }
      SpinDrum(d);
      return true;
    }
  }
  if (i >= O_NAVE_TILE1 && i <= O_NAVE_TILE4) {
    int t = i - O_NAVE_TILE1;
    if (v == V_LOOK) { player.Say(TileLook(t)); return true; }
    if (v == V_PUSH || v == V_USE || v == V_PULL) {
      if (it != null) { player.Say("I'll press it with my finger."); return true; }
      PressTile(t);
      return true;
    }
    if (v == V_PICKUP) { player.Say("They're fixed to the board."); return true; }
  }
  if (i == O_NAVE_DRAWER) {
    if (v == V_LOOK) {
      if (pendantTaken) player.Say("An empty little drawer.");
      else player.Say("A little drawer with a pendant in it.");
      return true;
    }
    if (v == V_CLOSE || v == V_PUSH) { player.Say("It's stuck open. Fine."); return true; }
  }
  if (i == O_NAVE_PENDANT) {
    if (v == V_LOOK) { player.Say("A crystal pendant with a tiny battery. A UV pendant!"); return true; }
    if (v == V_PICKUP || v == V_USE) {
      Sfx(aClink);
      pendantTaken = true;
      object[O_NAVE_PENDANT].Visible = false;
      player.AddInventory(iPendant);
      RefreshInventory();
      return true;
    }
  }
  if (i == O_NAVE_BOX) {
    if (v == V_LOOK) {
      if (boxOpen && !rigTaken) player.Say("The puzzle box is open. A golden rigatone sits inside.");
      else if (boxOpen) player.Say("An empty puzzle box.");
      else {
        player.Say("A wooden puzzle box with three buttons shaped like pasta: penne, farfalle and a shell.");
        player.Say("A little brass plate says: PROPERTY OF KHUC. COMBINATION ON THE BOTTOM.");
      }
      return true;
    }
    if (v == V_OPEN || v == V_USE || v == V_PULL) {
      if (boxOpen) { player.Say("It's already open."); return true; }
      player.Say("It's locked tight. The buttons must do something.");
      return true;
    }
    if (v == V_PICKUP || v == V_PUSH) {
      player.Say("I tilt it to look at the bottom. There's writing, in letters so small they might be noodles.");
      player.Say("I can't read a word of it.");
      if (!knowCombo) WarnBox();
      return true;
    }
  }
  if (i >= O_NAVE_BTN1 && i <= O_NAVE_BTN3) {
    int b = i - O_NAVE_BTN1;
    if (v == V_LOOK) {
      String kind = "penne";
      if (b == 1) kind = "farfalle";
      if (b == 2) kind = "shell";
      player.Say(String.Format("A button shaped like %s.", kind));
      return true;
    }
    if (v == V_PUSH || v == V_USE) {
      if (it != null) { player.Say("I'll press it with my finger."); return true; }
      if (cKhuc.Room == player.Room) {
        // Chuk won't let anyone else touch his buttons
        if (!boxWarned) WarnBox();
        else cKhuc.Say("Ah-ah! Hands off my reliquary. A whip-it first.");
        return true;
      }
      PressButton(b);
      return true;
    }
  }
  if (i == O_NAVE_RIGATONE) {
    if (v == V_LOOK) { player.Say("A golden rigatone. Golden as in painted gold. Probably still pasta underneath."); return true; }
    if (v == V_PICKUP || v == V_USE) {
      Sfx(aClink);
      rigTaken = true;
      object[O_NAVE_RIGATONE].Visible = false;
      player.AddInventory(iRigatone);
      RefreshInventory();
      return true;
    }
  }
  if (i == O_NAVE_FORK) {
    if (v == V_LOOK) { player.Say("\"Spinning Fork.\" It actually spins. Forever twirling, never eating."); return true; }
  }
  return false;
}

// ======================================================================
// THE CRYPT
// ======================================================================
void PlaceShape(int k, int n)
{
  if (compOpen) { player.Say("The board's solved. I'm not touching it."); return; }
  if (recess[k] >= 0) player.AddInventory(ShapeItem(recess[k]));
  player.LoseInventory(ShapeItem(n));
  recess[k] = n;
  Sfx(aClack);
  SetupCrypt();
  RefreshInventory();
  int i = 0;
  while (i < 4) {
    if (recess[i] < 0) return;
    i++;
  }
  // all four in: right, or they all come back out
  bool right = true;
  i = 0;
  while (i < 4) {
    if (recess[i] != SlotAnswer(i)) right = false;
    i++;
  }
  Wait(12);
  if (right) {
    Sfx(aChime);
    Wait(10);
    Sfx(aBoxOpen);
    compOpen = true;
    SetupCrypt();
    player.Say("Click. A drawer slid out from under the names.");
    player.Say("There's a crank inside! The Pope Seat's missing one of those.");
  } else {
    Sfx(aReset);
    i = 0;
    while (i < 4) {
      player.AddInventory(ShapeItem(recess[i]));
      recess[i] = -1;
      i++;
    }
    SetupCrypt();
    RefreshInventory();
    player.Say("Clunk. All four shapes popped back out. Wrong somewhere.");
  }
}

void CryptHint()
{
  if (!absolved) cKhuc.Say("Try the CONFESS cabinet. Confession is good for the soul, and it pays out.");
  else if (!tokenTaken) cKhuc.Say("CONFESS paid you a token. It's on the floor.");
  else if (!trackballWon) cKhuc.Say("Tokens are for the meatball cabinet. Nobody's ever beaten Meatball Madness.");
  else if (!rexWon) cKhuc.Say("You beat the meatball. Now take the Rex Seat and beat my high score.");
  else if (!compOpen && !powered) cKhuc.Say("The shapes go on the board.");
  else if (!compOpen) cKhuc.Say("Each shape goes over its name. The new pastas were in the news, and the computer has the news.");
  else if (!crankTaken) cKhuc.Say("The board opened. Take what's inside.");
  else if (!crankFitted) cKhuc.Say("Give me the crank, and I'll fit it to the Pope Seat.");
  else cKhuc.Say("Sit in the Pope Seat, your holiness-to-be.");
}

void TalkKhucCrypt()
{
  player.FaceCharacter(cKhuc, eBlock);
  if (khucAtCrank) {
    cKhuc.Say("Ready when you are, your holiness-to-be. Sit, and I'll crank.");
    return;
  }
  bool done = false;
  while (!done) {
    if (!rexWon) {
      int c = Choose("What are you playing?", "Can you help me with the Pope Seat?", "What's behind the curtain?", "I'm stuck.", "I'll let you play.");
      if (c == 1) {
        player.Say("What are you playing?");
        cKhuc.Say("T. Rex. You jump over cacti until the meteor comes.");
        cKhuc.Say("I'm trying to beat it so I can see the ending scene. Nobody has ever seen the ending scene.");
      } else if (c == 2) {
        player.Say("Can you help me with the Pope Seat?");
        cKhuc.Say("The Pope Seat is not for just anyone. Only the worthy may sit upon the throne and become Pope.");
        player.Say("Who decides who's worthy?");
        cKhuc.Say("The Seat does. Well, the Hat does. Well, I do. I turn the crank.");
        cKhuc.Say("The worthy must prove themselves in body, in mind, and in arcade.");
        player.Say("In arcade?");
        cKhuc.Say("It's a crypt full of cabinets, pilgrim. What did you think worthiness looked like?");
        cKhuc.Say("Anyway, the crank's gone missing. I'll look into it after this level.");
        cKhuc.Say("I've been saying that for some time.");
      } else if (c == 3) {
        player.Say("What's behind the curtain?");
        cKhuc.Say("The staff room. Staff only.");
        cKhuc.Say("Spare colanders, folding chairs, and the drinks for after strike.");
        player.Say("Strike?");
        cKhuc.Say("When the party's over, it all comes down. Don't think about it. I try not to.");
      } else if (c == 4) {
        player.Say("I'm stuck.");
        CryptHint();
      } else {
        player.Say("I'll let you play.");
        if (!trackballWon) cKhuc.Say("Meteor. Again.");
        done = true;
      }
    } else {
      int c = Choose("Where's the crank for the Pope Seat?", "How do the shapes go on the board?", "I'm stuck.", "Am I worthy yet?", "See you later.");
      if (c == 1) {
        player.Say("Where's the crank for the Pope Seat?");
        if (crankTaken) cKhuc.Say("You've got it. Give it here, and I'll fit it.");
        else cKhuc.Say("Locked in the Pasta Identification board, for safety. Match the shapes and it's yours.");
      } else if (c == 2) {
        player.Say("How do the shapes go on the board?");
        cKhuc.Say("Each shape over its name, of course. They're the new pastas.");
        cKhuc.Say("It was in all the papers. If only we had a paper.");
      } else if (c == 3) {
        player.Say("I'm stuck.");
        CryptHint();
      } else if (c == 4) {
        player.Say("Am I worthy yet?");
        cKhuc.Say("You beat Meatball Madness. You beat my high score. In arcade, you are very worthy.");
        if (!compOpen) cKhuc.Say("In mind, that remains to be seen. The board, pilgrim. Match the new pastas.");
        else if (!crankFitted) cKhuc.Say("And you solved my board. Bring me the crank, and the Seat is yours.");
        else cKhuc.Say("Worthier than anyone ever. Sit, your holiness-to-be.");
      } else {
        player.Say("See you later.");
        done = true;
      }
    }
  }
}

void PlayTrackball()
{
  if (trackballWon) { player.Say("I've beaten Meatball Madness. My wrists have retired."); return; }
  if (player.InventoryQuantity[iToken.ID] == 0) {
    player.Say("INSERT TOKEN, it says. I don't have one.");
    return;
  }
  int col = C(255, 210, 90);
  player.LoseInventory(iToken);
  RefreshInventory();
  Sfx(aCoinIn);
  object[O_CRYPT_MEATSCREEN].Graphic = S_CRYPT_MEATSCREEN_GAME;
  Wait(10);
  Narrate(360, 110, col, "MEATBALL MADNESS! ROLL THE MEATBALL HOME!");
  player.Say("Left. Right. Round the fork. Under the colander...");
  SfxVol(aBleeps, 35);
  player.Say("Past the parmesan avalanche, over the garlic bread bridge, and...");
  SfxVol(aBleeps, 35);
  player.Say("Into the bowl!");
  Sfx(aFanfare);
  Narrate(360, 110, col, "YOU WIN! ALL HAIL THE MEATBALL MASTER!");
  trackballWon = true;
  // Chuk heard that
  cKhuc.UnlockView();
  cKhuc.Loop = 0;
  cKhuc.Say("Was that... the Meatball Madness victory jingle?");
  cKhuc.Walk(324, 272, eBlock, eAnywhere);
  object[O_CRYPT_REXSCREEN].Graphic = S_CRYPT_REXSCREEN_OFF;
  cKhuc.FaceCharacter(player, eBlock);
  cKhuc.Say("Nobody beats Meatball Madness. I've been trying since they dug the Crypt.");
  cKhuc.Say("You're a true gamer, pilgrim.");
  cKhuc.Say("Fine. Take the Rex Seat. Beat my high score, and one of us might finally see the ending.");
}

void PlayRex()
{
  if (!trackballWon) {
    cKhuc.Say("Busy. Level nine. I'm going to beat this and see the ending if it kills me.");
    return;
  }
  if (rexWon) {
    player.Say("I've seen the ending. It's the meteor.");
    return;
  }
  int col = C(255, 210, 90);
  player.Say("Chuk's high score is 99,999. Here goes.");
  object[O_CRYPT_REXSCREEN].Graphic = S_CRYPT_REXSCREEN_PLAY;
  SfxVol(aBleeps, 35);
  player.Say("Jump. Jump. Duck. Jump. A pterodactyl! Duck!");
  SfxVol(aBleeps, 35);
  player.Say("99,998... 99,999... 100,000!");
  Sfx(aFanfare);
  object[O_CRYPT_REXSCREEN].Graphic = S_CRYPT_REXSCREEN_HIGH;
  Narrate(200, 110, col, "NEW HIGH SCORE! PREPARE FOR THE ENDING!");
  Wait(30);
  Sfx(aWhoosh);
  Narrate(200, 110, col, "THE METEOR COMES. THE END.");
  player.Say("The ending scene is... the meteor.");
  object[O_CRYPT_REXSCREEN].Graphic = S_CRYPT_REXSCREEN_SCORES;
  rexWon = true;
  cKhuc.FaceCharacter(player, eBlock);
  cKhuc.Say("All those years. For the meteor.");
  cKhuc.Say("I'm sorry, pilgrim. I've been so busy with games, I never finished setting up the Crypt.");
  cKhuc.Say("Wait here.");
  cKhuc.Walk(462, 240, eBlock, eAnywhere);
  object[O_CRYPT_CURTAIN].Graphic = S_CRYPT_CURTAIN_OPEN;
  Sfx(aWhoosh);
  cKhuc.Transparency = 100;
  Wait(30);
  Sfx(aRattle);
  Wait(20);
  cKhuc.Transparency = 0;
  object[O_CRYPT_CURTAIN].Graphic = S_CRYPT_CURTAIN_CLOSED;
  cKhuc.Walk(410, 268, eBlock, eAnywhere);
  cKhuc.FaceCharacter(player, eBlock);
  cKhuc.Say("The shapes for the Pasta Identification board. I never got round to putting them up.");
  player.AddInventory(iTrefoil);
  player.AddInventory(iInfinity);
  player.AddInventory(iMobius);
  player.AddInventory(iTorus);
  RefreshInventory();
  player.Say("These aren't pasta. They're... geometry.");
  cKhuc.Say("They're the new pastas. Very modern. It was in all the papers.");
  cKhuc.Say("And the computer. I never even plugged it in.");
  cKhuc.Walk(372, 250, eBlock, eAnywhere);
  cKhuc.FaceDirection(eDirectionUp, eBlock);
  Sfx(aClack);
  Wait(10);
  powered = true;
  object[O_CRYPT_SCREEN].Visible = true;
  SfxVol(aBleeps, 35);
  cKhuc.FaceCharacter(player, eBlock);
  cKhuc.Say("There. It's got the news on it, and a game or two.");
  cKhuc.Walk(566, 270, eBlock, eAnywhere);
  cKhuc.FaceDirection(eDirectionLeft, eBlock);
  cKhuc.Say("I'll be by the Pope Seat when you need me.");
}


void ConfessGame()
{
  if (absolved) {
    Narrate(30, 120, C(255, 120, 120), "ABSOLVED ALREADY. GO IN PEACE. INSERT NO MORE SINS.");
    return;
  }
  int col = C(255, 120, 120);
  SfxVol(aBleeps, 35);
  Narrate(30, 120, col, "WELCOME TO CONFESS! CONFESS YOUR SINS TO WIN!");
  bool done = false;
  while (!done) {
    String a = null; String b = null; String c = null; String d = null;
    if (!confessed[0]) a = "I stole a bellhop uniform from a hotel dresser.";
    if (!confessed[1]) b = "I unscrewed a medicine cabinet mirror. With a screwdriver.";
    if (!confessed[2]) c = "I ate a candy bar from the minibar and didn't pay.";
    if (!confessed[3]) d = "I once put pineapple on pasta.";
    int k = Choose(a, b, c, d, "I'd rather not say.");
    if (k == 5) {
      player.Say("I'd rather not say.");
      Sfx(aSad);
      Narrate(30, 120, col, "COWARD! GAME OVER.");
      done = true;
    } else {
      confessed[k - 1] = true;
      if (k == 1) player.Say("I stole a bellhop uniform from a hotel dresser.");
      if (k == 2) player.Say("I unscrewed a medicine cabinet mirror. With a screwdriver.");
      if (k == 3) player.Say("I ate a candy bar from the minibar and didn't pay.");
      if (k == 4) {
        player.Say("I once put pineapple on pasta.");
        Sfx(aBuzz);
        Narrate(30, 120, col, "UNFORGIVABLE! ALL PROGRESS LOST.");
        sins = 0;
        confessed[0] = false; confessed[1] = false; confessed[2] = false;
        done = true;
      } else {
        sins++;
        SfxVol(aBleeps, 35);
        if (sins == 1) Narrate(30, 120, col, "GOOD. MORE.");
        else if (sins == 2) Narrate(30, 120, col, "MORE! MORE SINS!");
        else {
          Narrate(30, 120, col, "ABSOLVED!! HAVE A TOKEN.");
          absolved = true;
          Sfx(aClink);
          object[O_CRYPT_TOKEN].Visible = true;
          done = true;
        }
      }
    }
  }
}

void Confess()
{
  // the first time, the booth opens: half open, then fully open, and it stays open
  if (!boothOpened) {
    Sfx(aWardOpen);
    object[O_CRYPT_BOOTH].Graphic = S_CRYPT_BOOTH_AJAR;
    Wait(12);
    object[O_CRYPT_BOOTH].Graphic = S_CRYPT_BOOTH_OPEN;
    Wait(8);
    boothOpened = true;
  }
  ConfessGame();
}

void ClownsIn()
{
  // the room-service clowns from the first game, through the archway
  Character* cl[3];
  cl[0] = cClown1; cl[1] = cClown2; cl[2] = cClown3;
  int k = 0;
  while (k < 3) {
    cl[k].ManualScaling = true;
    cl[k].Scaling = 80;
    cl[k].ChangeRoom(R_CRYPT, 152, 230);
    cl[k].Transparency = 0;
    k++;
  }
}

void EndRoomService()
{
  int col = C(250, 250, 250);
  Narrate(380, 116, col, "Room service for all!");
  cKhuc.Say("What have you done!");
  Sfx(aPhone);
  Wait(30);
  cKhuc.Say("You don't say that here. Not in this hotel. Never in this hotel.");
  ClownsIn();
  Sfx(aFanfare);
  cClown1.Walk(486, 272, eNoBlock, eAnywhere);
  cClown2.Walk(440, 278, eNoBlock, eAnywhere);
  cClown3.Walk(590, 280, eBlock, eAnywhere);
  while (cClown1.Moving || cClown2.Moving) Wait(1);
  cClown1.Say("ROOM SERVICE!");
  // whisked away: the new Pope out of the seat, Chuk off his feet
  cClown1.LockView(VCLOWN1); cClown1.Animate(4, 2, eRepeat, eNoBlock);
  cClown3.LockView(VCLOWN3); cClown3.Animate(4, 2, eRepeat, eNoBlock);
  object[O_CRYPT_SEAT].Graphic = S_CRYPT_SEAT_CRANK;
  object[O_CRYPT_HAT].Visible = false;
  cKhuc.Say("Put me down! I'm clergy!");
  Sfx(aWhoosh);
  cKhuc.Transparency = 100;
  cClown1.UnlockView(); cClown3.UnlockView();
  cClown1.Walk(152, 230, eNoBlock, eAnywhere);
  cClown2.Walk(152, 230, eNoBlock, eAnywhere);
  cClown3.Walk(152, 230, eBlock, eAnywhere);
  while (cClown1.Moving || cClown2.Moving) Wait(1);
  cClown1.ChangeRoom(-1); cClown2.ChangeRoom(-1); cClown3.ChangeRoom(-1);
  Wait(40);
}

void EndFreePlay()
{
  int col = C(250, 250, 250);
  Narrate(380, 116, col, "All games are free play!");
  cKhuc.Say("FREE PLAY! You beautiful, beautiful Pope!");
  // every cabinet in the Crypt flashes
  DynamicSprite* fl = DynamicSprite.Create(640, 288, true);
  DrawingSurface* ds = fl.GetDrawingSurface();
  ds.Clear(COLOR_TRANSPARENT);
  ds.DrawingColor = C(255, 240, 160);
  ds.DrawRectangle(8, 100, 100, 287);            // CONFESS
  ds.DrawRectangle(210, 140, 300, 250);          // T. Rex
  ds.DrawRectangle(560, 104, 639, 287);          // Meatball Madness
  ds.Release();
  Overlay* ov = Overlay.CreateGraphical(0, 0, fl.Graphic, true);
  int k = 0;
  while (k < 10) {
    ov.Transparency = 40 + 30 * (k % 2);
    if (k % 2 == 0) SfxVol(aBleeps, 35);
    Wait(8);
    ov.Transparency = 100;
    Wait(6);
    k++;
  }
  ov.Remove();
  ClownsIn();
  Sfx(aFanfare);
  cClown1.Say("FREE PLAY!");
  cClown1.Walk(124, 276, eNoBlock, eAnywhere);
  cClown2.Walk(286, 262, eNoBlock, eAnywhere);
  cClown3.Walk(560, 280, eBlock, eAnywhere);
  while (cClown1.Moving || cClown2.Moving) Wait(1);
  cClown1.FaceDirection(eDirectionLeft, eBlock);
  cClown2.FaceDirection(eDirectionLeft, eBlock);
  cClown3.FaceDirection(eDirectionRight, eBlock);
  cClown2.LockView(VCLOWN2); cClown2.Animate(4, 2, eRepeat, eNoBlock);
  SfxVol(aBleeps, 35);
  Wait(30);
  SfxVol(aBleeps, 35);
  cKhuc.Say("Hey! That's MY high score they're beating!");
  Wait(30);
  cClown2.UnlockView();
}

void EndParty()
{
  int col = C(250, 250, 250);
  Narrate(380, 116, col, "Let's party!");
  cKhuc.Say("Let's party? Hasn't that been what we've been doing this whole time?");
  cKhuc.Say("Look at the time. It's nearly strike anyway. Everything gets torn down in the morning.");
  cKhuc.Say("Come on, your holiness. One drink in the staff room before we have to tear it all down.");
  // out of the seat
  object[O_CRYPT_SEAT].Graphic = S_CRYPT_SEAT_CRANK;
  object[O_CRYPT_HAT].Visible = false;
  player.Transparency = 0;
  player.x = 526; player.y = 270;
  Wait(10);
  object[O_CRYPT_CURTAIN].Graphic = S_CRYPT_CURTAIN_OPEN;
  Sfx(aWhoosh);
  cKhuc.Walk(452, 238, eNoBlock, eAnywhere);
  player.Walk(472, 240, eBlock, eAnywhere);
  while (cKhuc.Moving) Wait(1);
  cKhuc.Transparency = 100;
  player.Transparency = 100;
  object[O_CRYPT_CURTAIN].Graphic = S_CRYPT_CURTAIN_CLOSED;
  Wait(30);
  SfxVol(aBleeps, 20);
  Wait(40);
}

void Ending()
{
  endingMode = true;
  player.ChangeRoom(R_TITLE, -100, 300);
}

void SitPope()
{
  // sit down
  player.Transparency = 100;
  if (crankFitted) object[O_CRYPT_SEAT].Graphic = S_CRYPT_SEAT_SEATED;
  else object[O_CRYPT_SEAT].Graphic = S_CRYPT_SEAT_SEATEDNC;
  Wait(20);
  if (!crankFitted) {
    Narrate(380, 120, C(250, 250, 250), "Comfy. But the hat only comes down by the crank, and the crank's missing.");
    Narrate(380, 120, C(250, 250, 250), "There's just an empty socket on the side.");
    object[O_CRYPT_SEAT].Graphic = S_CRYPT_SEAT_EMPTY;
    player.Transparency = 0;
    return;
  }
  cKhuc.Say("Hold still, your holiness.");
  cKhuc.LockView(VKCRANK);
  cKhuc.Loop = 1;
  Sfx(aCrank);
  object[O_CRYPT_HAT].Move(506, 160, 1, eBlock, eAnywhere);
  hatDown = true;
  cKhuc.UnlockView();
  cKhuc.FaceDirection(eDirectionLeft, eBlock);
  cKhuc.Say("Behold! The Hat is upon you!");
  cKhuc.Say("You beat my high score. And you solved every one of my puzzles. Nobody has ever done both.");
  cKhuc.Say("Nobody has ever done either, actually.");
  cKhuc.Say("So by the power of the Hat, I decree it: you are Pope! And every Pope gets one papal request.");
  Sfx(aButton);
  int c = Choose("\"Room service for all!\"", "\"All games are free play!\"", "\"Let's party!\"", null, null);
  object[O_CRYPT_SEAT].Graphic = S_CRYPT_SEAT_DECREE;
  endingKind = c;
  if (c == 1) EndRoomService();
  else if (c == 2) EndFreePlay();
  else EndParty();
  Ending();
}

// ---------------------------------------------------------------- HOTEL.EXE
void RunHotel()
{
  player.Say("A game called HOTEL.EXE. Let's see...");
  int frames[6];
  frames[0] = SPR_HP_LOAD0; frames[1] = SPR_HP_LOAD1; frames[2] = SPR_HP_LOAD2;
  frames[3] = SPR_HP_LOAD3; frames[4] = SPR_HP_LOAD4; frames[5] = SPR_HP_LOAD5;
  int hold[6];
  hold[0] = 25; hold[1] = 20; hold[2] = 35; hold[3] = 20; hold[4] = 30; hold[5] = 30;
  Overlay* ov = Overlay.CreateGraphical(0, 0, frames[0], false);
  int k = 0;
  while (k < 6) {
    ov.Graphic = frames[k];
    Wait(hold[k]);
    k++;
  }
  ov.Remove();
  tvChannel = 0; hotelLamp = false; hotelCurtains = false; hotelMinibar = false;
  cMini.ChangeRoom(R_HOTEL, 320, 276);
  cMini.Loop = 0;
  cMini.SetAsPlayer();
}

void LogOff()
{
  backFromHotel = true;
  cGuest.SetAsPlayer();
}

void ReadNewspaper()
{
  Sfx(aPaper);
  ShowNote("The Daily Noodle",
    "NEW PASTAS BAFFLE DINERS! The Church of the Noodle has unveiled four new shapes, cut from pure geometry.[[OTTINI never end: follow one round and you cross the middle, like an eight. TORTINI have a single twist, and so only one side. ANELLI are plain rings, with a hole for your finger. And NODINI are tied in a knot of three loops that can never be undone.[[The Crypt's Pasta Identification board will be updated, says its keeper, after this level.[[Also inside: clowns sighted on 7th floor. Duck still missing.", 3);
}

void Gustav(String text)
{
  Narrate(40, 30, C(255, 230, 90), text);
}

void CallGustav()
{
  player.Say("I dial zero.");
  Sfx(aPhoneDial);   // the first game's phone
  Wait(70);
  Gustav("Front desk, Gustav speaking. How may I help you?");
  bool done = false;
  while (!done) {
    int c = Choose("Gustav! It's me, from Room 714.", "Gustav, do you know you're in a computer game?",
                   "Any tips for the pasta wall?", "What's it like down there?", "Never mind. Goodbye.");
    if (c == 1) {
      player.Say("Gustav! It's me, from Room 714.");
      Gustav("Sir checked out hours ago. I have it in the ledger. Ninth floor, wasn't it?");
      Gustav("And yet here sir is, calling from 714. On a phone that is, if you'll forgive me, drawn.");
    } else if (c == 2) {
      player.Say("Gustav, do you know you're in a computer game?");
      Gustav("Sir, I am the front desk. I am in whatever I am put in.");
      Gustav("Between ourselves, sir is in one too. And that one is on a computer in a crypt.");
      Gustav("I try not to think about who is playing that.");
    } else if (c == 3) {
      player.Say("Any tips for the pasta wall?");
      Gustav("Read the paper, sir. There's a piece about the new pastas. We slid it under the door at considerable expense.");
    } else if (c == 4) {
      player.Say("What's it like down there?");
      Gustav("Quiet, sir. The clowns have gone up to some sort of noodle church.");
      Gustav("Also there is a duck in the lobby. Nobody knows whose. Nobody asks.");
    } else {
      player.Say("Never mind. Goodbye.");
      Gustav("Good night, sir. Do enjoy whichever party you are at.");
      Sfx(aPhoneHang);
      done = true;
    }
  }
}

bool HotelHot(int v, int i, InventoryItem* it)
{
  if (i == H_HOTEL_LOGOFF) {
    if (v == V_LOOK) { player.Say("LOG OFF. Back to the Crypt."); return true; }
    LogOff();
    return true;
  }
  if (i == H_HOTEL_BATHROOM) {
    player.Say("I'm not going back in the bathroom. Some things you only do once.");
    return true;
  }
  if (i == H_HOTEL_PHONE && (v == V_USE || v == V_PICKUP || v == V_TALK)) { CallGustav(); return true; }
  if (i == H_HOTEL_TV && (v == V_USE || v == V_PUSH || v == V_PULL)) {
    tvChannel = (tvChannel + 1) % 4;
    Sfx(aTvClick);
    object[O_HOTEL_TV].Graphic = S_HOTEL_TV_C0 + tvChannel;
    if (tvChannel == 0) player.Say("Click. The weather. Sunny, with a chance of clowns.");
    else if (tvChannel == 1) player.Say("Click. A cooking show. A man in a colander is shouting about rigatoni.");
    else if (tvChannel == 2) player.Say("Click. A tiny bellhop, in a tiny Crypt, playing a tiny computer.");
    else player.Say("Click. Static. Even the TV needs a break from all this.");
    return true;
  }
  if (i == H_HOTEL_CURTAINS && (v == V_CLOSE || ((v == V_PULL || v == V_USE) && hotelCurtains))) {
    hotelCurtains = false;
    object[O_HOTEL_CURTAINS].Graphic = S_HOTEL_CURTAINS_CLOSED;
    player.Say("I close the curtains. Much better.");
    return true;
  }
  if (i == H_HOTEL_CURTAINS && (v == V_OPEN || v == V_PULL || v == V_USE)) {
    hotelCurtains = true;
    object[O_HOTEL_CURTAINS].Graphic = S_HOTEL_CURTAINS_OPEN;
    player.Say("I peek out. The city at night, eight colours deep. A full moon.");
    player.Say("Somewhere down there, a clown is parallel parking a very small car.");
    return true;
  }
  if (i == H_HOTEL_MINIBAR && (v == V_CLOSE || ((v == V_USE || v == V_PULL) && hotelMinibar))) {
    if (!hotelMinibar) { player.Say("It's already shut."); return true; }
    hotelMinibar = false;
    object[O_HOTEL_MINIBAR].Graphic = S_HOTEL_MINIBAR_CLOSED;
    object[O_HOTEL_CANDY].Visible = false;
    Sfx(aFridge);
    player.Say("I shut the minibar. Temptation averted.");
    return true;
  }
  if (i == H_HOTEL_MINIBAR && (v == V_OPEN || v == V_USE || v == V_PULL)) {
    if (hotelMinibar) { player.Say("It's already open. The candy bar is looking at me."); return true; }
    hotelMinibar = true;
    object[O_HOTEL_MINIBAR].Graphic = S_HOTEL_MINIBAR_OPEN;
    object[O_HOTEL_CANDY].Visible = true;
    Sfx(aFridge);
    player.Say("I open the minibar. Little bottles, and one candy bar.");
    return true;
  }
  if (i == H_HOTEL_LAMP && (v == V_USE || v == V_PUSH || v == V_PULL)) {
    Sfx(aLampClick);
    Wait(12);
    Sfx(aLampClick);
    player.Say("Click. Click. It stays on. They only drew it one way.");
    return true;
  }
  if (i == H_HOTEL_BED && (v == V_USE || v == V_PUSH)) {
    player.Say("I lie down for a quick pixel nap.");
    FadeOut(10);
    Wait(30);
    FadeIn(10);
    player.Say("I wake up. Still in the game. Both of them.");
    return true;
  }
  if (i == H_HOTEL_PAINTING && (v == V_PULL || v == V_OPEN || v == V_USE)) {
    player.Say("The safe behind the painting. I'm not doing the safe again. I still dream about that code.");
    return true;
  }
  if (i == H_HOTEL_DOOR && (v == V_OPEN || v == V_USE || v == V_PULL)) {
    player.Say("Through that door is the ninth floor, the Nave, Chuk, and eventually a computer with this game on it.");
    player.Say("Best not.");
    return true;
  }
  if (v != V_LOOK) {
    player.Say("I already did all that. It's a much smaller game the second time round.");
    return true;
  }
  if (i == H_HOTEL_DOOR) player.Say("The door of Room 714. There's a party upstairs I haven't been to yet. Well, I have, but he hasn't.");
  else if (i == H_HOTEL_TV) player.Say("The TV. There are four channels, and they're all a bit much.");
  else if (i == H_HOTEL_BATHROOM) player.Say("The bathroom. I'm not going back in there. Not after the medicine cabinet.");
  else if (i == H_HOTEL_DRESSER) player.Say("The dresser where I found the bellhop uniform. Small world. Small pixels.");
  else if (i == H_HOTEL_CURTAINS) { if (hotelCurtains) player.Say("The city at night. Somewhere out there, the clowns."); else player.Say("Curtains. The clowns are out there somewhere."); }
  else if (i == H_HOTEL_MINIBAR) player.Say("The minibar. I'd rather not relive the candy bar.");
  else if (i == H_HOTEL_LAMP) player.Say("A lamp. It's on. It's always on in here.");
  else if (i == H_HOTEL_PHONE) player.Say("The phone. Nobody's calling a computer game.");
  else if (i == H_HOTEL_NIGHTSTAND) player.Say("The nightstand. Empty, as I left it.");
  else if (i == H_HOTEL_PAINTING) player.Say("The deer painting, with the safe behind it. I know its tricks.");
  else if (i == H_HOTEL_BED) player.Say("The bed. I could lie down, but then I'd have to play the whole thing again.");
  else if (i == H_HOTEL_TABLE) player.Say("The coffee table. Mercifully empty.");
  else player.Say("It's very pixelly.");
  return true;
}

bool HotelObj(int v, int i, InventoryItem* it)
{
  if (i == O_HOTEL_NEWSPAPER) {
    if (v == V_LOOK || v == V_OPEN || v == V_PICKUP || v == V_USE) {
      if (v == V_PICKUP) player.Say("A newspaper. Someone must have slid it under the door overnight.");
      ReadNewspaper();
      player.Say("Hang on. I'm reading a newspaper, in a game, on a computer, in a crypt, in a hotel, in a game.");
      player.FaceDirection(eDirectionDown, eBlock);    // to the player, through the screen
      Wait(10);
      player.Say("This metafiction has gotten a little out of hand, don't you think?");
      return true;
    }
  }
  if (i == O_HOTEL_CANDY) {
    if (v == V_LOOK) { player.Say("One candy bar, priced at forty dollars."); return true; }
    if (v == V_PICKUP || v == V_USE || v == V_PULL) {
      player.Say("One candy bar, priced at forty dollars. I know better now.");
      return true;
    }
  }
  return false;
}

bool CryptHot(int v, int i, InventoryItem* it)
{
  if (i == H_CRYPT_ARCH) {
    if (v == V_LOOK) { player.Say("The archway back to the Nave."); return true; }
    if (v == V_WALK || v == V_USE || v == V_OPEN) {
      player.Walk(152, 230, eBlock, eWalkableAreas);
      player.Walk(152, 212, eBlock, eAnywhere);
      player.ChangeRoom(R_NAVE, 586, 266);
      return true;
    }
  }
  if (i == H_CRYPT_YARN) {
    if (v == V_LOOK) { player.Say("The Flying Spaghetti Monster, crocheted out of yarn. Its meatballs are pompoms."); return true; }
    if (v == V_PULL || v == V_PICKUP) { player.Say("I can't reach it, and I wouldn't dare."); return true; }
  }
  if (i == H_CRYPT_PASTAWALL) {
    if (v == V_LOOK) {
      player.Say("\"Pasta Identification.\" OTTINI, TORTINI, ANELLI, NODINI. Pastas I've never heard of, and four empty recesses.");
      if (!compOpen) player.Say("And a brass plate underneath, shut tight.");
      return true;
    }
    if (v == V_USE && ItemShape(it) >= 0) { player.Say("Which recess? I'll put it in one."); return true; }
  }
  if (i == H_CRYPT_STAFF) {
    if (v == V_LOOK) { player.Say("The staff area. Something smells amazing back there."); return true; }
  }
  if (i == H_CRYPT_3BUTTON) {
    if (v == V_LOOK) { player.Say("A confessional booth with three arcade buttons. CONFESS, it says, in red neon. A lot of judgment in one cabinet."); return true; }
    if (v == V_USE || v == V_PUSH || v == V_TALK) {
      if (it != null) { player.Say("It only takes sins."); return true; }
      Confess();
      return true;
    }
  }
  if (i == H_CRYPT_TRACKBALL) {
    if (v == V_LOOK) {
      player.Say("A trackball cabinet: MEATBALL MADNESS. The trackball is a meatball.");
      if (!trackballWon) player.Say("INSERT TOKEN. Nobody has ever beaten it, says a handwritten sign.");
      return true;
    }
    if ((v == V_USE && (it == null || it == iToken)) || v == V_PUSH || v == V_PULL) { PlayTrackball(); return true; }
    if (v == V_USE) { player.Say("It only takes tokens."); return true; }
  }
  if (i == H_CRYPT_COMPUTER) {
    if (v == V_LOOK) {
      if (powered) player.Say("A classic computer, beige and humming. There's a folder on it called GAMES.");
      else player.Say("A classic computer, beige and silent. Its power cable is lying on the floor, unplugged.");
      return true;
    }
    if (v == V_USE || v == V_OPEN || v == V_TALK || v == V_PUSH) {
      if (!powered) {
        player.Say("Nothing. It isn't even plugged in.");
        if (cKhuc.Room == R_CRYPT && !rexWon) cKhuc.Say("I'll set that up after this level.");
        return true;
      }
      RunHotel();
      return true;
    }
  }
  if (i == H_CRYPT_REX) {
    if (v == V_LOOK) { player.Say("A T. Rex game built into a real T. rex skull. You sit in its jaws. Jump the cacti. Fear the meteor."); return true; }
    if (v == V_USE || v == V_PUSH) { PlayRex(); return true; }
  }
  return false;
}

bool CryptObj(int v, int i, InventoryItem* it)
{
  if (i >= O_CRYPT_SLOT1 && i <= O_CRYPT_SLOT4) {
    int k = i - O_CRYPT_SLOT1;
    if (v == V_LOOK) {
      if (recess[k] < 0) player.Say(String.Format("The recess above %s. Empty.", SlotPasta(k)));
      else player.Say(String.Format("%s, in the recess above %s.", ShapeName(recess[k]), SlotPasta(k)));
      return true;
    }
    if (v == V_USE && ItemShape(it) >= 0) { PlaceShape(k, ItemShape(it)); return true; }
    if (v == V_USE && it != null) { player.Say("That doesn't go on the board."); return true; }
    if ((v == V_PICKUP || v == V_PULL) && recess[k] >= 0) {
      if (compOpen) { player.Say("The board's solved. I'll leave it be."); return true; }
      player.AddInventory(ShapeItem(recess[k]));
      recess[k] = -1;
      Sfx(aClack);
      SetupCrypt();
      RefreshInventory();
      return true;
    }
    if (v == V_PICKUP || v == V_USE || v == V_PUSH) {
      if (rexWon) player.Say("An empty recess. One of the shapes must go here.");
      else player.Say("An empty recess. Something's missing from this board.");
      return true;
    }
  }
  if (i == O_CRYPT_COMPARTMENT && compOpen && !crankTaken && (v == V_LOOK || v == V_PICKUP || v == V_PULL)) {
    i = O_CRYPT_CRANK;          // the drawer's open: clicking it means the crank in it
  }
  if (i == O_CRYPT_COMPARTMENT) {
    if (v == V_LOOK) {
      if (compOpen) player.Say("The drawer under the names is open.");
      else player.Say("A drawer under the names, with no handle to pull. It must open somehow.");
      return true;
    }
    if (v == V_OPEN || v == V_PULL || v == V_USE || v == V_PUSH) {
      if (compOpen) player.Say("It's open already.");
      else player.Say("It won't budge. The board has to be right first, I bet.");
      return true;
    }
  }
  if (i == O_CRYPT_CRANK) {
    if (v == V_LOOK) { player.Say("An iron crank with a wooden handle. It'd fit the Pope Seat's empty socket."); return true; }
    if (v == V_PICKUP || v == V_USE || v == V_PULL) {
      Sfx(aClink);
      crankTaken = true;
      object[O_CRYPT_CRANK].Visible = false;
      player.AddInventory(iCrank);
      RefreshInventory();
      player.Say("Got the crank.");
      return true;
    }
  }
  if (i == O_CRYPT_TOKEN) {
    if (v == V_LOOK) { player.Say("An arcade token, stamped FSM."); return true; }
    if (v == V_PICKUP || v == V_USE) {
      Sfx(aClink);
      tokenTaken = true;
      object[O_CRYPT_TOKEN].Visible = false;
      player.AddInventory(iToken);
      RefreshInventory();
      return true;
    }
  }
  if (i == O_CRYPT_CURTAIN) {
    if (v == V_LOOK) { player.Say("The staff room. Shelves of boxes, folding chairs, and the drinks for after strike."); return true; }
    if (v == V_OPEN || v == V_PULL || v == V_USE) {
      if (curtainOpen) return true;
      if (cKhuc.Room == R_CRYPT) {
        cKhuc.Say("Staff only! That's where we keep the drinks for after strike.");
      } else {
        player.Say("It says STAFF. I'd better not.");
      }
      return true;
    }
  }
  if (i == O_CRYPT_SEAT) {
    if (v == V_LOOK) {
      player.Say("The Pope Seat: a red throne with a big red button on the armrest.");
      player.Say("A pope hat made of lasagna hangs over it on a rope.");
      if (!crankFitted) player.Say("There's an empty socket on the side, where the crank should go.");
      return true;
    }
    if (v == V_USE && it == iCrank) {
      player.Say("I'll need someone to turn it while I sit, though.");
      FitCrank();
      return true;
    }
    if (v == V_USE && it != null) { player.Say("That doesn't go on the throne."); return true; }
    if (v == V_USE || v == V_PUSH) { SitPope(); return true; }
    if (v == V_PULL) {
      if (crankFitted) player.Say("I can't sit in the seat and turn the crank at the same time.");
      else player.Say("There's nothing to pull. The crank's missing.");
      return true;
    }
  }
  if (i == O_CRYPT_HAT) {
    if (v == V_LOOK) { player.Say("A pope hat made of lasagna. The sauce band is a nice touch."); return true; }
    if (v == V_PICKUP || v == V_PULL) { player.Say("It's on a rope, way up there. It comes down when someone turns the crank."); return true; }
  }
  return false;
}

// ======================================================================
// inventory
// ======================================================================
void LookItem(InventoryItem* item)
{
  if (item == iBeads) player.Say("Pasta rosary beads. Elbow macaroni on a string.");
  else if (item == iPamphlet) ReadPamphlet();
  else if (item == iPendant && wearUV) player.Say("The UV pendant. I'm wearing it. To take it off, I use it on myself.");
  else if (item == iPendant) player.Say("A UV pendant. A crystal with a little ultraviolet light inside.");
  else if (item == iRigatone) player.Say("A golden rigatone. Unsauced.");
  else if (item == iSauced) player.Say("A golden rigatone, covered in Weird Sauce.");
  else if (item == iToken) player.Say("An arcade token, stamped FSM.");
  else if (item == iCrank) player.Say("The Pope Seat's crank.");
  else if (ItemShape(item) >= 0) {
    player.Say(String.Format("%s, carved from pale stone. Chuk says it's one of the new pastas.", ShapeName(ItemShape(item))));
  }
}

void PutOn(InventoryItem* item)
{
  // the beads leave the inventory while worn; the pendant stays, so it's easy to take off
  if (item == iBeads) {
    Sfx(aRattle);
    wearBeads = true;
    player.LoseInventory(iBeads);
    RefreshInventory();
    UpdateOutfit();
    player.Say("I put on the beads. I feel 12% holier.");
    if (player.Room == R_NAVE && !ordained) CheckOrdained();
  } else {
    Sfx(aShimmer);
    wearUV = true;
    UpdateOutfit();
    if (player.Room == R_NAVE) SetupNave();
    else if (player.Room == R_CRYPT) SetupCrypt();
    player.Say("I put on the pendant. Everything goes purple, and writing shows up on the walls!");
  }
}

void TakeOff(bool beads)
{
  if (beads) {
    Sfx(aRattle);
    wearBeads = false;
    player.AddInventory(iBeads);
    RefreshInventory();
    UpdateOutfit();
    player.Say("I take the beads off.");
  } else {
    Sfx(aShimmer);
    wearUV = false;
    UpdateOutfit();
    if (player.Room == R_NAVE) SetupNave();
    else if (player.Room == R_CRYPT) SetupCrypt();
    player.Say("I take off the pendant. Back to boring old visible light.");
  }
}

void UseOnSelf(InventoryItem* item)
{
  // an item used on the guest himself
  if (item == iPendant && wearUV) TakeOff(false);
  else if (item == iBeads || item == iPendant) PutOn(item);
  else if (item == iPamphlet) ReadPamphlet();
  else if (item == iRigatone || item == iSauced) player.Say("It's an offering, not a snack.");
  else if (item == iToken) player.Say("I flip the token. Heads: a meatball.");
  else if (item == iCrank) player.Say("I crank myself. Nothing happens. As usual.");
  else if (ItemShape(item) >= 0) player.Say("I turn it over in my hands. Still not pasta.");
}

void UseItemOnItem(InventoryItem* a, InventoryItem* b)
{
  if ((a == iRigatone && b == iPamphlet) || (b == iRigatone && a == iPamphlet)) {
    player.Say("The pamphlet says to sauce it, not to read to it.");
    return;
  }
  player.Say("Those don't go together.");
}

void ItemAction(int v, InventoryItem* item)
{
  if (v == V_LOOK) LookItem(item);
  else if (v == V_OPEN && item == iPamphlet) ReadPamphlet();
  else if (v == V_USE) UseOnSelf(item);
  else if (v == V_PICKUP) player.Say("I already have it.");
  else if (v == V_TALK) player.Say("It doesn't say much.");
  else player.Say("That won't do anything.");
}

void Gesture(int g)
{
  // a short reach / bend / push from the side, in the direction he faces
  int lp = 2;
  if (player.Loop == 1) lp = 1;
  player.LockViewFrame(VGESTURE, lp, g);
  Wait(9);
  player.UnlockView();
  UpdateOutfit();
}

void SelfAction(int v, InventoryItem* it)
{
  // the guest, clicked on: wearing things, and a few jokes
  if (v == V_USE && it != null) UseOnSelf(it);
  else if (v == V_LOOK) {
    if (wearBeads && wearUV) player.Say("Beads, a glowing pendant and a bellhop's uniform. I look like a very confused disco priest.");
    else if (wearBeads) player.Say("Bellhop uniform, pasta beads. Holy, but still on the clock.");
    else if (wearUV) player.Say("I'm glowing faintly purple. Stylish.");
    else player.Say("Still in my bellhop uniform. Nobody told me it wasn't a costume party.");
  }
  else if (v == V_TALK) player.Say("I'd answer, but I already know what I'm going to say.");
  else if ((v == V_PICKUP || v == V_PULL) && wearBeads && wearUV) {
    int c = Choose("Take off the beads.", "Take off the UV pendant.", "Never mind.", null, null);
    if (c == 1) TakeOff(true);
    else if (c == 2) TakeOff(false);
  }
  else if ((v == V_PICKUP || v == V_PULL) && (wearBeads || wearUV)) TakeOff(wearBeads);
  else if (v == V_PICKUP) player.Say("I can't pick myself up. I've tried, emotionally.");
  else if (v == V_OPEN || v == V_CLOSE) player.Say("I'd rather stay closed, thanks.");
  else if (v == V_PUSH || v == V_PULL) player.Say("I'm not that kind of door.");
  else if (v == V_USE) player.Say("Use me with what? I should pick something from my pockets first.");
}

// ======================================================================
// doing things
// ======================================================================
void DoAction(int v, int t, int i, InventoryItem* it)
{
  if (player.Room == R_HOTEL && t == T_HOT && i == H_HOTEL_LOGOFF && v != V_LOOK) {
    LogOff();               // the button is on the screen, not in the game
    return;
  }
  if (v == V_WALK) {
    ThingWalk(t, i);
    if (player.Room == R_NAVE && t == T_HOT && i == H_NAVE_ARCH && ordained) NaveHot(V_WALK, i, null);
    if (player.Room == R_CRYPT && t == T_HOT && i == H_CRYPT_ARCH) CryptHot(V_WALK, i, null);
    return;
  }
  if (t == T_CHAR && i == player.ID) {
    SelfAction(v, it);
    return;
  }
  if (v != V_LOOK) ThingWalk(t, i);
  FaceThing(t, i);
  if (player == cGuest && (t == T_OBJ || t == T_HOT) && (v == V_PICKUP || v == V_PUSH || v == V_PULL || v == V_OPEN || v == V_CLOSE || v == V_USE)) {
    int g = 0;                                   // reach
    if (v == V_PUSH || v == V_PULL) g = 2;        // push
    else if (v == V_PICKUP && t == T_OBJ && object[i].Y > player.y - 40) g = 1;   // bend down
    Gesture(g);
  }
  bool done = false;
  if (t == T_CHAR && i == cKhuc.ID) {
    if (v == V_LOOK) {
      player.Say("Chuk. He's wearing a colander and an air of great patience.");
      done = true;
    } else if (v == V_TALK) {
      if (player.Room == R_NAVE) TalkKhucNave();
      else TalkKhucCrypt();
      done = true;
    } else if (v == V_USE && it != null) {
      GiveKhuc(it);
      done = true;
    } else if (v == V_PICKUP || v == V_PUSH || v == V_PULL) {
      player.Say("I don't think he'd like that.");
      done = true;
    }
  } else if (player.Room == R_NAVE) {
    if (t == T_HOT) done = NaveHot(v, i, it);
    else if (t == T_OBJ) done = NaveObj(v, i, it);
  } else if (player.Room == R_CRYPT) {
    if (t == T_HOT) done = CryptHot(v, i, it);
    else if (t == T_OBJ) done = CryptObj(v, i, it);
  } else if (player.Room == R_HOTEL) {
    if (t == T_HOT) done = HotelHot(v, i, it);
    else if (t == T_OBJ) done = HotelObj(v, i, it);
  }
  if (!done) {
    if (v == V_LOOK) player.Say(String.Format("It's the %s.", ThingName(t, i)));
    else if (v == V_USE && it != null) player.Say("That doesn't work.");
    else Stock(v);
  }
}

void RoomClick(bool right)
{
  if (hovType == T_NONE || hovType == T_INV) {
    if (!right) player.Walk(mouse.x, mouse.y, eNoBlock, eWalkableAreas);
    ResetVerb();
    return;
  }
  int v = curVerb;
  if (right) v = V_LOOK;
  else if (v == V_NONE) v = DefaultVerb(hovType, hovIdx);
  InventoryItem* it = null;
  if (v == V_USE && selItem != null && !right) it = selItem;
  int t = hovType;
  int i = hovIdx;
  ResetVerb();
  DrawUI();
  DoAction(v, t, i, it);
}

void UIClick(bool right)
{
  if (titleMode) {
    if (right) return;
    if (hovOpt == 0) {
      titleMode = false;
      aMusTitle.Stop();
      ResetState();
      player.ChangeRoom(R_NAVE, 124, 276);
    } else if (hovOpt == 1) QuitGame(0);
    return;
  }
  if (hovVerb > 0 && !right) {
    curVerb = hovVerb;
    selItem = null;
    uiDirty = true;
    return;
  }
  if (hovType == T_INV) {
    InventoryItem* item = inventory[hovIdx];
    if (right) { ResetVerb(); LookItem(item); return; }
    if (curVerb == V_USE && selItem != null) {
      InventoryItem* first = selItem;
      ResetVerb();
      DrawUI();
      if (first == item && item == iPendant && wearUV) player.Say("To take it off, I should use it on me.");
      else if (first == item && (item == iBeads || item == iPendant)) player.Say("To wear it, I should use it on me.");
      else if (first == item) UseOnSelf(item);
      else UseItemOnItem(first, item);
      return;
    }
    if (curVerb == V_USE || curVerb == V_NONE) {
      curVerb = V_USE;
      selItem = item;
      uiDirty = true;
      return;
    }
    int v = curVerb;
    ResetVerb();
    DrawUI();
    ItemAction(v, item);
    return;
  }
  if (right) ResetVerb();
}

// ======================================================================
// engine events
// ======================================================================
function game_start()
{
  verbName[0] = "";
  verbName[V_OPEN] = "Open";
  verbName[V_PICKUP] = "Pick up";
  verbName[V_PUSH] = "Push";
  verbName[V_CLOSE] = "Close";
  verbName[V_LOOK] = "Look at";
  verbName[V_PULL] = "Pull";
  verbName[V_TALK] = "Talk to";
  verbName[V_USE] = "Use";
  verbName[V_WALK] = "Walk to";
  uiSpr = DynamicSprite.Create(640, 112, false);
  uiOv = Overlay.CreateGraphical(0, UI_Y, uiSpr.Graphic, false);
  titleMode = true;
  hovOpt = -1;
  Game.SpeechFont = eFont1;
  Game.NormalFont = eFont0;
  game.text_speed = 14;
  mouse.Mode = eModeWalkto;
  cKhuc.SpeechColor = C(255, 176, 80);
  player.SpeechColor = C(250, 250, 250);
  ResetState();
}

function repeatedly_execute_always()
{
  if (uiSpr == null) return;
  if (!inChoice) UpdateHover();
  bool idle = (IsInterfaceEnabled() != 0);
  if (idle != wasIdle) {
    wasIdle = idle;
    uiDirty = true;
  }
  if (player.Room == R_NAVE) {
    forkTimer++;
    if (forkTimer >= 6) {
      forkTimer = 0;
      forkFrame = (forkFrame + 1) % 8;
      object[O_NAVE_FORK].Graphic = S_NAVE_FORK_F0 + forkFrame;
    }
  }
  if (uiDirty) DrawUI();
}

function on_mouse_click(MouseButton button)
{
  if (IsGamePaused()) return;
  if (button != eMouseLeft && button != eMouseRight) return;
  bool right = (button == eMouseRight);
  if (mouse.y >= UI_Y) {
    UIClick(right);
    return;
  }
  if (titleMode) return;
  RoomClick(right);
}

function on_key_press(eKeyCode keycode)
{
  if (titleMode) {
    if (keycode == eKeyN) { hovOpt = 0; UIClick(false); }
    if (keycode == eKeyQ) QuitGame(0);
    return;
  }
  if (keycode == eKeyF5) SaveGameDialog();
  else if (keycode == eKeyF7) RestoreGameDialog();
  else if (keycode == eKeyO) { curVerb = V_OPEN; selItem = null; uiDirty = true; }
  else if (keycode == eKeyC) { curVerb = V_CLOSE; selItem = null; uiDirty = true; }
  else if (keycode == eKeyT) { curVerb = V_TALK; selItem = null; uiDirty = true; }
  else if (keycode == eKeyP) { curVerb = V_PICKUP; selItem = null; uiDirty = true; }
  else if (keycode == eKeyL) { curVerb = V_LOOK; selItem = null; uiDirty = true; }
  else if (keycode == eKeyU) { curVerb = V_USE; selItem = null; uiDirty = true; }
  else if (keycode == eKeyW) { curVerb = V_WALK; selItem = null; uiDirty = true; }
  else if (keycode == eKeyS) { curVerb = V_PUSH; selItem = null; uiDirty = true; }
  else if (keycode == eKeyY) { curVerb = V_PULL; selItem = null; uiDirty = true; }
  else if (keycode == eKeyEscape && player.Room == R_HOTEL) LogOff();
  else if (keycode == eKeyEscape) ResetVerb();
}

void ShowEnding()
{
  DynamicSprite* page = DynamicSprite.Create(640, 400, false);
  int n = 4;
  int k = 0;
  while (k < n) {
    String a = "";
    String b = "";
    bool wreck = false;
    if (endingKind == 1) {
      if (k == 0) { a = "Room service for all."; b = "The clowns delivered. To everyone. Repeatedly."; }
      if (k == 1) { a = "Chuk and the new Pope of the Noodle"; b = "have not been seen since. Their rooms were made up the next morning."; }
      if (k == 2) { a = "Somewhere upstairs,"; b = "a duck is still missing."; }
    } else if (endingKind == 2) {
      if (k == 0) { a = "All games are free play."; b = "The clowns never left the Crypt. The high score tables are all clowns now."; }
      if (k == 1) { a = "Chuk has started a petition."; b = "Nobody can sign it. They're all playing T. Rex."; }
      if (k == 2) { a = "The CONFESS cabinet"; b = "has heard things no cabinet should hear."; }
    } else {
      if (k == 0) { a = "The next morning, the Nave."; b = ""; wreck = true; }
      if (k == 1) { a = "They regretted their choices."; b = "Every single one. Especially the tapestry."; }
      if (k == 2) { a = "Strike took all day."; b = "The tiny folk are rebuilding. They say they've found another whip-it."; }
    }
    if (k == 3) { a = "THE END"; b = "Thanks for playing Hotel Paradiso: Sacra Pasta."; }
    DrawingSurface* ds = page.GetDrawingSurface();
    ds.Clear(C(10, 6, 14));
    if (wreck) {
      ds.DrawImage(0, 20, SPR_NAVE_WRECKED);
      ds.DrawingColor = C(255, 214, 110);
      ds.DrawStringWrapped(40, 330, 560, eFont0, eAlignCenter, a);
    } else {
      ds.DrawingColor = C(255, 214, 110);
      ds.DrawStringWrapped(40, 150, 560, eFont0, eAlignCenter, a);
      ds.DrawingColor = C(220, 200, 230);
      ds.DrawStringWrapped(40, 180, 560, eFont2, eAlignCenter, b);
    }
    ds.Release();
    Overlay* ov = Overlay.CreateGraphical(0, 0, page.Graphic, false);
    Wait(20);
    WaitMouseKey(400);
    ov.Remove();
    k++;
  }
  page.Delete();
}

function on_event(EventType event, int data)
{
  if (event == eEventEnterRoomBeforeFadein) {
    hovType = T_NONE;
    ResetVerb();
    RefreshInventory();
    // the characters are drawn for the big painted Nave; the Crypt is drawn smaller,
    // and Khuc stands off its walkable floor there, so scale him by hand
    cKhuc.ManualScaling = (data == R_CRYPT);
    if (data == R_CRYPT) cKhuc.Scaling = 72;
    if (data == R_NAVE) SetupNave();
    else if (data == R_CRYPT) SetupCrypt();
    else if (data == R_TITLE) {
      titleMode = !endingMode;
      player.x = -100;
      player.y = 300;
    }
    uiDirty = true;
  } else if (event == eEventEnterRoomAfterFadein) {
    if (data == R_NAVE && !met) {
      met = true;
      player.Walk(200, 258, eBlock, eAnywhere);
      player.Say("Ninth floor, at last. The clowns dropped me at the end of the hall and honked off into the night.");
      player.Say("Huh. This doesn't look like a hotel room anymore.");
      cKhuc.Say("Welcome, pilgrim, to the Nave.");
      player.FaceCharacter(cKhuc, eBlock);
      player.Say("Is this the party?");
      cKhuc.Say("The party is in the Crypt, beyond this wall.");
      player.Say("What wall? Oh. That wall.");
      cKhuc.Say("Only the ordained may pass.");
    } else if (data == R_CRYPT) {
      // plays twice, then fades (baked into the clip); not again after a game on the computer
      if (!backFromHotel) aMusCrypt.Play(eAudioPriorityLow, eOnce);
      backFromHotel = false;
      if (!cryptVisited) {
        cryptVisited = true;
        player.Say("The Crypt! Arcade cabinets, candles, and a yarn monster on the ceiling.");
        cKhuc.Say("(without looking up) Welcome. I'm on level nine.");
      }
    } else if (data == R_TITLE) {
      if (endingMode) {
        endingMode = false;
        aMusEnding.Play(eAudioPriorityHigh, eOnce);
        ShowEnding();
        titleMode = true;
        ResetState();
        uiDirty = true;
      }
      aMusTitle.Play(eAudioPriorityNormal, eRepeat);
    }
  } else if (event == eEventLeaveRoom) {
    if (data == R_CRYPT) aMusCrypt.Stop();
  }
}
